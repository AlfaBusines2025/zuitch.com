<?php
if (!defined('T_USER_ACTIVITY_LOG')) {
    define('T_USER_ACTIVITY_LOG', 'Wo_User_Activity_Log');
}
if (!function_exists('Wo_UserActivityAuditUids')) {
    $audit_cfg = dirname(dirname(dirname(__DIR__))) . '/assets/includes/user_activity_audit.php';
    if (file_exists($audit_cfg)) {
        require_once $audit_cfg;
    }
}

$purge_msg = '';
if (!empty($_POST['purge_old']) && !empty($is_admin)) {
    $post_hash = !empty($_POST['hash_id']) ? $_POST['hash_id'] : '';
    $hash_ok = false;
    if (function_exists('Wo_CheckSession') && Wo_CheckSession($post_hash) === true) {
        $hash_ok = true;
    } elseif (function_exists('Wo_CheckMainSession') && Wo_CheckMainSession($post_hash) === true) {
        $hash_ok = true;
    }
    if ($hash_ok) {
        $deleted = function_exists('Wo_PurgeUserActivityAuditLog') ? Wo_PurgeUserActivityAuditLog() : 0;
        $purge_msg = 'Purged ' . (int) $deleted . ' rows older than retention period.';
    }
}

$allow_uids = function_exists('Wo_UserActivityAuditUids') ? array_values(Wo_UserActivityAuditUids()) : array(158);
$default_uid = !empty($allow_uids) ? (int) $allow_uids[0] : 158;

$page_id = (!empty($_GET['page-id']) && is_numeric($_GET['page-id'])) ? (int) $_GET['page-id'] : 1;
$user_id = (!empty($_GET['user_id']) && is_numeric($_GET['user_id'])) ? (int) $_GET['user_id'] : $default_uid;
$feature = (!empty($_GET['feature']) && in_array($_GET['feature'], array('reels', 'live', 'other', 'all'), true))
    ? $_GET['feature'] : 'all';
$level = (!empty($_GET['level']) && in_array($_GET['level'], array('info', 'warn', 'error', 'all'), true))
    ? $_GET['level'] : 'all';
$action_q = (!empty($_GET['action_q'])) ? trim(Wo_Secure($_GET['action_q'])) : '';
$date_from = (!empty($_GET['date_from'])) ? trim(Wo_Secure($_GET['date_from'])) : '';
$date_to = (!empty($_GET['date_to'])) ? trim(Wo_Secure($_GET['date_to'])) : '';

$link = '&user_id=' . $user_id;
if ($feature !== 'all') {
    $link .= '&feature=' . urlencode($feature);
}
if ($level !== 'all') {
    $link .= '&level=' . urlencode($level);
}
if ($action_q !== '') {
    $link .= '&action_q=' . urlencode($action_q);
}
if ($date_from !== '') {
    $link .= '&date_from=' . urlencode($date_from);
}
if ($date_to !== '') {
    $link .= '&date_to=' . urlencode($date_to);
}

$db->pageLimit = 50;
if ($user_id > 0) {
    $db->where('user_id', $user_id);
}
if ($feature !== 'all') {
    $db->where('feature', $feature);
}
if ($level !== 'all') {
    $db->where('level', $level);
}
if ($action_q !== '') {
    $db->where('action', '%' . $action_q . '%', 'LIKE');
}
if ($date_from !== '' && preg_match('/^\d{4}-\d{2}-\d{2}$/', $date_from)) {
    $db->where('created_at', strtotime($date_from . ' 00:00:00'), '>=');
}
if ($date_to !== '' && preg_match('/^\d{4}-\d{2}-\d{2}$/', $date_to)) {
    $db->where('created_at', strtotime($date_to . ' 23:59:59'), '<=');
}
$db->orderBy('id', 'DESC');
$logs = $db->objectbuilder()->paginate(T_USER_ACTIVITY_LOG, $page_id);

if (($page_id > $db->totalPages) && !empty($_GET['page-id']) && $db->totalPages > 0) {
    header('Location: ' . Wo_LoadAdminLinkSettings('user-activity?page-id=1' . $link));
    exit();
}

$user_label = '';
if ($user_id > 0) {
    $u = Wo_UserData($user_id);
    if (!empty($u['username'])) {
        $user_label = $u['name'] . ' (@' . $u['username'] . ')';
    }
}

$retention = defined('USER_ACTIVITY_AUDIT_RETENTION_DAYS') ? (int) USER_ACTIVITY_AUDIT_RETENTION_DAYS : 90;
?>
<div class="container-fluid">
    <div>
        <h3>User Activity Audit</h3>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="#">Home</a></li>
                <li class="breadcrumb-item"><a href="#">Users</a></li>
                <li class="breadcrumb-item active" aria-current="page">User Activity</li>
            </ol>
        </nav>
    </div>
    <div class="row">
        <div class="col-lg-12 col-md-12">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title">Activity trail (Reels / Livestream)</h6>
                    <p class="text-muted" style="margin-bottom:16px;">
                        Tracking allowlist UIDs:
                        <code><?php echo htmlspecialchars(implode(', ', $allow_uids), ENT_QUOTES, 'UTF-8'); ?></code>
                        — edit <code>assets/includes/user_activity_audit_config.php</code>.
                        Retention: <?php echo (int) $retention; ?> days.
                        <?php if ($user_label !== '') { ?>
                            | Viewing: <strong><?php echo htmlspecialchars($user_label, ENT_QUOTES, 'UTF-8'); ?></strong>
                        <?php } ?>
                    </p>
                    <?php if ($purge_msg !== '') { ?>
                        <div class="alert alert-success"><?php echo htmlspecialchars($purge_msg, ENT_QUOTES, 'UTF-8'); ?></div>
                    <?php } ?>

                    <form method="get" action="<?php echo Wo_LoadAdminLinkSettings('user-activity'); ?>" class="mb-3">
                        <div class="row">
                            <div class="col-md-2">
                                <label>User ID</label>
                                <input type="number" name="user_id" class="form-control" value="<?php echo (int) $user_id; ?>" min="0">
                            </div>
                            <div class="col-md-2">
                                <label>Feature</label>
                                <select name="feature" class="form-control">
                                    <?php foreach (array('all' => 'All', 'reels' => 'Reels', 'live' => 'Live', 'other' => 'Other') as $k => $lab) { ?>
                                        <option value="<?php echo $k; ?>" <?php echo $feature === $k ? 'selected' : ''; ?>><?php echo $lab; ?></option>
                                    <?php } ?>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label>Level</label>
                                <select name="level" class="form-control">
                                    <?php foreach (array('all' => 'All', 'info' => 'Info', 'warn' => 'Warn', 'error' => 'Error') as $k => $lab) { ?>
                                        <option value="<?php echo $k; ?>" <?php echo $level === $k ? 'selected' : ''; ?>><?php echo $lab; ?></option>
                                    <?php } ?>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label>Action contains</label>
                                <input type="text" name="action_q" class="form-control" value="<?php echo htmlspecialchars($action_q, ENT_QUOTES, 'UTF-8'); ?>" placeholder="e.g. stop, client.">
                            </div>
                            <div class="col-md-2">
                                <label>From</label>
                                <input type="date" name="date_from" class="form-control" value="<?php echo htmlspecialchars($date_from, ENT_QUOTES, 'UTF-8'); ?>">
                            </div>
                            <div class="col-md-2">
                                <label>To</label>
                                <input type="date" name="date_to" class="form-control" value="<?php echo htmlspecialchars($date_to, ENT_QUOTES, 'UTF-8'); ?>">
                            </div>
                        </div>
                        <div class="row" style="margin-top:12px;">
                            <div class="col-md-12">
                                <button type="submit" class="btn btn-info">Filter</button>
                                <a class="btn btn-outline-secondary" href="<?php echo Wo_LoadAdminLinkSettings('user-activity?user_id=' . (int) $default_uid); ?>">Reset (Aldo)</a>
                            </div>
                        </div>
                    </form>

                    <?php if (!empty($is_admin)) { ?>
                    <form method="post" action="<?php echo Wo_LoadAdminLinkSettings('user-activity?user_id=' . (int) $user_id); ?>" style="margin-bottom:16px;" onsubmit="return confirm('Delete audit rows older than <?php echo (int) $retention; ?> days?');">
                        <input type="hidden" name="hash_id" value="<?php echo function_exists('Wo_CreateSession') ? Wo_CreateSession() : (function_exists('Wo_CreateMainSession') ? Wo_CreateMainSession() : ''); ?>">
                        <button type="submit" name="purge_old" value="1" class="btn btn-warning btn-sm">Purge older than <?php echo (int) $retention; ?> days</button>
                    </form>
                    <?php } ?>

                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Time</th>
                                    <th>User</th>
                                    <th>Feature</th>
                                    <th>Action</th>
                                    <th>Level</th>
                                    <th>Post</th>
                                    <th>IP</th>
                                    <th>Meta</th>
                                </tr>
                            </thead>
                            <tbody>
                                <?php if (empty($logs)) { ?>
                                    <tr><td colspan="9" class="text-center">No activity logged yet for this filter.</td></tr>
                                <?php } else {
                                    foreach ($logs as $row) {
                                        $uid = (int) $row->user_id;
                                        $uname = '';
                                        $udata = Wo_UserData($uid);
                                        if (!empty($udata['username'])) {
                                            $uname = $udata['username'];
                                        }
                                        $when = !empty($row->created_at) ? date('Y-m-d H:i:s', (int) $row->created_at) : '-';
                                        $post_link = '';
                                        if (!empty($row->post_id)) {
                                            if ($row->feature === 'reels') {
                                                $post_link = $wo['config']['site_url'] . '/reels/' . (int) $row->post_id;
                                            } else {
                                                $post_link = Wo_SeoLink('index.php?link1=post&id=' . (int) $row->post_id);
                                            }
                                        }
                                        $lvl_class = 'secondary';
                                        if ($row->level === 'warn') {
                                            $lvl_class = 'warning';
                                        } elseif ($row->level === 'error') {
                                            $lvl_class = 'danger';
                                        } elseif ($row->level === 'info') {
                                            $lvl_class = 'info';
                                        }
                                        $meta_raw = isset($row->meta) ? (string) $row->meta : '';
                                        $meta_pretty = $meta_raw;
                                        if ($meta_raw !== '') {
                                            $decoded = json_decode($meta_raw, true);
                                            if (is_array($decoded)) {
                                                $meta_pretty = json_encode($decoded, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
                                            }
                                        }
                                        ?>
                                        <tr>
                                            <td><?php echo (int) $row->id; ?></td>
                                            <td style="white-space:nowrap;"><?php echo htmlspecialchars($when, ENT_QUOTES, 'UTF-8'); ?></td>
                                            <td>
                                                <?php if ($uname !== '') { ?>
                                                    <a href="<?php echo Wo_SeoLink('index.php?link1=timeline&u=' . urlencode($uname)); ?>" target="_blank"><?php echo htmlspecialchars($uname, ENT_QUOTES, 'UTF-8'); ?></a>
                                                    <small class="text-muted">#<?php echo $uid; ?></small>
                                                <?php } else { ?>
                                                    #<?php echo $uid; ?>
                                                <?php } ?>
                                            </td>
                                            <td><?php echo htmlspecialchars((string) $row->feature, ENT_QUOTES, 'UTF-8'); ?></td>
                                            <td><code><?php echo htmlspecialchars((string) $row->action, ENT_QUOTES, 'UTF-8'); ?></code></td>
                                            <td><span class="badge badge-<?php echo $lvl_class; ?>"><?php echo htmlspecialchars((string) $row->level, ENT_QUOTES, 'UTF-8'); ?></span></td>
                                            <td>
                                                <?php if ($post_link !== '') { ?>
                                                    <a href="<?php echo htmlspecialchars($post_link, ENT_QUOTES, 'UTF-8'); ?>" target="_blank"><?php echo (int) $row->post_id; ?></a>
                                                <?php } else { ?>
                                                    —
                                                <?php } ?>
                                            </td>
                                            <td style="font-size:12px;"><?php echo htmlspecialchars((string) $row->ip, ENT_QUOTES, 'UTF-8'); ?></td>
                                            <td style="max-width:320px;">
                                                <?php if ($meta_pretty !== '') { ?>
                                                    <details>
                                                        <summary style="cursor:pointer;">meta</summary>
                                                        <pre style="white-space:pre-wrap;max-height:220px;overflow:auto;font-size:11px;margin:6px 0 0;"><?php echo htmlspecialchars($meta_pretty, ENT_QUOTES, 'UTF-8'); ?></pre>
                                                    </details>
                                                <?php } else { ?>
                                                    —
                                                <?php } ?>
                                            </td>
                                        </tr>
                                    <?php }
                                } ?>
                            </tbody>
                        </table>
                    </div>

                    <?php if (!empty($db->totalPages) && $db->totalPages > 1) { ?>
                        <nav>
                            <ul class="pagination">
                                <?php for ($i = 1; $i <= $db->totalPages; $i++) {
                                    if ($i > 12 && abs($i - $page_id) > 2) {
                                        continue;
                                    }
                                    ?>
                                    <li class="page-item <?php echo $i === $page_id ? 'active' : ''; ?>">
                                        <a class="page-link" href="<?php echo Wo_LoadAdminLinkSettings('user-activity?page-id=' . $i . $link); ?>" data-ajax="?path=user-activity&page-id=<?php echo $i . htmlspecialchars($link, ENT_QUOTES, 'UTF-8'); ?>"><?php echo $i; ?></a>
                                    </li>
                                <?php } ?>
                            </ul>
                        </nav>
                    <?php } ?>
                </div>
            </div>
        </div>
    </div>
</div>
