function zuitch_daas_status_badge($status)
{
    $map = array(
        'new' => 'primary',
        'planned' => 'info',
        'in_progress' => 'warning',
        'needs_review' => 'secondary',
        'done' => 'success',
        'dismissed' => 'dark',
    );
    $s = (string) $status;
    return isset($map[$s]) ? $map[$s] : 'secondary';
}
