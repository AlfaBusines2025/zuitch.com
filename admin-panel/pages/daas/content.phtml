<script>
(function () {
    var DAAS_URL = <?php echo json_encode($daasUrl); ?>;
    var PUBLIC_KEY = <?php echo json_encode($publicKey); ?>;
    var COMPANY_ID = <?php echo json_encode($companyId); ?>;
    var REQUESTER_EMAIL = <?php echo json_encode($requesterEmail); ?>;
    var REQUESTER_ID = <?php echo json_encode($requesterId); ?>;

    function setStatus(type, html) {
        var el = document.getElementById('daas-widget-status');
        if (!el) return;
        el.className = 'alert alert-' + type;
        el.innerHTML = html;
    }

    function rootHasWidgetUi() {
        var root = document.getElementById('daas-widget-root');
        if (!root) return false;
        // Official widget usually injects children / shadow / iframe
        if (root.childNodes && root.childNodes.length > 0) return true;
        if (root.shadowRoot && root.shadowRoot.childNodes.length > 0) return true;
        // Sometimes mounts as sibling FAB
        if (document.querySelector('[data-daas-widget-mounted], .daas-widget, #daas-widget, iframe[src*="daas.alfabusiness"]')) {
            return true;
        }
        return false;
    }

    function showFallback(reason) {
        var fb = document.getElementById('daas-widget-fallback');
        if (fb) fb.style.display = 'block';
        setStatus('warning', reason + ' Puedes usar el formulario de abajo.');
    }

    window.ZuitchDaasWidgetScriptFailed = function () {
        showFallback('No se pudo cargar <code>' + DAAS_URL + '/widget.js</code> desde tu navegador.');
    };

    window.ZuitchDaasPull = function (btn) {
        var $btn = $(btn);
        var $out = $('#daas-pull-result');
        $btn.prop('disabled', true).text('Actualizando…');
        $out.html('');
        $.post(Wo_Ajax_Requests_File() + '?f=daas&s=pull', {
            hash_id: $('#hash_id').val()
        }, function (data) {
            $btn.prop('disabled', false).text('Actualizar código desde GitHub');
            if (data && data.status == 200) {
                $out.html('<div class="alert alert-success">' + (data.message || 'OK') +
                    (data.sha ? ' <code>' + data.sha + '</code>' : '') + '</div>');
                if (data.sha) $('#daas-git-sha').text(data.sha);
            } else {
                $out.html('<div class="alert alert-danger">' + ((data && data.message) ? data.message : 'Error') + '</div>');
            }
        }, 'json').fail(function (xhr) {
            $btn.prop('disabled', false).text('Actualizar código desde GitHub');
            var msg = 'Request failed';
            try { var j = JSON.parse(xhr.responseText); if (j.message) msg = j.message; } catch (e) {}
            $out.html('<div class="alert alert-danger">' + msg + '</div>');
        });
        return false;
    };

    // Watch for official widget mount; otherwise show fallback
    var tries = 0;
    var timer = setInterval(function () {
        tries++;
        if (rootHasWidgetUi()) {
            clearInterval(timer);
            setStatus('success', 'Widget DaaS listo. Envía tu pedido UX/UI aquí.');
            var fb = document.getElementById('daas-widget-fallback');
            if (fb) fb.style.display = 'none';
            return;
        }
        if (tries >= 15) {
            clearInterval(timer);
            showFallback('El widget oficial no apareció tras cargar el script.');
        }
    }, 400);

    // Fallback form → DaaS public orders API (same as widget)
    $(document).on('click', '#daas-fallback-submit', function () {
        var prompt = ($('#daas-fallback-prompt').val() || '').trim();
        var $out = $('#daas-fallback-result');
        if (!prompt) {
            $out.html('<div class="alert alert-danger">Escribe la descripción del cambio.</div>');
            return;
        }
        var fd = new FormData();
        fd.append('public_key', PUBLIC_KEY);
        fd.append('company_external_id', COMPANY_ID);
        fd.append('prompt', prompt);
        fd.append('description', prompt);
        fd.append('title', prompt.substring(0, 80));
        if (REQUESTER_EMAIL) fd.append('requester_email', REQUESTER_EMAIL);
        if (REQUESTER_ID) fd.append('requester_external_id', REQUESTER_ID);
        var files = document.getElementById('daas-fallback-files').files || [];
        for (var i = 0; i < files.length; i++) {
            fd.append('attachments[]', files[i]);
            fd.append('screenshots[]', files[i]);
        }
        $out.html('<div class="alert alert-secondary">Enviando…</div>');
        fetch(DAAS_URL + '/api/v1/orders', {
            method: 'POST',
            body: fd,
            credentials: 'omit'
        }).then(function (r) {
            return r.text().then(function (t) {
                var j = null;
                try { j = JSON.parse(t); } catch (e) {}
                return { ok: r.ok, status: r.status, json: j, text: t };
            });
        }).then(function (res) {
            if (res.ok) {
                var id = res.json && (res.json.id || (res.json.data && res.json.data.id));
                $out.html('<div class="alert alert-success">Pedido enviado' + (id ? ' (#' + id + ')' : '') + '.</div>');
                $('#daas-fallback-prompt').val('');
                return;
            }
            var msg = (res.json && (res.json.message || res.json.error)) ? (res.json.message || res.json.error) : ('HTTP ' + res.status);
            $out.html('<div class="alert alert-danger">No se pudo crear el pedido: ' + msg + '</div>');
        }).catch(function (err) {
            $out.html('<div class="alert alert-danger">No hay conexión con DaaS desde el navegador (' + (err && err.message ? err.message : 'error') + '). Abre <a href="' + DAAS_URL + '" target="_blank" rel="noopener">' + DAAS_URL + '</a> y verifica que cargue.</div>');
        });
    });
})();
</script>
