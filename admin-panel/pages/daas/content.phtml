<script>
(function () {
    window.ZuitchDaasPull = function (btn) {
        var $btn = $(btn);
        var $out = $('#daas-pull-result');
        $btn.prop('disabled', true).text('Actualizando…');
        $out.html('');
        $.post(Wo_Ajax_Requests_File() + '?f=daas&s=pull', {
            hash_id: $('#hash_id').val()
        }, function (data) {
            $btn.prop('disabled', false).text('Actualizar código desde GitHub');
            if (data && data.status == 200) {
                $out.html('<div class="alert alert-success">' + (data.message || 'OK') +
                    (data.sha ? ' <code>' + data.sha + '</code>' : '') + '</div>');
                if (data.sha) {
                    $('#daas-git-sha').text(data.sha);
                }
            } else {
                $out.html('<div class="alert alert-danger">' + ((data && data.message) ? data.message : 'Error') + '</div>');
            }
        }, 'json').fail(function (xhr) {
            $btn.prop('disabled', false).text('Actualizar código desde GitHub');
            var msg = 'Request failed';
            try {
                var j = JSON.parse(xhr.responseText);
                if (j.message) msg = j.message;
            } catch (e) {}
            $out.html('<div class="alert alert-danger">' + msg + '</div>');
        });
        return false;
    };

    // Load DaaS widget (works on full page load; append once)
    if (document.getElementById('daas-widget-root') && !document.querySelector('script[data-zuitch-daas-widget]')) {
        var s = document.createElement('script');
        s.src = <?php echo json_encode($daasUrl . '/widget.js'); ?>;
        s.async = true;
        s.setAttribute('data-zuitch-daas-widget', '1');
        document.body.appendChild(s);
    }
})();
</script>
