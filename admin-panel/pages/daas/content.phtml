                    <p class="mb-3">
                        <strong>Working tree:</strong>
                        <?php if (!empty($st['dirty'])) { ?>
                            <span class="badge badge-warning">sucio</span>
                            <small class="d-block text-muted mt-1" style="white-space:pre-wrap;max-height:120px;overflow:auto;"><?php echo htmlspecialchars($st['dirty_files']); ?></small>
                        <?php } else { ?>
                            <span class="badge badge-success">limpio</span>
