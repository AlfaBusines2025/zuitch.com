                    <?php } else { ?>
                        <div id="daas-widget-root"
                             data-daas-widget
                             data-public-key="<?php echo htmlspecialchars($publicKey); ?>"
                             data-company-external-id="<?php echo htmlspecialchars($companyId); ?>"
                             data-requester-email="<?php echo htmlspecialchars($requesterEmail); ?>"
                             data-requester-external-id="<?php echo htmlspecialchars($requesterId); ?>"></div>
