<script>
(function () {
    var PUBLIC_KEY = <?php echo json_encode($publicKey); ?>;
    var COMPANY_ID = <?php echo json_encode($companyId); ?>;

    function esc(s) {
        return String(s == null ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    function statusBadge(status) {
        var map = { new: 'primary', planned: 'info', in_progress: 'warning', needs_review: 'secondary', done: 'success', dismissed: 'dark' };
        return map[status] || 'secondary';
    }

    function formatDate(iso) {
        if (!iso) return '—';
        var d = new Date(iso);
        if (isNaN(d.getTime())) return esc(iso);
        var months = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
        var pad = function (n) { return n < 10 ? '0' + n : String(n); };
        return d.getDate() + ' ' + months[d.getMonth()] + ' ' + d.getFullYear() + ', ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
    }

    function updateChips(orders) {
        var q = 0, p = 0, d = 0;
        (orders || []).forEach(function (o) {
            var s = o.status || '';
            if (s === 'new' || s === 'planned') q++;
            else if (s === 'in_progress' || s === 'needs_review') p++;
            else if (s === 'done') d++;
        });
        $('#daas-count-queued').text(q);
        $('#daas-count-progress').text(p);
        $('#daas-count-done').text(d);
    }

    function orderCardHtml(o) {
        var canCancel = (o.status === 'new' || o.status === 'planned');
        var prompt = o.prompt || '';
        var long = String(prompt).length > 140;
        var actions = '';
        if (long) {
            actions += '<button type="button" class="btn btn-link daas-toggle-prompt">Ver más</button>';
        }
        if (o.cursor_latest_pr_url) {
            actions += '<a class="btn btn-sm btn-outline-secondary" href="' + esc(o.cursor_latest_pr_url) + '" target="_blank" rel="noopener">Ver PR</a>';
        }
        if (canCancel) {
            actions += '<button type="button" class="btn btn-sm btn-outline-danger daas-cancel-order" data-id="' + esc(o.id) + '">Cancelar</button>';
        }
        var type = o.type_label || o.type || '';
        return (
            '<article class="daas-order-card" data-order-id="' + esc(o.id) + '">' +
            '<div class="daas-order-meta">' +
            '<span class="daas-order-id">#' + esc(o.id) + '</span>' +
            '<span class="badge badge-' + statusBadge(o.status) + '">' + esc(o.status_label || o.status) + '</span>' +
            (type ? '<span>' + esc(type) + '</span>' : '') +
            '<span>·</span><span>' + formatDate(o.created_at) + '</span>' +
            '</div>' +
            '<p class="daas-order-prompt">' + esc(prompt) + '</p>' +
            '<div class="daas-order-actions">' + actions + '</div>' +
            '</article>'
        );
    }

    function renderOrders(orders) {
        var $list = $('#daas-orders-list');
        $list.empty();
        updateChips(orders);
        if (!orders || !orders.length) {
            $list.append('<div class="daas-empty">No hay pedidos todavía.</div>');
            return;
        }
        orders.forEach(function (o) {
            $list.append(orderCardHtml(o));
        });
    }

    function refreshOrders() {
        var $btn = $('#daas-orders-refresh');
        $btn.prop('disabled', true).text('Cargando…');
        $('#daas-orders-alert').html('');
        $.get(Wo_Ajax_Requests_File() + '?f=daas&s=list_orders', { hash_id: $('#hash_id').val() }, function (data) {
            $btn.prop('disabled', false).text('Refrescar');
            if (data && data.status == 200) {
                renderOrders(data.orders || []);
            } else {
                $('#daas-orders-alert').html('<div class="alert alert-danger">' + esc((data && data.message) || 'Error') + '</div>');
            }
        }, 'json').fail(function (xhr) {
            $btn.prop('disabled', false).text('Refrescar');
            var msg = 'Request failed';
            try { var j = JSON.parse(xhr.responseText); if (j.message) msg = j.message; } catch (e) {}
            $('#daas-orders-alert').html('<div class="alert alert-danger">' + esc(msg) + '</div>');
        });
    }

    function renderLocalQueue() {
        var $card = $('#daas-local-card');
        var $box = $('#daas-local-queue');
        $box.empty();
        var key = 'daas-draft-queue:' + PUBLIC_KEY + ':' + COMPANY_ID;
        var raw = null;
        try { raw = localStorage.getItem(key); } catch (e) {}
        var items = [];
        try { items = raw ? JSON.parse(raw) : []; } catch (e) { items = []; }
        if (!Array.isArray(items) || !items.length) {
            $card.removeClass('is-visible');
            return;
        }
        $card.addClass('is-visible');
        items.forEach(function (it, idx) {
            var prompt = (it && (it.prompt || it.description || it.title)) || JSON.stringify(it).slice(0, 120);
            $box.append(
                '<div class="list-group-item">' +
                '<strong>Borrador ' + (idx + 1) + '</strong>' +
                '<div class="mt-1" style="white-space:pre-wrap;word-break:break-word;">' + esc(prompt) + '</div>' +
                '</div>'
            );
        });
    }

    window.ZuitchDaasPull = function (btn) {
        var $btn = $(btn);
        var $out = $('#daas-pull-result');
        $btn.prop('disabled', true).text('Actualizando…');
        $out.html('');
        $.post(Wo_Ajax_Requests_File() + '?f=daas&s=pull', {
            hash_id: $('#hash_id').val()
        }, function (data) {
            $btn.prop('disabled', false).text('Actualizar desde GitHub');
            if (data && data.status == 200) {
                $out.html('<div class="alert alert-success">' + esc(data.message || 'OK') + '</div>');
                if (data.sha) {
                    $('#daas-git-sha').attr('data-full', data.sha).text(String(data.sha).slice(0, 7));
                }
            } else {
                $out.html('<div class="alert alert-danger">' + esc((data && data.message) || 'Error') + '</div>');
            }
        }, 'json').fail(function (xhr) {
            $btn.prop('disabled', false).text('Actualizar desde GitHub');
            var msg = 'Request failed';
            try { var j = JSON.parse(xhr.responseText); if (j.message) msg = j.message; } catch (e) {}
            $out.html('<div class="alert alert-danger">' + esc(msg) + '</div>');
        });
        return false;
    };

    $('#daas-orders-refresh').on('click', refreshOrders);

    $('#daas-copy-sha').on('click', function () {
        var full = $('#daas-git-sha').attr('data-full') || '';
        if (!full || !navigator.clipboard) return;
        navigator.clipboard.writeText(full).then(function () {
            var $b = $('#daas-copy-sha');
            var prev = $b.text();
            $b.text('Copiado');
            setTimeout(function () { $b.text(prev); }, 1200);
        });
    });

    $(document).on('click', '.daas-toggle-prompt', function () {
        var $p = $(this).closest('.daas-order-card').find('.daas-order-prompt');
        var open = $p.hasClass('is-expanded');
        $p.toggleClass('is-expanded', !open);
        $(this).text(open ? 'Ver más' : 'Ver menos');
    });

    $(document).on('click', '.daas-cancel-order', function () {
        var id = $(this).data('id');
        if (!id || !confirm('¿Cancelar la orden #' + id + '?')) return;
        $.post(Wo_Ajax_Requests_File() + '?f=daas&s=cancel_order', {
            hash_id: $('#hash_id').val(),
            order_id: id
        }, function (data) {
            if (data && data.status == 200) {
                refreshOrders();
            } else {
                alert((data && data.message) || 'No se pudo cancelar');
            }
        }, 'json').fail(function () {
            alert('Error al cancelar');
        });
    });

    renderLocalQueue();
})();
</script>
