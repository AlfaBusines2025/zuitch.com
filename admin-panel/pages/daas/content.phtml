<?php
$httpdocs = dirname(dirname(dirname(__DIR__)));
require_once $httpdocs . '/assets/includes/daas_env.php';
require_once $httpdocs . '/assets/includes/Daas/GitSyncService.php';
require_once $httpdocs . '/assets/includes/Daas/DaasClient.php';

if (!Wo_IsAdmin()) {
    echo '<div class="alert alert-danger">Solo el superadministrador puede gestionar pedidos UX/UI desde aquí.</div>';
    return;
}

daas_env_load();
$git = new GitSyncService($httpdocs);
$st = $git->status();
$publicKey = daas_env('DAAS_PUBLIC_KEY', '');
$companyId = daas_env('DAAS_BILLING_EXTERNAL_ID', 'zuitch');
$daasUrl = rtrim(daas_env('DAAS_URL', 'https://daas.alfabusiness.app'), '/');
$hash = Wo_CreateSession();

$daas = new DaasClient();
$ordersRes = $daas->listOrders(array(
    'company_external_id' => $companyId,
    'per_page' => 50,
));
$orders = (!empty($ordersRes['ok']) && !empty($ordersRes['data']) && is_array($ordersRes['data']))
    ? $ordersRes['data']
    : array();
$ordersError = empty($ordersRes['ok'])
    ? (isset($ordersRes['message']) ? $ordersRes['message'] : 'No se pudieron cargar las órdenes')
    : '';

$countQueued = 0;
$countProgress = 0;
$countDone = 0;
foreach ($orders as $o) {
    $s = isset($o['status']) ? (string) $o['status'] : '';
    if ($s === 'new' || $s === 'planned') {
        $countQueued++;
    } elseif ($s === 'in_progress' || $s === 'needs_review') {
        $countProgress++;
    } elseif ($s === 'done') {
        $countDone++;
    }
}

$shaFull = isset($st['sha']) ? (string) $st['sha'] : '';
$shaShort = $shaFull !== '' ? substr($shaFull, 0, 7) : '—';
$branch = isset($st['branch']) ? (string) $st['branch'] : '—';
$dirty = !empty($st['dirty']);

if (!function_exists('zuitch_daas_status_badge')) {
    function zuitch_daas_status_badge($status)
    {
        $map = array(
            'new' => 'primary',
            'planned' => 'info',
            'in_progress' => 'warning',
            'needs_review' => 'secondary',
            'done' => 'success',
            'dismissed' => 'dark',
        );
        $s = (string) $status;
        return isset($map[$s]) ? $map[$s] : 'secondary';
    }
}

if (!function_exists('zuitch_daas_format_date')) {
    function zuitch_daas_format_date($iso)
    {
        if (empty($iso)) {
            return '—';
        }
        $ts = strtotime($iso);
        if (!$ts) {
            return htmlspecialchars((string) $iso);
        }
        $months = array(1 => 'ene', 2 => 'feb', 3 => 'mar', 4 => 'abr', 5 => 'may', 6 => 'jun', 7 => 'jul', 8 => 'ago', 9 => 'sep', 10 => 'oct', 11 => 'nov', 12 => 'dic');
        $m = (int) date('n', $ts);
        return (int) date('j', $ts) . ' ' . $months[$m] . ' ' . date('Y', $ts) . ', ' . date('H:i', $ts);
    }
}
