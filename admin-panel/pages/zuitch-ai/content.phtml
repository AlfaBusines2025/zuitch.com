<script>
jQuery(function ($) {
  var hash_id = $('input[name=hash_id]').first().val();
  var ajaxFile = Wo_Ajax_Requests_File();

  function saveField($el) {
    var name = $el.attr('name');
    if (!name || name === 'hash_id') return;
    var obj = { hash_id: hash_id };
    if ($el.attr('type') === 'checkbox') {
      obj[name] = $el.is(':checked') ? 1 : 0;
    } else {
      var v = $el.val();
      if (name === 'zuitch_ai_api_key' && (!v || !String(v).trim())) {
        return;
      }
      obj[name] = v;
    }
    $el.addClass('warning');
    $.post(ajaxFile + '?f=admin_setting&s=update_general_setting', obj, function (data) {
      $el.removeClass('warning');
      if (data.status == 200) $el.addClass('success');
      else $el.addClass('error');
      setTimeout(function () { $el.removeClass('success error'); }, 1500);
    });
  }

  $('.zai-settings input[type=checkbox]').on('change', function () { saveField($(this)); });
  $('.zai-settings input[type=text], .zai-settings input[type=number], .zai-settings input[type=password], .zai-settings textarea').on('change blur', function () { saveField($(this)); });

  function loadChats(q) {
    var fd = new FormData();
    fd.append('hash', hash_id);
    fd.append('q', q || '');
    fetch(ajaxFile + '?f=zuitch_ai&s=admin_list', {
      method: 'POST', body: fd, credentials: 'same-origin',
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    }).then(function (r) { return r.json(); }).then(function (res) {
      var tb = $('#zai-admin-table tbody');
      tb.empty();
      if (res.status !== 200) return;
      (res.chats || []).forEach(function (c) {
        var last = (c.last_message || '').toString().slice(0, 80);
        var when = c.updated_at ? new Date(Number(c.updated_at) * 1000).toLocaleString() : '';
        var tr = $('<tr/>');
        tr.append('<td>' + c.id + '</td>');
        tr.append('<td>' + (c.username || c.user_id) + '</td>');
        tr.append('<td>' + $('<div/>').text(c.title || '').html() + '</td>');
        tr.append('<td>' + (c.msg_count || 0) + '</td>');
        tr.append('<td>' + $('<div/>').text(last).html() + '</td>');
        tr.append('<td>' + when + '</td>');
        var btn = $('<button type="button" class="btn btn-sm btn-info">Abrir</button>');
        btn.on('click', function () { openThread(c.id); });
        tr.append($('<td/>').append(btn));
        tb.append(tr);
      });
    });
  }

  function escapeHtml(s) {
    return $('<div/>').text(s || '').html();
  }

  function openThread(id) {
    var fd = new FormData();
    fd.append('hash', hash_id);
    fd.append('chat_id', id);
    fetch(ajaxFile + '?f=zuitch_ai&s=get_chat', {
      method: 'POST', body: fd, credentials: 'same-origin',
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    }).then(function (r) { return r.json(); }).then(function (res) {
      if (res.status !== 200) return;
      $('#zai-admin-thread').show();
      $('#zai-admin-thread-id').text('#' + id);
      var box = $('#zai-admin-msgs');
      box.empty();
      (res.messages || []).forEach(function (m) {
        var who = m.role === 'user' ? 'Usuario' : 'IA';
        var block = $('<div style="margin-bottom:12px;padding:10px;background:#fff;border-radius:8px;border:1px solid #e5e7eb;"/>');
        block.append('<div style="font-size:11px;color:#64748b;margin-bottom:4px;">' + who + ' · #' + m.id + (m.intent ? ' · ' + m.intent : '') + '</div>');
        block.append('<div style="white-space:pre-wrap;">' + escapeHtml(m.content) + '</div>');
        if (m.role === 'assistant') {
          var rating = m.rating || {};
          var tools = $('<div style="margin-top:8px;"/>');
          tools.append('<div style="font-size:12px;color:#64748b;">Rating usuario: ' + escapeHtml(rating.rating || '—') + ' · ' + escapeHtml(rating.comment || '') + '</div>');
          var okBtn = $('<button type="button" class="btn btn-sm btn-success" style="margin-right:6px;">OK</button>');
          var corr = $('<textarea class="form-control" rows="2" style="margin-top:6px;" placeholder="Corrección…">' + escapeHtml(rating.admin_correction || '') + '</textarea>');
          var saveCorr = $('<button type="button" class="btn btn-sm btn-warning" style="margin-top:6px;">Guardar corrección</button>');
          okBtn.on('click', function () {
            var f = new FormData();
            f.append('hash', hash_id);
            f.append('message_id', m.id);
            f.append('admin_ok', '1');
            f.append('admin_correction', '');
            fetch(ajaxFile + '?f=zuitch_ai&s=admin_correct', { method:'POST', body:f, credentials:'same-origin', headers:{'X-Requested-With':'XMLHttpRequest'} })
              .then(function(r){return r.json();}).then(function(){ alert('Marcado OK'); });
          });
          saveCorr.on('click', function () {
            var f = new FormData();
            f.append('hash', hash_id);
            f.append('message_id', m.id);
            f.append('admin_ok', '0');
            f.append('admin_correction', corr.val() || '');
            fetch(ajaxFile + '?f=zuitch_ai&s=admin_correct', { method:'POST', body:f, credentials:'same-origin', headers:{'X-Requested-With':'XMLHttpRequest'} })
              .then(function(r){return r.json();}).then(function(){ alert('Corrección guardada'); });
          });
          tools.append(okBtn).append(corr).append(saveCorr);
          block.append(tools);
        }
        box.append(block);
      });
    });
  }

  $('#zai-admin-search').on('click', function () { loadChats($('#zai-admin-q').val()); });
  loadChats('');
});
</script>
