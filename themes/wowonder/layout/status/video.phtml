<div class="story-video">
  <!-- // NEW STORY -->
	<video class="story-image-wrapper" controls preload="auto" autoplay playsinline style="width: 100%; height: 100%;" data-story-video="<?php echo $wo['media']['id'];?>">
    <!-- // NEW STORY -->
	    <source src="<?php echo $wo['media']['filename'];?>" type='video/mp4'>
	    <source src="<?php echo $wo['media']['filename'];?>" type='video/webm'> 
	</video>
</div>
<script>
jQuery(document).ready(function($) {
  var videoElement = $('video[data-story-video="<?php echo $wo['media']['id'];?>"]')[0];
  
  // Intentar reproducir con sonido
  if (videoElement) {
    videoElement.muted = false;
    videoElement.volume = 1.0;
    
    // Intentar reproducir automáticamente
    var playPromise = videoElement.play();
    
    if (playPromise !== undefined) {
      playPromise.then(function() {
        // Autoplay exitoso con sonido
        console.log('Video reproduciéndose con sonido');
      }).catch(function(error) {
        // Si falla el autoplay con sonido, intentar silenciado primero
        console.log('Autoplay con sonido bloqueado, intentando silenciado');
        videoElement.muted = true;
        videoElement.play().then(function() {
          // Una vez que empiece a reproducir, activar sonido
          setTimeout(function() {
            videoElement.muted = false;
          }, 100);
        });
      });
    }
  }
  
  $('video[data-story-video="<?php echo $wo['media']['id'];?>"]').mediaelementplayer({
    pluginPath: 'https://cdnjs.com/libraries/mediaelement-plugins/',
    shimScriptAccess: 'always',
    autoplay: true,
    startVolume: 1.0,
    features: ['playpause', 'fullscreen', 'current', 'progress', 'duration', 'speed', 'skipback', 'jumpforward', 'tracks', 'markers', 'volume', 'chromecast', 'contextmenu', 'flash'],
    success: function (media) {
        // Asegurar que el volumen esté al máximo
        media.setVolume(1.0);
        media.setMuted(false);
        media.addEventListener('ended', function (e) { /* pass */}, false); 
    },
  });

});
</script>