    // Zoom (botones + gestos táctiles: pellizco y arrastre con un dedo)
    var initialDistance = 0;
    var pinchBaseScale = 1;
    var currentScale = 1;
    var minScale = 1;
    var maxScale = 4;
    var isPinching = false;
    var isTouchPanning = false;
    var hasTouchMoved = false;
    var panStartX = 0, panStartY = 0, panOrigLeft = 0, panOrigTop = 0;
    var myImg = document.getElementById("wo_zoom_<?php echo $wo['story']['id'];?>");
    var draggableHelper = document.getElementById("draggableHelper");
    var $helper = $('#draggableHelper');

    function lboxCenterTransformOrigin() {
        if (myImg) {
            myImg.style.transformOrigin = '50% 50%';
        }
    }

    /** Origen del scale en el punto medio del pellizco (viewport → % del rect de la imagen). */
    function lboxSetPinchTransformOrigin(touches) {
        if (!myImg || !touches || touches.length < 2) return;
        var mx = (touches[0].clientX + touches[1].clientX) / 2;
        var my = (touches[0].clientY + touches[1].clientY) / 2;
        var rect = myImg.getBoundingClientRect();
        if (rect.width < 1 || rect.height < 1) return;
        var ox = ((mx - rect.left) / rect.width) * 100;
        var oy = ((my - rect.top) / rect.height) * 100;
        ox = Math.max(0, Math.min(100, ox));
        oy = Math.max(0, Math.min(100, oy));
        myImg.style.transformOrigin = ox.toFixed(2) + '% ' + oy.toFixed(2) + '%';
    }

    function lboxReadScale() {
        if (!myImg) return 1;
        var tr = window.getComputedStyle(myImg).transform;
        if (tr && tr !== 'none') {
            if (tr.indexOf('matrix3d') === 0) {
                var p = tr.match(/matrix3d\(([^)]+)\)/);
                if (p) {
                    var n = p[1].split(/\s*,\s*/);
                    var sx = parseFloat(n[0]);
                    if (!isNaN(sx) && sx > 0) return sx;
                }
            }
            if (tr.indexOf('matrix(') === 0) {
                var p2 = tr.match(/matrix\(([^)]+)\)/);
                if (p2) {
                    var n2 = p2[1].split(/\s*,\s*/);
                    var sx2 = parseFloat(n2[0]);
                    if (!isNaN(sx2) && sx2 > 0) return sx2;
                }
            }
        }
        var m = $(myImg).css('transform').match(/scale3d\(([^,]+)/);
        if (m && !isNaN(parseFloat(m[1]))) return parseFloat(m[1]);
        return $(myImg).hasClass('double_zoom') ? 2 : 1;
    }

    function lboxSyncDraggable(zoomed) {
        if (!$helper.length) return;
        if (zoomed) {
            $helper.draggable({ cursor: 'move', revert: false, disabled: false });
        } else {
            $helper.draggable({ disabled: true, revert: true });
            $helper.css({ left: '', top: '' });
        }
    }

    function zoomin(id) {
        if (!myImg) return;
        lboxCenterTransformOrigin();
        var currentZoom = lboxReadScale();
        var newScale = Math.min(maxScale, currentZoom + 0.5);
        $(myImg).css('transform', 'scale3d(' + newScale + ',' + newScale + ',1)');
        $(myImg).addClass('double_zoom');
        currentScale = newScale;
        lboxSyncDraggable(newScale > 1);
    }

    function zoomout(id) {
        if (!myImg) return;
        lboxCenterTransformOrigin();
        var currentZoom = lboxReadScale();
        var newScale = Math.max(minScale, currentZoom - 0.5);
        $(myImg).css('transform', 'scale3d(' + newScale + ',' + newScale + ',1)');
        if (newScale <= 1) {
            $(myImg).removeClass('double_zoom');
            currentScale = 1;
            lboxSyncDraggable(false);
        } else {
            currentScale = newScale;
            lboxSyncDraggable(true);
        }
    }

    function setScale(nextScale) {
        if (!myImg) return;
        var prev = lboxReadScale();
        var boundedScale = Math.max(minScale, Math.min(maxScale, nextScale));
        if (boundedScale <= 1) {
            lboxCenterTransformOrigin();
        } else if (prev <= 1.02) {
            lboxCenterTransformOrigin();
        }
        $(myImg).css('transform', 'scale3d(' + boundedScale + ',' + boundedScale + ',1)');
        if (boundedScale <= 1) {
            $(myImg).removeClass('double_zoom');
            currentScale = 1;
            lboxSyncDraggable(false);
        } else {
            $(myImg).addClass('double_zoom');
            currentScale = boundedScale;
            lboxSyncDraggable(true);
        }
    }

    var lightboxRoot = document.querySelector('.wo_imagecombo_lbox.lightpost-<?php echo $wo['story']['id']; ?>');
    var isImageReelsMode = !!(lightboxRoot && lightboxRoot.classList.contains('image-reels-mode'));
    var lastVerticalNavAt = 0;
    var swipeStartY = 0;

    function canNavigateLightboxVertically() {
        if (!isImageReelsMode) return false;
        if (!lightboxRoot) return false;
        var commentSection = lightboxRoot.querySelector('.comment-section');
        if (commentSection && commentSection.classList.contains('show-comments')) return false;
        return lboxReadScale() <= 1.05;
    }

    function navigateLightboxVertical(direction) {
        if (!canNavigateLightboxVertically()) return;
        var now = Date.now();
        if ((now - lastVerticalNavAt) < 420) return;
        lastVerticalNavAt = now;
        if (direction > 0) {
            Wo_PreviousPicture(<?php echo $query; ?>);
        } else {
            Wo_NextPicture(<?php echo $query; ?>);
        }
    }

    if (myImg && draggableHelper) {
        draggableHelper.addEventListener('wheel', function (e) {
            if (isImageReelsMode && canNavigateLightboxVertically()) {
                if (Math.abs(e.deltaY) > 8) {
                    e.preventDefault();
                    navigateLightboxVertical(e.deltaY < 0 ? 1 : -1);
                }
                return;
            }
            e.preventDefault();
            var direction = e.deltaY < 0 ? 0.2 : -0.2;
            setScale(lboxReadScale() + direction);
        }, { passive: false });

        draggableHelper.addEventListener('dblclick', function (e) {
            e.preventDefault();
            var currentZoom = lboxReadScale();
            if (currentZoom > 1.5) {
                setScale(1);
            } else {
                setScale(Math.min(maxScale, currentZoom + 1));
            }
        });
    }

    if (myImg && draggableHelper) {
        function getDistance(touches) {
            var dx = touches[0].clientX - touches[1].clientX;
            var dy = touches[0].clientY - touches[1].clientY;
            return Math.sqrt(dx * dx + dy * dy);
        }

        function finalizePinchScale(finalScale) {
            $(myImg).css('transition', 'transform .3s cubic-bezier(0,0,.25,1) 0');
            if (finalScale < 1.05) {
                lboxCenterTransformOrigin();
                $(myImg).css('transform', 'scale3d(1,1,1)');
                $(myImg).removeClass('double_zoom');
                currentScale = 1;
                lboxSyncDraggable(false);
            } else {
                $(myImg).addClass('double_zoom');
                currentScale = finalScale;
                lboxSyncDraggable(true);
            }
        }

        draggableHelper.addEventListener('touchstart', function (e) {
            if (e.touches.length === 2) {
                e.preventDefault();
                isPinching = true;
                isTouchPanning = false;
                lboxSetPinchTransformOrigin(e.touches);
                initialDistance = getDistance(e.touches);
                pinchBaseScale = lboxReadScale();
                $(myImg).css('transition', 'none');
                if ($helper.data('ui-draggable')) {
                    try { $helper.draggable('disable'); } catch (err) {}
                }
            } else if (e.touches.length === 1 && lboxReadScale() > 1 && !isPinching) {
                isTouchPanning = true;
                hasTouchMoved = false;
                var t = e.touches[0];
                panStartX = t.clientX;
                panStartY = t.clientY;
                panOrigLeft = parseInt($helper.css('left'), 10) || 0;
                panOrigTop = parseInt($helper.css('top'), 10) || 0;
                if ($helper.data('ui-draggable')) {
                    try { $helper.draggable('disable'); } catch (err2) {}
                }
            } else if (e.touches.length === 1) {
                swipeStartY = e.touches[0].clientY;
            }
        }, { passive: false });

        draggableHelper.addEventListener('touchmove', function (e) {
            if (e.touches.length === 2 && isPinching) {
                e.preventDefault();
                var currentDistance = getDistance(e.touches);
                if (initialDistance <= 0) return;
                var scale = pinchBaseScale * (currentDistance / initialDistance);
                scale = Math.max(minScale, Math.min(maxScale, scale));
                $(myImg).css({
                    transform: 'scale3d(' + scale + ',' + scale + ',1)',
                    transition: 'none'
                });
            } else if (e.touches.length === 1 && isTouchPanning && !isPinching) {
                var sc = lboxReadScale();
                if (sc > 1) {
                    e.preventDefault();
                    hasTouchMoved = true;
                    var t = e.touches[0];
                    var dx = t.clientX - panStartX;
                    var dy = t.clientY - panStartY;
                    $helper.css({
                        left: (panOrigLeft + dx) + 'px',
                        top: (panOrigTop + dy) + 'px'
                    });
                }
            }
        }, { passive: false });

        function onTouchEnd(e) {
            if (isPinching && e.touches.length < 2) {
                e.preventDefault();
                isPinching = false;
                finalizePinchScale(lboxReadScale());
            }
            if (isTouchPanning && e.touches.length === 0) {
                isTouchPanning = false;
                if (lboxReadScale() > 1) {
                    lboxSyncDraggable(true);
                }
            }
        }

        draggableHelper.addEventListener('touchend', onTouchEnd, { passive: false });
        draggableHelper.addEventListener('touchcancel', onTouchEnd, { passive: false });

        draggableHelper.addEventListener('touchend', function (e) {
            if (isImageReelsMode && !hasTouchMoved && e.changedTouches.length === 1 && canNavigateLightboxVertically()) {
                var swipeEndY = e.changedTouches[0].clientY;
                var deltaY = swipeEndY - swipeStartY;
                if (Math.abs(deltaY) > 55) {
                    navigateLightboxVertical(deltaY > 0 ? 1 : -1);
                    return;
                }
            }
            if (e.changedTouches.length === 1 && !hasTouchMoved) {
                var now = Date.now();
                draggableHelper._lastTap = draggableHelper._lastTap || 0;
                if (now - draggableHelper._lastTap < 300) {
                    var currentZoom = lboxReadScale();
                    if (currentZoom > 1.5) {
                        setScale(1);
                    } else {
                        setScale(Math.min(maxScale, currentZoom + 1));
                    }
                    draggableHelper._lastTap = 0;
                } else {
                    draggableHelper._lastTap = now;
                }
            }
        }, { passive: true });
    }

    var angle = 0;

    function rotate(id) {
        angle += 90;
        $('#wo_zoom_<?php echo $wo['story']['id'];?>').css({'transform': 'rotate(-' + angle + 'deg)'});
        $.get(Wo_Ajax_Requests_File(), {
            f: 'rotate_image',
            angle: 90,
            image: '<?php echo $wo['story']['id'];?>'
        }, function (data) {

        });
        if (angle == 360) {
            angle = 0;
        }
    }

    changeURL(<?php echo $query; ?>);


    function changeURL(postId) {
    <?php if(isset($wo['page']) && $wo['page'] == 'reels') { ?>
        let newURL = "<?php echo $wo['config']['site_url'] ?>" +  "/reels/" + postId; // Modify the URL as needed
        <?php if(!empty($wo['reelOwnerName'])) { ?>
             newURL += '/' + '<?php echo $wo['reelOwnerName']; ?>';
        <?php } ?>
        window.history.pushState({}, "", newURL);
        <?php } ?>
    }

    function Wo_ToggleLightboxComments(postId, shouldOpen) {
        var root = document.querySelector('.wo_imagecombo_lbox.lightpost-' + postId);
        if (!root) return;
        var commentSection = root.querySelector('.comment-section');
        if (!commentSection) return;
        var openComments = (typeof shouldOpen === 'boolean') ? shouldOpen : !commentSection.classList.contains('show-comments');
        if (openComments) {
            commentSection.classList.add('show-comments');
            commentSection.style.setProperty('display', 'block', 'important');
        } else {
            commentSection.classList.remove('show-comments');
            commentSection.style.setProperty('display', 'none', 'important');
        }
        var commentInput = root.querySelector('#post-comments-<?php echo $wo['story']['id']; ?> .comment-textarea');
        if (openComments && commentInput) {
            setTimeout(function () {
                commentInput.focus();
            }, 200);
        }
    }
</script>

