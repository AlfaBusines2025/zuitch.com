// Activar autoplay con sonido para videos en historias
$(document).ready(function() {
  var videoStory = document.getElementById('video_story');
  if (videoStory) {
    // Mejorar visualización del video - remover placeholders genéricos
    function fixStoryVideoDisplay() {
      // Asegurar que el video sea completamente visible
      videoStory.style.display = 'block';
      videoStory.style.visibility = 'visible';
      videoStory.style.opacity = '1';
      videoStory.style.width = '100%';
      videoStory.style.height = '100%';
      videoStory.style.maxWidth = '100%';
      videoStory.style.objectFit = 'contain';
      videoStory.style.backgroundColor = 'transparent';
      videoStory.style.border = 'none';
      videoStory.style.outline = 'none';
      videoStory.style.position = 'relative';
      videoStory.style.zIndex = '1';
      
      // Remover atributos que puedan ocultar el video
      videoStory.removeAttribute('hidden');
      videoStory.removeAttribute('aria-hidden');
      
      // Remover placeholders y overlays genéricos del contenedor
      var parent = videoStory.parentElement;
      if (parent) {
        // Buscar y ocultar placeholders genéricos
        var placeholders = parent.querySelectorAll(
          '.video-placeholder, .video-loading, [class*="placeholder"]:not(.draggableHelper_story), [class*="loading"]:not(.mfp_progress_line_), [class*="spinner"]'
        );
        placeholders.forEach(function(p) {
          if (p !== videoStory && !p.contains(videoStory)) {
            p.style.display = 'none';
            p.style.visibility = 'hidden';
            p.style.opacity = '0';
          }
        });
        
        // Remover botones de play genéricos
        var genericPlayButtons = parent.querySelectorAll(
          '[class*="play-button"], [class*="play-btn"], .play-overlay, [class*="play-overlay"]'
        );
        genericPlayButtons.forEach(function(btn) {
          if (!btn.closest('video') && !btn.closest('.custom-video-controls')) {
            btn.style.display = 'none';
            btn.style.visibility = 'hidden';
          }
        });
        
        // Asegurar que el contenedor no tenga estilos que oculten el video
        parent.style.backgroundColor = 'transparent';
      }
    }
    
    // Aplicar fix inmediatamente
    fixStoryVideoDisplay();
    
    // Aplicar fix cuando el video se carga
    videoStory.addEventListener('loadedmetadata', function() {
      fixStoryVideoDisplay();
      videoStory.style.display = 'block';
      videoStory.style.visibility = 'visible';
    }, { once: true });
    
    videoStory.addEventListener('canplay', function() {
      fixStoryVideoDisplay();
      videoStory.style.display = 'block';
      videoStory.style.visibility = 'visible';
      videoStory.style.opacity = '1';
    }, { once: true });
    
    videoStory.addEventListener('loadeddata', function() {
      fixStoryVideoDisplay();
      videoStory.style.display = 'block';
    }, { once: true });
    
    // Aplicar fix periódicamente para asegurar que se mantenga
    var fixInterval = setInterval(function() {
      if (videoStory && document.body.contains(videoStory)) {
        fixStoryVideoDisplay();
      } else {
        clearInterval(fixInterval);
      }
    }, 500);
    
    // Configurar video para reproducir con sonido
    videoStory.muted = false;
    videoStory.volume = 1.0;
    
    // Intentar reproducir automáticamente con sonido
    var playPromise = videoStory.play();
    
    if (playPromise !== undefined) {
      playPromise.then(function() {
        // Autoplay exitoso con sonido
        console.log('Historia reproduciéndose con sonido');
      }).catch(function(error) {
        // Si falla el autoplay con sonido, intentar silenciado primero
        console.log('Autoplay con sonido bloqueado, intentando silenciado');
        videoStory.muted = true;
        videoStory.play().then(function() {
          // Una vez que empiece a reproducir, activar sonido después de un breve delay
          setTimeout(function() {
            videoStory.muted = false;
          }, 100);
        }).catch(function(err) {
          console.log('Error al reproducir video:', err);
        });
      });
    }
    
    // Asegurar que el sonido esté activado cuando el usuario interactúe
    $(document).on('click touchstart', function() {
      if (videoStory && videoStory.paused) {
        videoStory.muted = false;
        videoStory.play();
      }
    });
  }
  
  // Función para detener el video cuando se cierra el lightbox
  function stopStoryVideo() {
    // Detener video específico de la historia
    var videoStory = document.getElementById('video_story');
    if (videoStory) {
      try {
        videoStory.pause();
        videoStory.currentTime = 0;
        videoStory.muted = true;
        videoStory.volume = 0;
        // Limpiar la fuente del video para detener completamente la reproducción
        if (videoStory.src) {
          videoStory.src = '';
          videoStory.load();
        }
        // También limpiar los sources
        var sources = videoStory.querySelectorAll('source');
        sources.forEach(function(source) {
          source.src = '';
        });
      } catch(e) {
        console.log('Error al detener video_story:', e);
      }
    }
    
    // Detener todos los videos relacionados con historias
    var storyVideos = document.querySelectorAll('video[data-story-video], .story-image-wrapper video, .story-video video');
    storyVideos.forEach(function(video) {
      if (video) {
        try {
          video.pause();
          video.currentTime = 0;
          video.muted = true;
          video.volume = 0;
          if (video.src) {
            video.src = '';
            video.load();
          }
          // Limpiar sources
          var sources = video.querySelectorAll('source');
          sources.forEach(function(source) {
            source.src = '';
          });
        } catch(e) {
          console.log('Error al detener video:', e);
        }
      }
    });
    
    // Detener MediaElementPlayer si está activo
    if (typeof mejs !== 'undefined') {
      $('video').each(function() {
        var player = $(this).data('mediaelementplayer');
        if (player && player.media) {
          try {
            player.pause();
            player.setCurrentTime(0);
            player.setMuted(true);
            player.setVolume(0);
          } catch(e) {
            console.log('Error al detener MediaElementPlayer:', e);
          }
        }
      });
    }
    
    // Forzar detención de todos los videos en la página
    var allVideos = document.querySelectorAll('video');
    allVideos.forEach(function(video) {
      if (video && !video.paused) {
        try {
          video.pause();
          video.muted = true;
          video.volume = 0;
        } catch(e) {
          console.log('Error al pausar video:', e);
        }
      }
    });
  }
  
  // Interceptar el cierre del lightbox para detener el video ANTES de cerrar
  // Guardar la función original si existe
  if (!window._originalWo_CloseLightbox) {
    window._originalWo_CloseLightbox = window.Wo_CloseLightbox;
  }
  
  // Crear nueva función que siempre detiene los videos primero
  window.Wo_CloseLightbox = function() {
    // Detener videos ANTES de cerrar
    stopStoryVideo();
    // Pequeño delay para asegurar que los videos se detengan completamente
    setTimeout(function() {
      if (window._originalWo_CloseLightbox) {
        window._originalWo_CloseLightbox.apply(this, arguments);
      } else {
        // Si no hay función original, hacer el cierre básico
        $('.lightbox-container').remove();
        document.body.style.overflow = 'auto';
      }
    }, 100);
  };
  
  // Detener cuando se hace clic en el botón de cerrar
  $(document).on('click', '.close-lightbox', function(e) {
    e.stopPropagation();
    stopStoryVideo();
    setTimeout(function() {
      if (window.Wo_CloseLightbox) {
        window.Wo_CloseLightbox();
      }
    }, 100);
  });
  
  // Detener cuando se hace clic en el fondo del lightbox (usando delegación de eventos)
  $(document).on('click', '.lightbox-backgrond', function(e) {
    // Solo procesar si el clic es directamente en el fondo, no en elementos hijos
    if (e.target === this) {
      e.preventDefault();
      e.stopPropagation();
      stopStoryVideo();
      setTimeout(function() {
        if (window.Wo_CloseLightbox) {
          window.Wo_CloseLightbox();
        }
      }, 100);
      return false;
    }
  });
  
  // También manejar el clic directamente en el elemento del fondo si existe
  var backgroundElement = document.getElementById('lightbox-background-story');
  if (backgroundElement) {
    backgroundElement.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      stopStoryVideo();
      setTimeout(function() {
        if (window.Wo_CloseLightbox) {
          window.Wo_CloseLightbox();
        }
      }, 100);
      return false;
    });
  }
  
  // Detener cuando se presiona ESC
  $(document).on('keydown', function(e) {
    if (e.keyCode == 27) {
      stopStoryVideo();
      setTimeout(function() {
        if (originalCloseLightbox) {
          originalCloseLightbox();
        }
      }, 50);
    }
  });
});

</script>
