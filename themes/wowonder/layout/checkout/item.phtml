	<?php
	/**
	 * ==== CAPTURA EN PHP Y GUARDA EN INPUTS HIDDEN ====
	 * Necesita $COUNTRY_CODE_BY_ID (id => code) definido antes del loop.
	 */

	if (!function_exists('dhl_resolve_val')) {
		function dhl_resolve_val(array $product, $v): string {
			if ($v === null) return '';
			$key = trim((string)$v);
			$known = ['originPostalCode','originCityName','weight','length','width','height'];
			if (in_array($key, $known, true) && array_key_exists($key, $product)) {
				$val = $product[$key];
				return ($val === null) ? '' : (string)$val;
			}
			if (array_key_exists($key, $product)) {
				$val = $product[$key];
				return ($val === null) ? '' : (string)$val;
			}
			return $key;
		}
	}
	if (!function_exists('dhl_country_code_by_id')) {
		function dhl_country_code_by_id(?string $id, ?array $map): string {
			if (!$id || !$map) return '';
			return $map[$id] ?? '';
		}
	}

	$product = $wo['product'];
	$fields  = isset($product['fields']) && is_array($product['fields']) ? $product['fields'] : $product;

	$productId        = isset($product['id']) ? (string)$product['id'] : '';
	$shippingMethodId = isset($fields['fid_1']) ? (string)$fields['fid_1'] : '';
	$isDHL            = ($shippingMethodId === '1');

	$countryId         = isset($fields['fid_3']) ? (string)$fields['fid_3'] : '';
	$originCountryCode = dhl_country_code_by_id($countryId, isset($COUNTRY_CODE_BY_ID) && is_array($COUNTRY_CODE_BY_ID) ? $COUNTRY_CODE_BY_ID : null);

	// NUEVO: cantidad desde el item del carrito
	$itemQuantity = isset($wo['item']) && isset($wo['item']->units) ? (string)$wo['item']->units : '1';

	$params = [
		'originCountryCode' => $originCountryCode,
		'originPostalCode'  => dhl_resolve_val($product, $fields['fid_4'] ?? null),
		'originCityName'    => dhl_resolve_val($product, $fields['fid_5'] ?? null),
		'weight'            => dhl_resolve_val($product, $fields['fid_6'] ?? null),
		'length'            => dhl_resolve_val($product, $fields['fid_7'] ?? null),
		'width'             => dhl_resolve_val($product, $fields['fid_8'] ?? null),
		'height'            => dhl_resolve_val($product, $fields['fid_9'] ?? null),

		// NUEVO: incluir cantidad en el payload
		'quantity'          => $itemQuantity,
	];

	$out = [
		'product_id'         => $productId,
		'dhl_active'         => $isDHL ? 1 : 0,
		'shipping_method_id' => $shippingMethodId,
		'origin_country_id'  => $countryId,
	] + $params;

	// Hidden inputs (uno por campo) => dhl_meta[PRODUCT_ID][campo]
	$baseName = 'dhl_meta[' . htmlspecialchars($productId, ENT_QUOTES, 'UTF-8') . ']';
	?>
	<!-- Hidden meta DHL por producto -->
	<input type="hidden" name="<?php echo $baseName; ?>[product_id]"         value="<?php echo htmlspecialchars($out['product_id'], ENT_QUOTES, 'UTF-8'); ?>">
	<input type="hidden" name="<?php echo $baseName; ?>[dhl_active]"         value="<?php echo htmlspecialchars((string)$out['dhl_active'], ENT_QUOTES, 'UTF-8'); ?>">
	<input type="hidden" name="<?php echo $baseName; ?>[shipping_method_id]" value="<?php echo htmlspecialchars($out['shipping_method_id'], ENT_QUOTES, 'UTF-8'); ?>">
	<input type="hidden" name="<?php echo $baseName; ?>[origin_country_id]"  value="<?php echo htmlspecialchars($out['origin_country_id'], ENT_QUOTES, 'UTF-8'); ?>">

	<input type="hidden" name="<?php echo $baseName; ?>[originCountryCode]"  value="<?php echo htmlspecialchars($out['originCountryCode'], ENT_QUOTES, 'UTF-8'); ?>">
	<input type="hidden" name="<?php echo $baseName; ?>[originPostalCode]"   value="<?php echo htmlspecialchars($out['originPostalCode'], ENT_QUOTES, 'UTF-8'); ?>">
	<input type="hidden" name="<?php echo $baseName; ?>[originCityName]"     value="<?php echo htmlspecialchars($out['originCityName'], ENT_QUOTES, 'UTF-8'); ?>">

	<input type="hidden" name="<?php echo $baseName; ?>[weight]"             value="<?php echo htmlspecialchars($out['weight'], ENT_QUOTES, 'UTF-8'); ?>">
	<input type="hidden" name="<?php echo $baseName; ?>[length]"             value="<?php echo htmlspecialchars($out['length'], ENT_QUOTES, 'UTF-8'); ?>">
	<input type="hidden" name="<?php echo $baseName; ?>[width]"              value="<?php echo htmlspecialchars($out['width'], ENT_QUOTES, 'UTF-8'); ?>">
	<input type="hidden" name="<?php echo $baseName; ?>[height]"             value="<?php echo htmlspecialchars($out['height'], ENT_QUOTES, 'UTF-8'); ?>">

	<!-- NUEVO: hidden individual de cantidad -->
	<input type="hidden" name="<?php echo $baseName; ?>[quantity]"           value="<?php echo htmlspecialchars($out['quantity'], ENT_QUOTES, 'UTF-8'); ?>">

	<!-- Hidden con el JSON completo para este producto (incluye quantity) -->
	<input type="hidden" name="dhl_meta_json[<?php echo htmlspecialchars($productId, ENT_QUOTES, 'UTF-8');?>]" 
	       value="<?php echo htmlspecialchars(json_encode($out, JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES), ENT_QUOTES, 'UTF-8'); ?>">

	<?php
	// Acumular para JSON global (después del loop imprímelo en un hidden único)
	if (!isset($GLOBALS['DHL_CART']) || !is_array($GLOBALS['DHL_CART'])) {
		$GLOBALS['DHL_CART'] = [];
	}
	$GLOBALS['DHL_CART'][] = $out;
