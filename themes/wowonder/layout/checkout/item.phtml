/* ===== Helpers ===== */
if (!function_exists('dhl_resolve_val')) {
  function dhl_resolve_val(array $product, $v): string {
    if ($v === null) return '';
    $key = trim((string)$v);
    $known = ['originPostalCode','originCityName','weight','length','width','height'];
    if (in_array($key, $known, true) && array_key_exists($key, $product)) {
      $val = $product[$key];
      return ($val === null) ? '' : (string)$val;
    }
    if (array_key_exists($key, $product)) {
      $val = $product[$key];
      return ($val === null) ? '' : (string)$val;
    }
    return $key;
  }
}
if (!function_exists('dhl_country_code_by_id')) {
  function dhl_country_code_by_id(?string $id, array $map): string {
    if (!$id) return '';
    return $map[$id] ?? '';
  }
}
