                    Wo_NextReelVideo();
                } else {
                    Wo_PreviousReelVideo();
                }
            }, { passive: true, capture: true });
        }

	});

    function playPauseVideos(nextElement) {
        if (typeof window.woReelsWarmNeighbourBuffers === 'function') {
            window.woReelsWarmNeighbourBuffers();
        }
        var v = $(nextElement).find('video')[0];
        window.woReelsHardPauseAll(v);
        if (!v) {
            return;
        }
        var p = v._woPlyr;
        window.requestAnimationFrame(function () {
            window.requestAnimationFrame(function () {
                var runPlay = p && typeof p.play === 'function' ? function () {
                    return p.play();
                } : function () {
                    return v.play();
                };
                runPlay().catch(function (err) {
                    if (err && err.name === 'AbortError') {
                        return;
                    }
                    if (window.ZuitchReelsDebug) {
                        window.ZuitchReelsDebug.warn('playPauseVideos: play() en reel activo', err);
                    }
                    try {
                        var pe = v && v.getAttribute && v.getAttribute('data-post-video');
                        var pid = pe ? parseInt(pe, 10) : 0;
                        if (typeof window.ZuitchReelsServerLog === 'function') {
                            window.ZuitchReelsServerLog('warn', 'play_after_reel_change', String(err && err.message || err), pid, {
                                name: err && err.name
                            });
                        }
                    } catch (eL) {}
                });
            });
        });
    }

