<script>
(function () {
    window.__ZUITCH_REELS_LOG_ENABLED = <?php echo !empty($wo['loggedin']) ? 'true' : 'false'; ?>;
    window.__ZUITCH_REELS_LOG_OWNER = <?php echo json_encode(isset($wo['reelOwnerName']) ? (string) $wo['reelOwnerName'] : '', JSON_UNESCAPED_UNICODE); ?>;

    if (!window.__ZUITCH_REELS_LOG_ENABLED) {
        window.ZuitchReelsServerLog = function () {};
        window.ZuitchReelsServerLog.flush = function () {};
        return;
    }

    var queue = [];
    var flushTimer = null;
    var MAX_BATCH = 20;

    function getHash() {
        try {
            var el = document.querySelector('input.main_session');
            return el && el.value ? el.value : '';
        } catch (e) {
            return '';
        }
    }

    function collectClientMeta() {
        var ua = navigator.userAgent || '';
        var isIOS = /iPad|iPhone|iPod/i.test(ua) || (navigator.platform === 'MacIntel' && (navigator.maxTouchPoints || 0) > 1);
        var isAndroid = /Android/i.test(ua);
        var isWv = /\bwv\b/i.test(ua);
        var isApp = (typeof window.__ZUITCH_ANDROID_WEBVIEW !== 'undefined' && !!window.__ZUITCH_ANDROID_WEBVIEW)
            || isWv
            || !!window.ZuitchAppBridge
            || (!!window.webkit && !!window.webkit.messageHandlers);
        return {
            ua: ua,
            platform: navigator.platform || '',
            language: navigator.language || '',
            screen: typeof screen !== 'undefined' ? { w: screen.width, h: screen.height } : {},
            viewport: { w: window.innerWidth, h: window.innerHeight },
            dpr: typeof window.devicePixelRatio !== 'undefined' ? window.devicePixelRatio : 1,
            touch: 'ontouchstart' in window,
            maxTouchPoints: typeof navigator.maxTouchPoints !== 'undefined' ? navigator.maxTouchPoints : 0,
            isIOS: isIOS,
            isAndroid: isAndroid,
            isAndroidWebview: !!window.__woReelsAndroidWebview,
            clientWebViewFlag: typeof window.__ZUITCH_ANDROID_WEBVIEW !== 'undefined' ? !!window.__ZUITCH_ANDROID_WEBVIEW : null,
            isAppLikely: !!isApp,
            connection: (navigator.connection && navigator.connection.effectiveType) ? String(navigator.connection.effectiveType) : '',
            url: location.href,
            reelOwnerFilter: window.__ZUITCH_REELS_LOG_OWNER || null
        };
    }

    function flush() {
        clearTimeout(flushTimer);
        flushTimer = null;
        if (!queue.length) {
            return;
        }
        if (typeof jQuery === 'undefined' || typeof Wo_Ajax_Requests_File !== 'function') {
            queue = [];
            return;
        }
        var hash = getHash();
        if (!hash) {
            flushTimer = setTimeout(flush, 2000);
            return;
        }
        var batch = queue.splice(0, MAX_BATCH);
        jQuery.ajax({
            url: Wo_Ajax_Requests_File() + '?f=reels_client_log&hash=' + encodeURIComponent(hash),
            type: 'POST',
            data: JSON.stringify({ events: batch }),
            contentType: 'application/json; charset=UTF-8',
            processData: false,
            timeout: 15000
        });
    }

    window.ZuitchReelsServerLog = function (level, type, message, postId, extraContext) {
        var ev = {
            type: type || 'event',
            level: level || 'info',
            message: String(message || ''),
            postId: postId ? parseInt(postId, 10) || 0 : 0,
            client: collectClientMeta(),
            context: extraContext != null ? extraContext : null
        };
        queue.push(ev);
        if (queue.length >= 8) {
            flush();
        } else {
            clearTimeout(flushTimer);
            flushTimer = setTimeout(flush, 4000);
        }
    };
    window.ZuitchReelsServerLog.flush = flush;

    window.addEventListener('beforeunload', function () {
        if (!queue.length || typeof Wo_Ajax_Requests_File !== 'function') {
            return;
        }
        var hash = getHash();
        if (!hash || !navigator.sendBeacon) {
            return;
        }
        try {
            var url = Wo_Ajax_Requests_File() + '?f=reels_client_log&hash=' + encodeURIComponent(hash);
            var blob = new Blob([JSON.stringify({ events: queue })], { type: 'application/json' });
            navigator.sendBeacon(url, blob);
            queue = [];
        } catch (e) {}
    });

    document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden' && queue.length) {
            flush();
        }
    });
})();
</script>
