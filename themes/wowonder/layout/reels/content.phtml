        }

        /* WebView Android: swipe vertical nativo (el video nativo intercepta toques al reproducir; jQuery Mobile no ve el gesto). */
        if (window.__woReelsAndroidWebview && !window.__woReelsAndroidSwipeBound) {
            window.__woReelsAndroidSwipeBound = true;
            var woReelsSwipeSx = 0;
            var woReelsSwipeSy = 0;
            var woReelsSwipeActive = false;
            document.addEventListener('touchstart', function (e) {
                if (!e.touches || !e.touches.length) {
                    return;
                }
                if (!e.target || !e.target.closest) {
                    return;
                }
                if (!e.target.closest('.wo_reels_cont .story-img')) {
                    woReelsSwipeActive = false;
                    return;
                }
                if (e.target.closest('.reels-share-btn')) {
                    woReelsSwipeActive = false;
                    return;
                }
                var t0 = e.touches[0];
                woReelsSwipeSx = t0.clientX;
                woReelsSwipeSy = t0.clientY;
                woReelsSwipeActive = true;
            }, { passive: true, capture: true });
            document.addEventListener('touchcancel', function () {
                woReelsSwipeActive = false;
            }, { passive: true, capture: true });
            document.addEventListener('touchend', function (e) {
                if (!woReelsSwipeActive) {
                    return;
                }
                woReelsSwipeActive = false;
                if (!e.changedTouches || !e.changedTouches.length) {
                    return;
                }
                if (!e.target || !e.target.closest) {
                    return;
                }
                if (!e.target.closest('.wo_reels_cont .story-img')) {
                    return;
                }
                var t1 = e.changedTouches[0];
                var dx = t1.clientX - woReelsSwipeSx;
                var dy = t1.clientY - woReelsSwipeSy;
                if (Math.abs(dy) < 56) {
                    return;
                }
                if (Math.abs(dy) < Math.abs(dx) * 1.15) {
                    return;
