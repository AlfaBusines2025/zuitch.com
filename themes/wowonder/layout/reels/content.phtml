window.woReelsHardPauseAll = function (exceptVideoElement) {
    try {
        var lists = document.querySelectorAll('.reels_list');
        var visIdx = -1;
        var i;
        for (i = 0; i < lists.length; i++) {
            if (!lists[i].classList.contains('hidden')) {
                visIdx = i;
                break;
            }
        }
        var start = visIdx < 0 ? 0 : Math.max(0, visIdx - 2);
        var end = visIdx < 0 ? lists.length - 1 : Math.min(lists.length - 1, visIdx + 2);
        for (i = start; i <= end; i++) {
            var vids = lists[i].querySelectorAll('video');
            for (var v = 0; v < vids.length; v++) {
                var vid = vids[v];
                if (exceptVideoElement && vid === exceptVideoElement) {
                    continue;
                }
                try {
                    if (vid._woPlyr && typeof vid._woPlyr.pause === 'function') {
                        vid._woPlyr.pause();
                    }
                } catch (e) {}
                try {
                    vid.pause();
                } catch (e2) {}
            }
        }
    } catch (e) {}
};
/** Preload agresivo solo en reel visible + siguiente; resto metadata para no saturar iOS. */
window.woReelsWarmNeighbourBuffers = function () {
    try {
        var lists = document.querySelectorAll('.reels_list');
        var visIdx = -1;
        var i;
        for (i = 0; i < lists.length; i++) {
            if (!lists[i].classList.contains('hidden')) {
                visIdx = i;
                break;
            }
        }
        for (i = 0; i < lists.length; i++) {
            var vid = lists[i].querySelector('video');
            if (!vid) {
                continue;
            }
            try {
                if (visIdx >= 0 && (i === visIdx || i === visIdx + 1)) {
                    vid.setAttribute('preload', 'auto');
                } else {
                    vid.setAttribute('preload', 'metadata');
                }
            } catch (e1) {}
        }
    } catch (e2) {}
};
/** Mantener historial atrás (keepBehind) y pocos adelante (keepAhead); liberar el resto. */
window.woReelsPruneDomWindow = function (keepBehind, keepAhead) {
    try {
        if (typeof keepBehind !== 'number') {
            keepBehind = 5;
        }
        if (typeof keepAhead !== 'number') {
            keepAhead = 2;
        }
        var lists = Array.prototype.slice.call(document.querySelectorAll('.reels_list'));
        var visIdx = -1;
        var i;
        for (i = 0; i < lists.length; i++) {
            if (!lists[i].classList.contains('hidden')) {
                visIdx = i;
                break;
            }
        }
        if (visIdx < 0) {
            return;
        }
        var minKeep = Math.max(0, visIdx - keepBehind);
        var maxKeep = Math.min(lists.length - 1, visIdx + keepAhead);
        if (lists.length <= (maxKeep - minKeep + 1)) {
            return;
        }
        for (i = lists.length - 1; i >= 0; i--) {
            if (i >= minKeep && i <= maxKeep) {
                continue;
            }
            var node = lists[i];
            var vids = node.querySelectorAll('video');
            for (var v = 0; v < vids.length; v++) {
                var vid = vids[v];
                try {
                    if (vid._woPlyr && typeof vid._woPlyr.destroy === 'function') {
                        vid._woPlyr.destroy();
                    }
                } catch (eD) {}
                try {
                    vid._woPlyr = null;
                } catch (eN) {}
                try {
                    vid.pause();
                } catch (eP) {}
                try {
                    vid.removeAttribute('src');
                    var sources = vid.querySelectorAll('source');
                    for (var s = 0; s < sources.length; s++) {
                        sources[s].removeAttribute('src');
                    }
                    vid.load();
                } catch (eS) {}
            }
            try {
                if (node.parentNode) {
                    node.parentNode.removeChild(node);
                }
            } catch (eR) {}
        }
    } catch (e) {}
};
/** Diferir prune para no reindexar a mitad de un burst de next/prev. */
window.woReelsSchedulePruneDomWindow = function (keepBehind, keepAhead) {
    try {
        if (window.__woReelsPruneTimer) {
            clearTimeout(window.__woReelsPruneTimer);
        }
        window.__woReelsPruneTimer = setTimeout(function () {
            window.__woReelsPruneTimer = null;
            if (typeof window.woReelsPruneDomWindow === 'function') {
                window.woReelsPruneDomWindow(keepBehind, keepAhead);
            }
        }, 550);
    } catch (e) {}
};
