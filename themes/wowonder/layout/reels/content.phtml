                    });
                }
            } catch (eP) {}
        });
    }

    /** dir: 'next' | 'prev' — animación tipo TikTok (vertical). */
    function woReelsRunSlideTransition(dir, $out, $in, onDone) {
        /* En WebView Android: sin animación (más fluido y evita fallos con transitionend). */
        if (window.__woReelsAndroidWebview) {
            $out.removeClass('reels-anim-next-exit reels-anim-prev-exit');
            $in.removeClass(
                'reels-anim-next-enter-prep reels-anim-next-enter-go reels-anim-prev-enter-prep reels-anim-prev-enter-go'
            );
            $in.removeClass('hidden');
            $out.addClass('hidden');
            if (typeof onDone === 'function') {
                onDone();
            }
            return;
        }
        var prep = dir === 'next' ? 'reels-anim-next-enter-prep' : 'reels-anim-prev-enter-prep';
        var go = dir === 'next' ? 'reels-anim-next-enter-go' : 'reels-anim-prev-enter-go';
        var exit = dir === 'next' ? 'reels-anim-next-exit' : 'reels-anim-prev-exit';

        $in.removeClass('hidden').addClass(prep);
        if ($in[0]) {
            void $in[0].offsetHeight;
        }
        $out.addClass(exit);
        $in.addClass(go);

        var done = false;
        var elIn = $in[0];
        function finish() {
            if (done) {
                return;
            }
            done = true;
            $out.addClass('hidden').removeClass('reels-anim-next-exit reels-anim-prev-exit');
            $in.removeClass(
                'reels-anim-next-enter-prep reels-anim-next-enter-go reels-anim-prev-enter-prep reels-anim-prev-enter-go'
            );
            if (typeof onDone === 'function') {
                onDone();
            }
        }

        function onEnd(e) {
            if (!e || e.target !== elIn) {
                return;
            }
            if (e.propertyName !== 'transform' && e.propertyName !== '-webkit-transform') {
                return;
            }
            elIn.removeEventListener('transitionend', onEnd);
            finish();
        }
        if (elIn) {
            elIn.addEventListener('transitionend', onEnd);
        }
        setTimeout(function () {
            if (elIn) {
                elIn.removeEventListener('transitionend', onEnd);
            }
            finish();
        }, 480);
    }

    function Wo_NextReelVideo() {
        var currentId = parseInt($('.reels_list:not(.hidden)').data('id'), 10);
        if (window.__woReelsAnimating) {
            try {
                if (typeof window.ZuitchReelsServerLog === 'function') {
                    window.ZuitchReelsServerLog('warn', 'reel_next_blocked_animating', 'Siguiente ignorado: transición en curso', currentId || 0, { dir: 'next' });
                }
            } catch (eA) {}
            return;
        }
        var $current = $(".reels_list[data-id='" + currentId + "']");
        var currentIndex = $current.index();
        var $next = $(".reels_list").eq(currentIndex + 1);
        var skipPrefetch = ($(".reels_list[data-id='" + currentId + "']").length > 2);

        try {
            if (typeof window.ZuitchReelsServerLog === 'function') {
                window.ZuitchReelsServerLog('info', 'reel_nav_next', $next.length ? 'Ir a siguiente reel' : 'Sin siguiente; disparar prefetch', currentId || 0, {
                    hasNext: $next.length > 0,
                    skipPrefetch: !!skipPrefetch,
                    androidWebview: !!window.__woReelsAndroidWebview
                });
            }
        } catch (eN) {}

        if ($next.length) {
            window.__woReelsAnimating = true;
            window.woReelsHardPauseAll(null);
            $('.loading_reel').html('');

            woReelsRunSlideTransition('next', $current, $next, function () {
                window.__woReelsAnimating = false;
                playPauseVideos($next);
                window.history.pushState({}, "", $next.attr('data-reel-url'));
                if (!skipPrefetch) {
                    woReelsPrefetchNext();
                }
            });
        } else {
            $('.loading_reel').html('');
            if (!skipPrefetch) {
                woReelsPrefetchNext();
            }
        }
    }

    function Wo_PreviousReelVideo() {
        var currentId = parseInt($('.reels_list:not(.hidden)').data('id'), 10);
        if (window.__woReelsAnimating) {
            try {
                if (typeof window.ZuitchReelsServerLog === 'function') {
                    window.ZuitchReelsServerLog('warn', 'reel_prev_blocked_animating', 'Anterior ignorado: transición en curso', currentId || 0, { dir: 'prev' });
                }
            } catch (eB) {}
            return;
        }
        var $current = $(".reels_list[data-id='" + currentId + "']");
        var currentIndex = $current.index();
        var prevIndex = currentIndex > 0 ? currentIndex - 1 : 0;
        var $prev = $(".reels_list").eq(prevIndex);

        try {
            if (typeof window.ZuitchReelsServerLog === 'function') {
                window.ZuitchReelsServerLog('info', 'reel_nav_prev', (currentIndex > 0 && $prev.length) ? 'Ir a reel anterior' : 'Sin anterior', currentId || 0, {
                    currentIndex: currentIndex,
                    androidWebview: !!window.__woReelsAndroidWebview
                });
            }
        } catch (eP2) {}

        if (currentIndex > 0 && $prev.length) {
            window.__woReelsAnimating = true;
            window.woReelsHardPauseAll(null);
            $('.loading_reel').html('');

            woReelsRunSlideTransition('prev', $current, $prev, function () {
                window.__woReelsAnimating = false;
                playPauseVideos($prev);
                window.history.pushState({}, "", $prev.attr('data-reel-url'));
            });
        } else {
            $('.loading_reel').html('');
        }
    }

