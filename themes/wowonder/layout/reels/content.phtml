                    woReelsPrefetchNext();
                } else if (typeof window.woReelsWarmNeighbourBuffers === 'function') {
                    try { window.woReelsWarmNeighbourBuffers(); } catch (eW) {}
                }
            });
        } else {
            $('.loading_reel').html('');
            if (!skipPrefetch) {
                woReelsPrefetchNext();
            }
        }
    }

