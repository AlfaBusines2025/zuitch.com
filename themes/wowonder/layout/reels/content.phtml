            return;
        }
        if (!woReelsNavDebounceOk('next', currentId)) {
            return;
        }
        var $current = $(".reels_list[data-id='" + currentId + "']");
        var currentIndex = $(".reels_list").index($current);
        if (currentIndex < 0) {
            currentIndex = $current.index();
        }
        var reelCount = $(".reels_list").length;
        var $next = $(".reels_list").eq(currentIndex + 1);
        var skipDup = ($(".reels_list[data-id='" + currentId + "']").length > 2);
