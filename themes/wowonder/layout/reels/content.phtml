<?php if ($zuitch_reels_share_test_dock) { ?>
<div id="zuitch-reel-share-test-dock" class="zuitch-reel-share-test-dock" role="region" aria-label="Prueba compartir reels">
    <div class="zuitch-reel-share-test-dock-inner">
        <button type="button" id="zuitch-reel-share-test-btn" class="zuitch-reel-share-test-btn" title="Ejecuta la fase y avanza (1→6)">
            <i class="fa fa-share fa-solid fa-share" aria-hidden="true"></i>
            <span id="zuitch-reel-share-test-lbl" class="zuitch-reel-share-test-lbl">F1/6</span>
        </button>
        <pre id="zuitch-reel-share-test-out" class="zuitch-reel-share-test-out" aria-live="polite"></pre>
    </div>
</div>
<script>
(function () {
    var maxPhase = 6;
    var phase = 1;
    var lastAct = 0;
    function out(msg) {
        var el = document.getElementById('zuitch-reel-share-test-out');
        var line = '[' + new Date().toISOString().slice(11, 19) + '] ' + msg;
        if (el) {
            el.textContent = (el.textContent ? el.textContent + '\n' : '') + line;
            el.scrollTop = el.scrollHeight;
        }
        try {
            if (window.ZuitchReelsDebug) {
                window.ZuitchReelsDebug.log('reelShareTest', line);
            }
        } catch (e0) {}
    }
    function updateLbl() {
        var lbl = document.getElementById('zuitch-reel-share-test-lbl');
        if (lbl) {
            lbl.textContent = 'F' + phase + '/' + maxPhase;
        }
    }
    function findVisibleShareBtn() {
        var b = document.querySelector('.reels_list:not(.hidden) .reels-share-btn');
        return b || document.querySelector('.wo_reels_cont .reels-share-btn') || document.querySelector('.reels-share-btn');
    }
    /** Fase 1: el toque/click llega al botón */
    function zuitchReelShareTestPhase1() {
        try {
            if (navigator.vibrate) {
                navigator.vibrate(35);
            }
        } catch (v) {}
        out('F1 OK: el botón de prueba recibe el evento.');
        out('jQuery=' + (typeof window.jQuery !== 'undefined') + ' Wo_Ajax=' + (typeof window.Wo_Ajax_Requests_File === 'function'));
    }
    /** Fase 2: entorno WebView / APIs */
    function zuitchReelShareTestPhase2() {
        var ua = String(navigator.userAgent || '');
        out('F2 UA (80): ' + ua.slice(0, 80));
        out('F2 navigator.share=' + typeof navigator.share);
        out('F2 ZuitchOpenReelShareSheet=' + typeof window.ZuitchOpenReelShareSheet + ' SearchFor=' + typeof window.SearchFor);
        out('F2 __woReelsAndroidWebview=' + !!window.__woReelsAndroidWebview + ' __ZUITCH_ANDROID_WEBVIEW=' + (typeof window.__ZUITCH_ANDROID_WEBVIEW !== 'undefined' ? window.__ZUITCH_ANDROID_WEBVIEW : 'undef'));
        out('F2 ZuitchAppBridge=' + (typeof window.ZuitchAppBridge !== 'undefined' ? 'sí' : 'no'));
    }
    /** Fase 3: encontrar el mismo botón real Compartir del reel visible */
    function zuitchReelShareTestPhase3() {
        var b = findVisibleShareBtn();
        if (!b) {
            out('F3 ERROR: no hay .reels-share-btn en el DOM (¿aún no cargó el reel?)');
            return;
        }
        out('F3 OK: botón real encontrado. post-id=' + (b.getAttribute('data-post-id') || '?'));
        out('F3 data-share-url=' + String(b.getAttribute('data-share-url') || '').slice(0, 72));
    }
    /** Fase 4: Web Share API (menú nativo), sin modal web */
    function zuitchReelShareTestPhase4() {
        var b = findVisibleShareBtn();
        var u = (b && b.getAttribute('data-share-url')) ? String(b.getAttribute('data-share-url')) : (window.location.origin || '') + '/';
        if (typeof navigator.share !== 'function') {
            out('F4 SKIP: navigator.share no existe (normal en muchas apps). En WebView (; wv) F6/Intent está desactivado; usa Copiar o WhatsApp.');
            return;
        }
        out('F4 llamando navigator.share… url=' + u.slice(0, 60));
        navigator.share({ title: 'Prueba Zuitch reels', text: 'Prueba compartir', url: u })
            .then(function () {
                out('F4 OK: navigator.share terminó bien.');
            })
            .catch(function (err) {
                out('F4 catch: ' + (err && err.name) + ' — ' + (err && err.message));
            });
    }
    /** Fase 5: misma función que el botón real del rail */
    function zuitchReelShareTestPhase5() {
        var b = findVisibleShareBtn();
        if (!b) {
            out('F5 ERROR: no hay .reels-share-btn');
            return;
        }
        if (typeof window.ZuitchOpenReelShareSheet !== 'function') {
            out('F5 ERROR: ZuitchOpenReelShareSheet no es función (¿script.js no cargó?)');
            return;
        }
        try {
            window.ZuitchOpenReelShareSheet(b);
            out('F5 OK: ZuitchOpenReelShareSheet(btn) ejecutado sin throw.');
            setTimeout(function () {
                var m = document.getElementById('zuitch-reel-share-sheet');
                var fb = document.getElementById('zuitch-reel-share-fallback-ui');
                if (m) {
                    var r = m.getBoundingClientRect();
                    var cs = window.getComputedStyle(m);
                    out('F5+800ms: modal #zuitch-reel-share-sheet h=' + Math.round(r.height) + ' y=' + Math.round(r.top) + ' disp=' + cs.display + ' opac=' + cs.opacity + ' z=' + cs.zIndex);
                    return;
                }
                if (fb) {
                    var rf = fb.getBoundingClientRect();
                    out('F5+800ms: hoja fallback #zuitch-reel-share-fallback-ui h=' + Math.round(rf.height) + ' (script principal no definió la hoja Bootstrap).');
                    return;
                }
                out('F5+800ms: ni #zuitch-reel-share-sheet ni #zuitch-reel-share-fallback-ui en el DOM.');
            }, 800);
        } catch (err) {
            out('F5 THROW: ' + (err && err.message ? err.message : String(err)));
        }
    }
    /** Fase 6: Intent ACTION_SEND (mismo que botón Apps en la hoja) */
    function zuitchReelShareTestPhase6() {
        var b = findVisibleShareBtn();
        var u = (b && b.getAttribute('data-share-url')) ? String(b.getAttribute('data-share-url')) : location.href;
        var t = (b && b.getAttribute('data-share-title')) ? String(b.getAttribute('data-share-title')) : '';
        if (typeof window.zuitchTryAndroidSendPlainText !== 'function') {
            out('F6 ERROR: zuitchTryAndroidSendPlainText no existe (script.js).');
            return;
        }
        var ua6 = navigator.userAgent || '';
        if (/\bwv\b/i.test(ua6) || window.__woReelsAndroidWebview) {
            out('F6 SKIP: WebView (; wv) — no se usa intent: vía location (evita cuelgues). Copiar / WhatsApp sí.');
            return;
        }
        out('F6 intentando Intent SEND con texto…');
        var ok = window.zuitchTryAndroidSendPlainText((t ? t + '\n' : '') + u);
        out(ok ? 'F6 location.href=intent… (si no abre nada, el sistema bloquea intents).' : 'F6 no ejecutado (no Android o bloqueado).');
    }
    function runCurrentPhase() {
        out('——— Ejecutando fase ' + phase + ' ———');
        if (phase === 1) {
            zuitchReelShareTestPhase1();
        } else if (phase === 2) {
            zuitchReelShareTestPhase2();
        } else if (phase === 3) {
            zuitchReelShareTestPhase3();
        } else if (phase === 4) {
            zuitchReelShareTestPhase4();
        } else if (phase === 5) {
            zuitchReelShareTestPhase5();
        } else {
            zuitchReelShareTestPhase6();
        }
        phase = phase >= maxPhase ? 1 : phase + 1;
        updateLbl();
    }
    function onActivate(ev) {
        var now = Date.now();
        if (now - lastAct < 450) {
            return;
        }
        lastAct = now;
        if (ev && ev.type === 'touchend') {
            try {
                ev.preventDefault();
            } catch (pe) {}
        }
        runCurrentPhase();
    }
    function bind() {
        var btn = document.getElementById('zuitch-reel-share-test-btn');
        if (!btn) {
            return;
        }
        var touchConsumed = false;
        btn.addEventListener('touchend', function (e) {
            touchConsumed = true;
            onActivate(e);
            setTimeout(function () {
                touchConsumed = false;
            }, 480);
        }, { passive: false });
        btn.addEventListener('click', function (e) {
            if (touchConsumed) {
                return;
            }
            onActivate(e);
        });
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bind);
    } else {
        bind();
    }
    window.zuitchReelShareTestRunPhase = function (n) {
        var x = parseInt(n, 10);
        if (x >= 1 && x <= maxPhase) {
            phase = x;
            updateLbl();
            runCurrentPhase();
        }
    };
})();
</script>
<?php } ?>