            return true;
        }
        if (navigator.platform === 'MacIntel' && (navigator.maxTouchPoints || 0) > 1) {
            return true;
        }
        return false;
    }
    function woReelsComputeIosWebview() {
        if (!woReelsComputeIosClient()) {
            return false;
        }
        if (typeof window.__ZUITCH_IOS_WEBVIEW !== 'undefined') {
            return !!window.__ZUITCH_IOS_WEBVIEW;
        }
        var ua = navigator.userAgent || '';
