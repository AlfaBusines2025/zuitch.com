                } catch (e4) {}
            }, { passive: true, capture: true });
        }

        // Un solo desbloqueo de audio para toda la página /reels/ (evita N listeners y usa el reel visible).
        if (!window.__woReelsAudioUnlockBound) {
            window.__woReelsAudioUnlockBound = true;
            function woUnlockVisibleReelAudio() {
                try {
                    var vis = document.querySelector('.reels_list:not(.hidden)');
                    if (!vis) {
                        return;
                    }
                    var vid = vis.querySelector('video');
                    if (!vid || !vid._woPlyr) {
                        return;
                    }
                    var p = vid._woPlyr;
                    var media = p.media;
                    if (media) {
                        media.muted = false;
                        media.defaultMuted = false;
                        media.volume = 1;
                    }
                    if (typeof p.unmute === 'function') {
                        p.unmute();
                    }
                    if (typeof p.setVolume === 'function') {
                        p.setVolume(1);
                    }
                    if (typeof p.play === 'function') {
                        p.play().catch(function (err) {
                            if (err && err.name === 'AbortError') {
                                return;
                            }
                            if (window.ZuitchReelsDebug) {
                                window.ZuitchReelsDebug.warn('unlock audio: play() falló', err);
                            }
                        });
                    }
                } catch (e) {}
            }
            document.addEventListener('click', woUnlockVisibleReelAudio, { once: true, capture: true });
            document.addEventListener('touchstart', woUnlockVisibleReelAudio, { once: true, capture: true, passive: true });
            document.addEventListener('pointerdown', woUnlockVisibleReelAudio, { once: true, capture: true, passive: true });
        }

        // Rueda del ratón / trackpad: siguiente/anterior reel (antes solo funcionaba swipe táctil).
        if (!window.__woReelsWheelBound) {
            window.__woReelsWheelBound = true;
            var woReelsWheelLock = 0;
            document.addEventListener('wheel', function (e) {
                if (!e.target || !e.target.closest || !e.target.closest('.wo_reels_cont .story-img')) {
                    return;
                }
                var dy = e.deltaY;
                if (dy > -12 && dy < 12) {
                    return;
                }
                var now = Date.now();
                if (now - woReelsWheelLock < 420) {
                    return;
                }
                if (window.__woReelsAnimating) {
                    return;
                }
                woReelsWheelLock = now;
                e.preventDefault();
                if (dy > 0) {
                    Wo_NextReelVideo();
                } else {
                    Wo_PreviousReelVideo();
                }
