        }
        if (typeof window.woReelsWarmNeighbourBuffers === 'function') {
            window.woReelsWarmNeighbourBuffers();
        }
		window.history.pushState({}, "", "<?php echo $wo['page_url']; ?>");
        /* El play lo gestiona Plyr solo en el reel visible; evitar play() duplicado → AbortError */
        if (window.ZuitchReelsDebug) {
            window.ZuitchReelsDebug.log(
                'reels listo. Filtra por esta etiqueta. Opcional: __ZUITCH_REELS_DEBUG_VERBOSE=1 (más detalle), __ZUITCH_REELS_DEBUG_OFF=1 (silenciar)'
            );
        }

        try {
            var vis = document.querySelector('.reels_list:not(.hidden)');
            var startPid = vis && vis.getAttribute('data-id') ? parseInt(vis.getAttribute('data-id'), 10) : 0;
            if (typeof window.ZuitchReelsServerLog === 'function') {
                window.ZuitchReelsServerLog('info', 'reels_session_start', 'Página reels lista (cliente)', startPid, {
                    reelCount: document.querySelectorAll('.reels_list').length
                });
            }
        } catch (eS) {}

        if (!window.__woReelsServerErrorHooks) {
            window.__woReelsServerErrorHooks = true;
            window.addEventListener('error', function (ev) {
                try {
                    if (typeof window.ZuitchReelsServerLog !== 'function') {
                        return;
                    }
                    window.ZuitchReelsServerLog('error', 'window_onerror', String(ev.message || 'error'), 0, {
                        filename: ev.filename,
                        lineno: ev.lineno,
                        colno: ev.colno
                    });
                } catch (e2) {}
            });
            window.addEventListener('unhandledrejection', function (ev) {
                try {
                    if (typeof window.ZuitchReelsServerLog !== 'function') {
                        return;
                    }
                    var r = ev.reason;
                    window.ZuitchReelsServerLog('error', 'unhandledrejection', r && r.message ? String(r.message) : String(r), 0, {
                        name: r && r.name ? r.name : null
                    });
                } catch (e3) {}
            });
        }

        if (!window.__woReelsTouchProbeBound) {
            window.__woReelsTouchProbeBound = true;
            var lastTouchLog = 0;
            document.addEventListener('touchstart', function (e) {
                try {
                    if (!e.target || !e.target.closest) {
                        return;
                    }
                    if (!e.target.closest('.wo_reels_cont .story-img')) {
                        return;
                    }
                    var now = Date.now();
                    if (now - lastTouchLog < 12000) {
                        return;
                    }
                    lastTouchLog = now;
                    var vis = document.querySelector('.reels_list:not(.hidden)');
                    var pid = vis && vis.getAttribute('data-id') ? parseInt(vis.getAttribute('data-id'), 10) : 0;
                    if (typeof window.ZuitchReelsServerLog === 'function') {
                        window.ZuitchReelsServerLog('info', 'reels_touch_story_area', 'touchstart en zona video reel', pid, {
                            targetTag: e.target.tagName,
                            animating: !!window.__woReelsAnimating
                        });
