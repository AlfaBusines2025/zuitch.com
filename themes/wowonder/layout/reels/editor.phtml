            e.preventDefault();
            e.stopPropagation();
            reelAudioTopStartDragging = true;
            applyReelAudioStartFromTopTrackClientX(reelAudioPointerX(e));
        });
        reelAudioTopHandleStart.addEventListener('touchstart', function (e) {
            if (!reelAudioPeaks || reelAudioFileDurationSec <= 0) return;
            e.preventDefault();
