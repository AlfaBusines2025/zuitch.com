    function formatTime(seconds) {
        var mins = Math.floor(seconds / 60);
        var secs = Math.floor(seconds % 60);
        return mins + ':' + (secs < 10 ? '0' : '') + secs;
    }

    /** Marco 9:16 centrado en el área negra (misma proporción que 1080×1920). */
    function layoutReelEditStage() {
        var wrap = document.querySelector('.wo_reels_video_fullscreen');
        if (!wrap || !reelEditStage) return;
        var W = wrap.clientWidth;
        var H = wrap.clientHeight;
        if (W <= 0 || H <= 0) return;
        var ar = 9 / 16;
        var h = H;
        var w = Math.round(h * ar);
        if (w > W) {
            w = W;
            h = Math.round(w / ar);
        }
        reelEditStage.style.width = w + 'px';
        reelEditStage.style.height = h + 'px';
        $('#reel_stage_w').val(String(w));
        $('#reel_stage_h').val(String(h));
    }

    function onReelEditResize() {
        layoutReelEditStage();
        updateCanvasSize();
        if (textPanel.length && textPanel.is(':visible')) {
            applyReelTextEditorPreview();
        }
        if (reelAudioPeaks && reelAudioPanel.length && reelAudioPanel.is(':visible')) {
            drawReelAudioWaveform();
        }
    }

    function updateCanvasSize() {
        if (textCanvas && reelEditStage) {
            textCanvas.width = reelEditStage.clientWidth;
            textCanvas.height = reelEditStage.clientHeight;
            drawTextOverlay();
        }
    }

    /** Rectángulo redondeado (fondo / borde alineado con la previsualización del estudio). */
    function reelCanvasRoundRectPath(ctx, x, y, w, h, r) {
        if (w <= 0 || h <= 0) return;
        r = Math.min(Math.max(0, r), w / 2, h / 2);
        ctx.beginPath();
        ctx.moveTo(x + r, y);
        ctx.arcTo(x + w, y, x + w, y + h, r);
        ctx.arcTo(x + w, y + h, x, y + h, r);
        ctx.arcTo(x, y + h, x, y, r);
        ctx.arcTo(x, y, x + w, y, r);
        ctx.closePath();
    }

    function drawTextOverlay() {
        if (!textCtx || !textCanvas) return;
        textCtx.clearRect(0, 0, textCanvas.width, textCanvas.height);
        overlayBoundsList = [];
        if (!hasReelTextLayers() || textCanvas.width <= 0 || textCanvas.height <= 0) {
            syncReelTextHiddenFields();
            updateTrashZoneVisibility();
            applyReelTextDragAreaPointerState();
            return;
        }
        var sw = textCanvas.width;
        var sh = textCanvas.height;
        var baseFs = Math.max(24, Math.min(sw / 15, sh / 10));
        textCtx.textBaseline = 'middle';
        textOverlays.forEach(function (ov) {
            if (!ov.text || String(ov.text).trim() === '') return;
            ensureOverlayFields(ov);
            var fontSize = baseFs * ov.fontScale;
            var face = REEL_FONT_CANVAS[ov.font] || REEL_FONT_CANVAS.meme;
            var italicPart = ov.italic ? 'italic ' : '';
            var weightPart = ov.font === 'direction' ? '900 ' : 'bold ';
            textCtx.font = italicPart + weightPart + fontSize + 'px ' + face;
            var align = ov.align || 'center';
            textCtx.textAlign = align === 'left' ? 'left' : (align === 'right' ? 'right' : 'center');
            var x = (ov.x / 100) * sw;
            var y = (ov.y / 100) * sh;
            var txt = String(ov.text).trim();
            if (ov.font === 'direction') {
                txt = txt.toUpperCase();
            }
            var textW = textCtx.measureText(txt).width;
            var pad = Math.max(8, fontSize * 0.18);
            var halfH = fontSize / 2 + pad * 0.35;
            var bx0 = align === 'left' ? x - pad : (align === 'right' ? x - textW - pad : x - textW / 2 - pad);
            var bx1 = bx0 + textW + pad * 2;
            var by0 = y - halfH;
            var by1 = y + halfH;
            var boxW = bx1 - bx0;
            var boxH = by1 - by0;
            var boxR = Math.min(Math.max(6, fontSize * 0.28), boxW * 0.22, boxH * 0.45, 18);
            var st = reelCanvasStyleForBoxMode(ov.boxMode, ov.color || '#ffffff');
            if (st.drawBg && st.bg) {
                textCtx.save();
                textCtx.fillStyle = st.bg;
                reelCanvasRoundRectPath(textCtx, bx0, by0, boxW, boxH, boxR);
                textCtx.fill();
                textCtx.restore();
                if (st.boxBorder) {
                    textCtx.save();
                    textCtx.strokeStyle = st.boxBorder;
                    var bLw = Math.max(1, fontSize / 24);
                    textCtx.lineWidth = bLw;
                    var inset = bLw / 2;
                    var ir = Math.max(2, boxR - inset * 0.85);
                    reelCanvasRoundRectPath(textCtx, bx0 + inset, by0 + inset, boxW - bLw, boxH - bLw, ir);
                    textCtx.stroke();
                    textCtx.restore();
                }
            }
            textCtx.fillStyle = st.fill;
            textCtx.fillText(txt, x, y);
            overlayBoundsList.push({
                id: ov.id,
                left: bx0,
                right: bx1,
                top: by0,
                bottom: by1
            });
            if (selectedOverlayId === ov.id) {
                textCtx.save();
                textCtx.strokeStyle = 'rgba(66,165,245,0.95)';
                textCtx.lineWidth = 2;
                var selPad = 4;
                var sW = boxW + selPad * 2;
                var sH = boxH + selPad * 2;
                var sR = Math.min(boxR + selPad * 0.5, sW / 2, sH / 2);
                reelCanvasRoundRectPath(textCtx, bx0 - selPad, by0 - selPad, sW, sH, sR);
                textCtx.stroke();
                textCtx.restore();
            }
        });
        syncReelTextHiddenFields();
        updateTrashZoneVisibility();
        applyReelTextDragAreaPointerState();
    }

    function enableGoToEdit() {
        goToEditBtn.prop('disabled', false);
    }

    function disableGoToEdit() {
        goToEditBtn.prop('disabled', true);
    }

    function goToEdit() {
        $step1.hide();
        $step2.show();
        if (previewVideo) {
            previewVideo.controls = false;
            previewVideo.removeAttribute('controls');
            previewVideo.disablePictureInPicture = true;
            previewVideo.setAttribute('disableremoteplayback', 'disableremoteplayback');
            previewVideo.setAttribute('controlsList', 'nodownload noplaybackrate noremoteplayback nofullscreen');
            previewVideo.load();
        }
        setTimeout(function() {
            layoutReelEditStage();
            updateCanvasSize();
            if (videoDuration > 0) {
                updateTimeline();
            }
            drawTextOverlay();
            if (window.reelEditorOpenTagAfterEdit) {
                window.reelEditorOpenTagAfterEdit = false;
                setTimeout(function () {
                    openReelTagPanel();
                }, 250);
            }
        }, 300);
        $(window).off('resize', onReelEditResize).on('resize', onReelEditResize);
