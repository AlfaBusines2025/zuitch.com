    // Descargar preview del video editado (recorte + texto + audio)
    downloadBtn.on('click', function() {
        if (!recordedBlob && !uploadedFile) {
            $status.removeClass('alert-success').addClass('alert alert-danger').html('Primero graba o sube un video.');
            return;
        }

        if (videoDuration > 0) {
            updateTimeline();
            var ts = parseFloat(trimStartInput.val());
            var te = parseFloat(trimEndInput.val());
            if (!(te > ts)) {
                trimEndInput.val(Number(videoDuration).toFixed(3));
                updateTimeline();
            }
        }

        syncReelTextHiddenFields();
        syncReelTagsHidden();
        var formData = new FormData($form[0]);
        if (recordedBlob) {
            formData.delete('postVideo');
            formData.append('postVideo', recordedBlob, 'reel-recorded.webm');
        } else if (uploadedFile) {
            formData.delete('postVideo');
            formData.append('postVideo', uploadedFile, uploadedFile.name);
        }
        if (audioInput && audioInput[0] && audioInput[0].files && audioInput[0].files[0]) {
            formData.delete('reel_audio');
            formData.append('reel_audio', audioInput[0].files[0], audioInput[0].files[0].name);
        }
        // Activar modo debug del endpoint para identificar el punto exacto de falla.
        formData.append('reel_debug', '1');

        var $btn = $(this);
        var originalHtml = $btn.html();
        $btn.prop('disabled', true).html('<span style="font-size:12px;">...</span>');
        $status.removeClass('alert-success alert-danger').addClass('alert alert-success').html('Generando video...');

        $.ajax({
            url: Wo_Ajax_Requests_File() + '?f=posts&s=download_reel_preview',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            dataType: 'json',
            timeout: 120000
        }).done(function(data) {
            $btn.prop('disabled', false).html(originalHtml);
            if (data && data.debug) {
                console.log('[REEL DOWNLOAD DEBUG]', data.debug);
                if (data.debug.render) {
                    var r = data.debug.render;
                    console.log('[REEL EMOJI EXPORT]', {
                        uses_filter_complex: r.uses_filter_complex,
                        vf_has_filter_complex_string: r.reel_vf_has_filter_complex,
                        twemoji_dir: r.twemoji_dir,
                        twemoji_ready: r.twemoji_ready,
                        gd_for_reel_png: r.gd_for_reel_png,
                        emoji_path_diag: r.reel_emoji_path || null,
                        items_count: r.reel_items_count,
                        texts_json_bytes: r.reel_texts_json_bytes,
                        json_decode_error: r.reel_json_decode_error || null,
                        ffmpeg_cmd_head: r.cmd ? String(r.cmd).slice(0, 400) : ''
                    });
                    if (r.reel_emoji_path && r.reel_emoji_path.has_emoji_only_layer && !r.uses_filter_complex) {
                        console.warn('[REEL EMOJI] Capa solo-emoji detectada pero NO se usó filter_complex+Twemoji; revisa first_is_emoji_only y ffmpeg.');
                    }
                    if (r.reel_emoji_path && !r.reel_emoji_path.has_emoji_only_layer && r.reel_emoji_path.first_contains_emoji) {
                        console.warn('[REEL EMOJI] Hay emoji mezclado con texto u otro carácter: el export usa ASS/subtitles (Noto vía libass), no Twemoji PNG.');
                    }
                }
            }
            if (data.status == 200 && data.url) {
                // Descargar como blob para forzar download en navegadores móviles/desktop.
                fetch(data.url, { credentials: 'same-origin' }).then(function(resp) {
                    if (!resp.ok) throw new Error('No se pudo obtener el archivo generado.');
                    return resp.blob();
                }).then(function(blob) {
                    var blobUrl = window.URL.createObjectURL(blob);
                    var link = document.createElement('a');
                    link.href = blobUrl;
                    link.download = data.filename || 'reel-preview.mp4';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    setTimeout(function() {
                        window.URL.revokeObjectURL(blobUrl);
                    }, 1500);
                    $status.removeClass('alert-danger').addClass('alert alert-success').html('Video generado. Descarga iniciada.');
                }).catch(function(err) {
                    // Fallback final: navegación directa al archivo.
                    window.location.href = data.url;
                    $status.removeClass('alert-success').addClass('alert alert-danger').html('No se pudo forzar la descarga automática, abriendo archivo directo...');
                    console.log(err);
                });
            } else {
                var errMsg = (data.errors || '<?php echo $wo['lang']['error_please_try_again']; ?>');
                if (data && data.debug && data.debug.stage) {
                    errMsg += '<br><small>Debug stage: ' + data.debug.stage + '</small>';
                }
                $status.removeClass('alert-success').addClass('alert alert-danger').html(errMsg);
            }
        }).fail(function(xhr) {
            $btn.prop('disabled', false).html(originalHtml);
            var err = '<?php echo $wo['lang']['error_please_try_again']; ?>';
            if (xhr && xhr.responseJSON && xhr.responseJSON.errors) {
                err = xhr.responseJSON.errors;
                if (xhr.responseJSON.debug) {
                    console.log('[REEL DOWNLOAD DEBUG FAIL]', xhr.responseJSON.debug);
                    if (xhr.responseJSON.debug.stage) {
                        err += '<br><small>Debug stage: ' + xhr.responseJSON.debug.stage + '</small>';
                    }
                }
            } else if (xhr && xhr.responseText) {
                err = xhr.responseText.substring(0, 250);
            }
            $status.removeClass('alert-success').addClass('alert alert-danger').html(err);
        });
    });

    function getReelPlaybackVideo() {
        if (reelAudioPanel.length && reelAudioPanel.is(':visible') && reelAudioPanelVideo && previewVideo && (previewVideo.src || previewVideo.currentSrc)) {
            return reelAudioPanelVideo;
        }
        return previewVideo;
    }

    function updateReelPlayIconsAll(playing) {
        if (playing) {
            $('#play_icon_overlay').hide();
            $('#pause_icon_overlay').show();
            $('#reel_audio_panel_play_icon').hide();
            $('#reel_audio_panel_pause_icon').show();
        } else {
            $('#play_icon_overlay').show();
            $('#pause_icon_overlay').hide();
            $('#reel_audio_panel_play_icon').show();
            $('#reel_audio_panel_pause_icon').hide();
        }
    }

    function pauseReelPlaybackFully() {
        if (previewVideo) previewVideo.pause();
        if (reelAudioPanelVideo) reelAudioPanelVideo.pause();
        if (audioElement) audioElement.pause();
        isPlaying = false;
        updateReelPlayIconsAll(false);
    }

    function setupReelAudioPanelVideo() {
        if (!reelAudioPanelVideo || !previewVideo) return;
        var url = previewVideo.currentSrc || previewVideo.src || '';
        if (!url) return;
        previewVideo.pause();
        var syncTime = previewVideo.currentTime;
        var applySync = function () {
            try {
                reelAudioPanelVideo.currentTime = syncTime;
            } catch (e) {}
            reelAudioPanelVideo.muted = isMuted;
            reelAudioPanelVideo.volume = Math.min(1, Math.max(0, reelVideoVol));
        };
        var curPanel = reelAudioPanelVideo.currentSrc || reelAudioPanelVideo.src || '';
        if (curPanel !== url) {
            var onMeta = function () {
                reelAudioPanelVideo.removeEventListener('loadedmetadata', onMeta);
                applySync();
            };
            reelAudioPanelVideo.addEventListener('loadedmetadata', onMeta);
            reelAudioPanelVideo.src = url;
            reelAudioPanelVideo.load();
        } else {
            applySync();
        }
    }

    function toggleReelPlayback() {
        var v = getReelPlaybackVideo();
        if (!v) return;
        if (isPlaying) {
            pauseReelPlaybackFully();
            return;
        }
        syncAudioWithVideo(v.currentTime <= (getTrimStartTime() + 0.05));
        v.play().catch(function () {});
        if (audioElement) {
            audioElement.play().catch(function (err) {
                console.log('Error al reproducir audio:', err);
            });
        }
        isPlaying = true;
        updateReelPlayIconsAll(true);
    }

    function updateReelAudioPanelTimeLabel(activeVideo) {
        if (!activeVideo || videoDuration <= 0) return;
        var endTrim = (trimEndPercent / 100) * videoDuration;
        $('#reel_audio_panel_time').text(formatTime(activeVideo.currentTime) + ' / ' + formatTime(endTrim));
    }

    function processReelVideoTimeupdate(activeVideo) {
        if (!activeVideo || activeVideo !== getReelPlaybackVideo()) return;
        if (!isDraggingStart && !isDraggingEnd && videoDuration > 0) {
            var startTime = (trimStartPercent / 100) * videoDuration;
            var endTime = (trimEndPercent / 100) * videoDuration;
            if (activeVideo.currentTime < startTime) {
                activeVideo.currentTime = startTime;
            } else if (activeVideo.currentTime > endTime) {
                activeVideo.currentTime = endTime;
                if (isPlaying) {
                    pauseReelPlaybackFully();
                }
            }
            if (audioElement && isPlaying) {
                syncAudioWithVideo(false);
            }
            currentTimeSpan.text(formatTime(activeVideo.currentTime));
            updateReelAudioPanelTimeLabel(activeVideo);
        }
        if (hasReelTextLayers()) {
            drawTextOverlay();
        }
    }

