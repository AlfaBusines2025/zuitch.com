    function applyReelAudioStartFromTopTrackClientX(clientX) {
        if (!reelAudioPeaks || reelAudioFileDurationSec <= 0) return;
        var track = document.querySelector('#reel_audio_panel .reel-audio-top-track');
        if (!track) return;
        var r = track.getBoundingClientRect();
        if (r.width <= 0) return;
        var ratio = (clientX - r.left) / r.width;
        ratio = Math.max(0, Math.min(1, ratio));
        var segLen = getReelEffectiveAudioSegLen();
        var maxStart = Math.max(0, reelAudioFileDurationSec - segLen);
        reelAudioSegStartSec = Math.max(0, Math.min(maxStart, ratio * reelAudioFileDurationSec));
        syncReelAudioHiddenFields();
        drawReelAudioWaveform();
        updateReelAudioPanelChrome();
