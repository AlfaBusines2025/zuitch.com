    function updateTimeline() {
        if (!trimTrack || !trimSelection || !trimStartHandle || !trimEndHandle || videoDuration <= 0) return;
        var trackWidth = trimTrack[0] ? trimTrack[0].offsetWidth : 0;
        if (trackWidth <= 0) {
            setTimeout(updateTimeline, 100);
            return;
        }
        var startPos = (trimStartPercent / 100) * trackWidth;
        var endPos = (trimEndPercent / 100) * trackWidth;
        trimStartHandle.css('left', (startPos - 10) + 'px');
        trimEndHandle.css('right', (100 - trimEndPercent) + '%');
        trimSelection.css({
            left: startPos + 'px',
            width: (endPos - startPos) + 'px'
        });
        var startTime = (trimStartPercent / 100) * videoDuration;
        var endTime = (trimEndPercent / 100) * videoDuration;
        trimStartInput.val(startTime.toFixed(3));
        trimEndInput.val(endTime.toFixed(3));
        trimStartDisplay.text(startTime.toFixed(1) + 's');
        trimEndDisplay.text(endTime.toFixed(1) + 's');

        if (reelAudioPeaks && reelAudioPeaks.length) {
            reelClampAudioSegmentToTrim();
        }
        
        // Limitar el video al rango seleccionado (principal y panel de audio si está abierto)
        if (previewVideo) {
            if (previewVideo.currentTime < startTime) {
                previewVideo.currentTime = startTime;
            } else if (previewVideo.currentTime > endTime) {
                previewVideo.currentTime = endTime;
            }
        }
        if (reelAudioPanelVideo && reelAudioPanel.length && reelAudioPanel.is(':visible') && (reelAudioPanelVideo.src || reelAudioPanelVideo.currentSrc)) {
            if (reelAudioPanelVideo.currentTime < startTime) {
                reelAudioPanelVideo.currentTime = startTime;
            } else if (reelAudioPanelVideo.currentTime > endTime) {
                reelAudioPanelVideo.currentTime = endTime;
            }
        }
    }

    function generateTimelineThumbs() {
        if (!trimPreview || !previewVideo || videoDuration <= 0) return;
        trimPreview.empty();
        var thumbCount = Math.min(20, Math.floor(videoDuration));
        if (thumbCount <= 0) return;
        var thumbWidth = 100 / thumbCount;
        for (var i = 0; i < thumbCount; i++) {
            var thumb = $('<div>').css({
                width: thumbWidth + '%',
                height: '100%',
                display: 'inline-block',
                background: '#ccc',
                border: '1px solid #999',
                position: 'relative'
            });
            trimPreview.append(thumb);
        }
    }

    var currentFacingMode = 'user'; // 'user' = frontal, 'environment' = posterior
    var audioElement = null;

    // Función para iniciar la cámara
    function startCamera(facingMode) {
        if (mediaStream) {
            mediaStream.getTracks().forEach(function(track) {
                track.stop();
            });
        }
        
        var constraints = {
            video: { facingMode: facingMode },
            audio: true
        };
        
        if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
            navigator.mediaDevices.getUserMedia(constraints).then(function (stream) {
                mediaStream = stream;
                if ('srcObject' in cameraVideo) {
                    cameraVideo.srcObject = stream;
                } else {
                    cameraVideo.src = window.URL.createObjectURL(stream);
                }
                cameraVideo.play();
            }).catch(function (err) {
                console.log('No se pudo acceder a la cámara:', err);
                // Intentar con la otra cámara si falla
                if (facingMode === 'user') {
                    startCamera('environment');
                } else {
                    startCamera('user');
                }
            });
        }
    }

