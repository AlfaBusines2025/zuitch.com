    }

    $(document).on('mousemove.reelAud touchmove.reelAud', function (e) {
        var ox = e.originalEvent || e;
        if (reelAudioTopStartDragging && reelAudioPeaks && reelAudioFileDurationSec > 0) {
            if (ox.preventDefault) ox.preventDefault();
            applyReelAudioStartFromTopTrackClientX(reelAudioPointerX(ox));
            return;
        }
        if (!reelAudioDragging || !reelAudioPeaks || reelAudioFileDurationSec <= 0) return;
        var cx = reelAudioPointerX(ox);
        var dx = cx - reelAudioLastPointerX;
        reelAudioLastPointerX = cx;
        var r = reelAudioCanvas.getBoundingClientRect();
        if (r.width <= 0) return;
        var deltaSec = (dx / r.width) * reelAudioFileDurationSec;
        reelAudioSegStartSec -= deltaSec;
        var segLen = getReelEffectiveAudioSegLen();
        var maxStart = Math.max(0, reelAudioFileDurationSec - segLen);
        reelAudioSegStartSec = Math.max(0, Math.min(maxStart, reelAudioSegStartSec));
        syncReelAudioHiddenFields();
        drawReelAudioWaveform();
        updateReelAudioPanelChrome();
