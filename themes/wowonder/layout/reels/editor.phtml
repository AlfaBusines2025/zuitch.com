    function reelTagTouchDistance(touches) {
        if (!touches || touches.length < 2) return 0;
        var a = touches[0], b = touches[1];
        var dx = a.clientX - b.clientX, dy = a.clientY - b.clientY;
        return Math.sqrt(dx * dx + dy * dy) || 1;
    }
    function getReelTagScaleByUid(uid) {
        var t = reelTagItems.filter(function (x) { return x._uid === uid; })[0];
        var s = t && typeof t.scale === 'number' ? t.scale : 1;
        return Math.max(0.45, Math.min(3.5, s));
    }
    function setReelTagChipTransform(chip, scale) {
        if (!chip) return;
        var s = Math.max(0.45, Math.min(3.5, scale));
        chip.style.transform = 'translate(-50%, -50%) scale(' + s + ')';
    }

    function reelEditorHexToRgb(hex) {
        hex = String(hex || '#ffffff').replace(/^#/, '');
        if (hex.length === 3) {
            hex = hex[0] + hex[0] + hex[1] + hex[1] + hex[2] + hex[2];
        }
        if (hex.length !== 6) return { r: 255, g: 255, b: 255 };
        var r = parseInt(hex.slice(0, 2), 16);
        var g = parseInt(hex.slice(2, 4), 16);
        var b = parseInt(hex.slice(4, 6), 16);
        if (isNaN(r) || isNaN(g) || isNaN(b)) return { r: 255, g: 255, b: 255 };
        return { r: r, g: g, b: b };
    }

    function reelHexToRgbaString(hex, alpha) {
        var rgb = reelEditorHexToRgb(hex);
        return 'rgba(' + rgb.r + ',' + rgb.g + ',' + rgb.b + ',' + alpha + ')';
    }

    function reelCanvasStyleForBoxMode(mode, userHex) {
        var u = userHex || '#ffffff';
        mode = mode == null ? 0 : parseInt(mode, 10);
        if (isNaN(mode)) mode = 0;
        switch (mode) {
            case 1:
                return { drawBg: true, bg: 'rgba(0,0,0,0.78)', fill: u, stroke: '#000000', lwMul: 1, boxBorder: 'rgba(255,255,255,0.45)' };
            case 2:
                return { drawBg: true, bg: reelHexToRgbaString(u, 0.88), fill: '#000000', stroke: '#333333', lwMul: 0.65, boxBorder: 'rgba(0,0,0,0.42)' };
            case 3:
                return { drawBg: true, bg: 'rgba(255,255,255,0.92)', fill: u, stroke: '#000000', lwMul: 1, boxBorder: 'rgba(0,0,0,0.28)' };
            case 4:
                return { drawBg: true, bg: reelHexToRgbaString(u, 0.88), fill: '#ffffff', stroke: 'rgba(255,255,255,0.35)', lwMul: 0.55, boxBorder: 'rgba(255,255,255,0.58)' };
            default:
                return { drawBg: false, bg: null, fill: u, stroke: '#000000', lwMul: 1, boxBorder: null };
        }
    }

    function insertTextIntoReelEditor(chunk) {
        if (!textEditorInput.length || chunk === undefined || chunk === null) return;
        chunk = String(chunk);
        if (!chunk) return;
        var el = textEditorInput[0];
        var maxLen = parseInt(el.getAttribute('maxlength'), 10) || 200;
        var val = textEditorInput.val();
        var start = typeof el.selectionStart === 'number' ? el.selectionStart : val.length;
        var end = typeof el.selectionEnd === 'number' ? el.selectionEnd : val.length;
        var before = val.slice(0, start);
        var after = val.slice(end);
        var room = maxLen - before.length - after.length;
        if (room <= 0) return;
        if (chunk.length > room) chunk = chunk.slice(0, room);
        var combined = before + chunk + after;
        textEditorInput.val(combined);
        var newPos = start + chunk.length;
        try {
            el.setSelectionRange(newPos, newPos);
        } catch (err) {}
        el.focus();
        sizeReelTextEditorToContent();
    }

    function buildReelEmojiGridOnce() {
        if (!reelEmojiPopover.length || reelEmojiPopover.data('reelEmojiBuilt')) return;
        var grid = $('<div>').css({
            display: 'grid',
            gridTemplateColumns: 'repeat(8, minmax(0, 1fr))',
            gap: '4px'
        });
        if (!REEL_EMOJI_LIST || !REEL_EMOJI_LIST.length) {
            grid.append($('<div>').css({ gridColumn: '1 / -1', color: '#aaa', fontSize: '13px', padding: '6px 4px' }).text('<?php echo htmlspecialchars($wo['lang']['no_emojis_available'] ?? 'No hay emojis disponibles para exportar.', ENT_QUOTES, 'UTF-8'); ?>'));
            reelEmojiPopover.append(grid);
            reelEmojiPopover.data('reelEmojiBuilt', 1);
            return;
        }
        REEL_EMOJI_LIST.forEach(function (emo) {
            $('<button type="button">')
                .attr('aria-label', 'emoji')
                .text(emo)
                .css({
                    fontSize: '22px',
                    lineHeight: '1.2',
                    padding: '6px 4px',
                    border: 'none',
                    borderRadius: '6px',
                    background: 'transparent',
                    cursor: 'pointer',
                    color: '#fff'
                })
                .on('mouseenter', function () {
                    $(this).css('background', 'rgba(255,255,255,0.12)');
                })
                .on('mouseleave', function () {
                    $(this).css('background', 'transparent');
                })
                .on('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    insertTextIntoReelEditor(emo);
                })
                .appendTo(grid);
        });
        reelEmojiPopover.append(grid);
        reelEmojiPopover.data('reelEmojiBuilt', 1);
    }

    /** Misma base que drawTextOverlay: max(24, min(sw/15, sh/10)). */
    function reelCanvasBaseFontPx() {
        var sw = 0;
        var sh = 0;
        if (textCanvas && textCanvas.width > 0 && textCanvas.height > 0) {
            sw = textCanvas.width;
            sh = textCanvas.height;
        } else if (reelEditStage && reelEditStage.clientWidth > 0 && reelEditStage.clientHeight > 0) {
            sw = reelEditStage.clientWidth;
            sh = reelEditStage.clientHeight;
        }
        if (sw <= 0 || sh <= 0) {
            return 46;
        }
        return Math.max(24, Math.min(sw / 15, sh / 10));
    }

    function reelEditStageWidthPx() {
        if (textCanvas && textCanvas.width > 0) {
            return textCanvas.width;
        }
        if (reelEditStage && reelEditStage.clientWidth > 0) {
            return reelEditStage.clientWidth;
        }
        return 360;
    }

    /**
     * Tamaño en px del input del estudio, proporcional al canvas del reel (mismo ratio texto/marco que la previsualización).
     */
    function getReelTextStudioPreviewFontPx(scale) {
        var baseFs = reelCanvasBaseFontPx();
        var stageW = reelEditStageWidthPx();
        var host = (textEditorWrap.length && textEditorWrap[0].parentElement) ? textEditorWrap[0].parentElement : null;
        var studioW = (host && host.clientWidth > 0) ? host.clientWidth : Math.min(Math.floor(window.innerWidth * 0.92), 520);
        var ratio = studioW / stageW;
        ratio = Math.max(0.5, Math.min(2.5, ratio));
        var px = baseFs * scale * ratio;
        return Math.max(10, Math.round(px));
    }

    /** Misma apariencia que el canvas: color de relleno según boxMode, fondo/caja y sin contorno. */
    function applyReelTextEditorPreview() {
        if (!textEditorInput.length) return;
        var ov = getSelectedOverlay();
        var scale = 1;
        var ta = 'center';
        var italicCss = 'normal';
        var userHex = (reelTextColor.length && reelTextColor.val()) ? reelTextColor.val() : '#ffffff';
        if (userHex.charAt(0) !== '#') userHex = '#ffffff';
        var bm = 0;
        if (ov) {
            ensureOverlayFields(ov);
            scale = ov.fontScale;
            ta = ov.align === 'left' ? 'left' : (ov.align === 'right' ? 'right' : 'center');
            italicCss = ov.italic ? 'italic' : 'normal';
            bm = ov.boxMode;
            if (ov.color && String(ov.color).charAt(0) === '#') {
                userHex = ov.color;
            }
        }
        var st = reelCanvasStyleForBoxMode(bm, userHex);
        var fontKey = (reelTextFont.length && reelTextFont.val()) ? reelTextFont.val() : 'meme';
        var family = REEL_FONT_CANVAS[fontKey] || REEL_FONT_CANVAS.meme;
        var px = getReelTextStudioPreviewFontPx(scale);
        var phRgb = reelEditorHexToRgb(st.fill);
        var ph = 'rgba(' + phRgb.r + ',' + phRgb.g + ',' + phRgb.b + ',0.45)';
        if (textEditorWrap.length) {
            if (st.drawBg && st.boxBorder) {
                textEditorWrap.css({
                    backgroundColor: st.bg,
                    borderRadius: '12px',
                    padding: '8px 12px',
                    border: '1px solid ' + st.boxBorder,
                    boxSizing: 'border-box',
                    textAlign: ta
                });
            } else {
                textEditorWrap.css({
                    backgroundColor: 'transparent',
                    borderRadius: '0',
                    padding: '0',
                    border: 'none',
                    textAlign: ta
                });
            }
        }
        textEditorInput.css({
            color: st.fill,
            backgroundColor: 'transparent',
            borderRadius: '0',
            padding: '0',
            fontFamily: family,
            fontWeight: '700',
            fontStyle: italicCss,
            fontSize: px + 'px',
            textAlign: ta,
            textShadow: 'none',
            WebkitTextStroke: '0 transparent',
            filter: 'none',
            display: 'block',
            verticalAlign: 'middle',
            boxSizing: 'border-box',
            width: '100%',
            maxWidth: '100%',
            minWidth: '0',
            overflowX: 'auto',
            overflowY: 'hidden',
            whiteSpace: 'nowrap'
        });
        var sid = 'reel-text-editor-placeholder-dyn';
        $('#' + sid).remove();
        $('head').append(
            '<style id="' + sid + '">#reel_text_editor::placeholder{color:' + ph + ';opacity:1;}#reel_text_editor::-webkit-input-placeholder{color:' + ph + ';opacity:1;}#reel_text_editor::-moz-placeholder{color:' + ph + ';opacity:1;}</style>'
        );
        requestAnimationFrame(function () {
            sizeReelTextEditorToContent();
        });
    }

    function sizeReelTextEditorToContent() {
        if (!textEditorInput.length) return;
        var el = textEditorInput[0];
        el.style.width = '100%';
        el.style.maxWidth = '100%';
        el.style.minWidth = '0';
        el.style.boxSizing = 'border-box';
        el.style.overflowX = 'auto';
        el.style.overflowY = 'hidden';
        el.style.whiteSpace = 'nowrap';
    }

    function genReelTextId() {
        return 'rt_' + Date.now() + '_' + Math.floor(Math.random() * 10000);
    }

    function ensureOverlayFields(o) {
        if (!o) return o;
        if (o.fontScale == null || isNaN(o.fontScale)) o.fontScale = 1;
        o.fontScale = Math.max(REEL_SCALE_MIN, Math.min(REEL_SCALE_MAX, Number(o.fontScale)));
        o.italic = !!o.italic;
        if (!o.align || ['left', 'center', 'right'].indexOf(o.align) < 0) o.align = 'center';
        if (o.boxMode == null || isNaN(o.boxMode)) {
            if (o.box === false) o.boxMode = 0;
            else if (o.box === true) o.boxMode = 1;
            else o.boxMode = 0;
        }
        o.boxMode = Math.max(0, Math.min(4, parseInt(o.boxMode, 10)));
        if (!o.font) o.font = 'meme';
        return o;
    }

    function updateFontCarouselUI() {
        var cur = reelTextFont.val() || 'meme';
        $('.reel-font-pill').each(function () {
            var f = $(this).attr('data-font');
            var on = f === cur;
            $(this).css({
                background: on ? '#ffffff' : '#1a1a1a',
                color: on ? '#000000' : '#ffffff',
                borderColor: on ? '#ffffff' : '#444444'
            });
        });
    }

    function updateToolbarForSelection() {
        var ov = getSelectedOverlay();
        if (!ov) return;
        ensureOverlayFields(ov);
        if (reelTbItalic.length) reelTbItalic.css('background', ov.italic ? '#3949ab' : '#2a2a2a');
        if (reelTbBox.length) {
            var bm = ov.boxMode;
            reelTbBox.css({
                background: bm > 0 ? '#3949ab' : '#2a2a2a',
                borderColor: bm > 0 ? '#7986cb' : '#555555'
            });
        }
    }

    function updateSizeThumbFromOverlay() {
        var ov = getSelectedOverlay();
        if (!reelTextSizeThumb.length || !reelTextSizeTrack.length || !ov) return;
        ensureOverlayFields(ov);
        var s = ov.fontScale;
        var pct = (REEL_SCALE_MAX - s) / (REEL_SCALE_MAX - REEL_SCALE_MIN);
        pct = Math.max(0, Math.min(1, pct));
        reelTextSizeThumb.css({
            top: (pct * 100) + '%',
            left: '50%',
            transform: 'translate(-50%, -50%)'
        });
    }

    function setFontScaleFromClientY(clientY) {
        var track = reelTextSizeTrack[0];
        if (!track) return;
        var r = track.getBoundingClientRect();
        var p = (clientY - r.top) / r.height;
        p = Math.max(0, Math.min(1, p));
        var scale = REEL_SCALE_MAX - p * (REEL_SCALE_MAX - REEL_SCALE_MIN);
        var ov = getSelectedOverlay();
        if (!ov) return;
        ov.fontScale = scale;
        updateSizeThumbFromOverlay();
        applyReelTextEditorPreview();
    }

    function hasReelTextLayers() {
        return textOverlays.some(function (o) { return o.text && String(o.text).trim() !== ''; });
    }

    function getSelectedOverlay() {
        if (!selectedOverlayId) return null;
        for (var i = 0; i < textOverlays.length; i++) {
            if (textOverlays[i].id === selectedOverlayId) return textOverlays[i];
        }
        return null;
    }

    function syncPanelFromSelection() {
        var ov = getSelectedOverlay();
        if (!ov) return;
        ensureOverlayFields(ov);
        textEditorInput.val(ov.text || '');
        if (reelTextColor.length) reelTextColor.val(ov.color || '#ffffff');
        if (reelTextFont.length) reelTextFont.val(ov.font || 'meme');
        updateFontCarouselUI();
        updateToolbarForSelection();
        updateSizeThumbFromOverlay();
        applyReelTextEditorPreview();
    }

    function syncReelTextHiddenFields() {
        var stageW = parseInt($('#reel_stage_w').val(), 10) || 1080;
        var stageH = parseInt($('#reel_stage_h').val(), 10) || 1920;
        var items = [];
        textOverlays.forEach(function (o) {
            if (!o.text || String(o.text).trim() === '') return;
            ensureOverlayFields(o);
            items.push({
                t: String(o.text).trim(),
                x: Math.round((o.x / 100) * stageW),
                y: Math.round((o.y / 100) * stageH),
                c: o.color || '#ffffff',
                f: o.font || 'meme',
                z: Number(o.fontScale),
                i: o.italic ? 1 : 0,
                a: o.align === 'left' ? 'l' : (o.align === 'right' ? 'r' : 'c'),
                m: o.boxMode,
                b: o.boxMode > 0 ? 1 : 0
            });
        });
        $('#reel_texts_json').val(items.length ? JSON.stringify(items) : '');
        if (items.length) {
            $('#reel_text').val(items[0].t);
            $('#reel_text_x').val(String(items[0].x));
            $('#reel_text_y').val(String(items[0].y));
        } else {
            $('#reel_text').val('');
            $('#reel_text_x').val('0');
            $('#reel_text_y').val('0');
        }
    }

    function genReelTagUid() {
        return 'rt_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
    }

    function syncReelTagsHidden() {
        var payload = reelTagItems.map(function (t) {
            var o = { type: t.type, x: t.x, y: t.y };
            var sc = typeof t.scale === 'number' ? t.scale : 1;
            sc = Math.max(0.45, Math.min(3.5, sc));
            if (Math.abs(sc - 1) > 0.02) o.s = Math.round(sc * 1000) / 1000;
            if (t.type === 'external') {
                o.url = t.url;
                if (t.label) o.label = t.label;
                if (t.img) o.img = t.img;
            } else {
                o.id = t.id;
            }
            return o;
        });
        $('#reel_tags_json').val(payload.length ? JSON.stringify(payload) : '');
    }

    function defaultTagPosition() {
        var n = reelTagItems.length;
        return { x: 0.28 + (n % 6) * 0.09, y: 0.78 + Math.floor(n / 6) * 0.06 };
    }

    function reelTagAlreadyExists(type, key) {
        return reelTagItems.some(function (t) {
            if (t.type !== type) return false;
            if (type === 'external') return t.url === key;
            return String(t.id) === String(key);
        });
    }

    function renderReelTagLayer() {
        if (!reelTagLayer) return;
        reelTagLayer.innerHTML = '';
        reelTagItems.forEach(function (t) {
            var wrap = document.createElement('div');
            wrap.className = 'reel-editor-tag-chip';
            wrap.setAttribute('data-uid', t._uid);
            wrap.style.left = (t.x * 100) + '%';
            wrap.style.top = (t.y * 100) + '%';
            setReelTagChipTransform(wrap, typeof t.scale === 'number' ? t.scale : 1);
            var im = document.createElement('img');
            im.src = t.img || '<?php echo addslashes($wo['userDefaultAvatar']); ?>';
            im.alt = '';
            im.draggable = false;
            wrap.appendChild(im);
            reelTagLayer.appendChild(wrap);
        });
        updateTrashZoneVisibility();
    }

    function openReelTagPanel() {
        if (!tagPanel.length) return;
        tagPanel.css({ display: 'flex', flexDirection: 'column' });
        setReelTagKind(reelTagKind, true);
    }

    function closeReelTagPanel() {
        tagPanel.hide();
        reelTagResults.empty();
    }

    function setReelTagKind(kind, fetchList) {
        reelTagKind = kind;
        $('.reel-tag-kind-btn').each(function () {
            var k = $(this).attr('data-kind');
            if (k === kind) {
                $(this).removeClass('reel-tag-kind-idle').addClass('reel-tag-kind-active');
            } else {
                $(this).removeClass('reel-tag-kind-active').addClass('reel-tag-kind-idle');
            }
        });
        if (kind === 'external') {
            reelTagSearchBlock.hide();
            reelTagExternalBlock.css({ display: 'flex', flexDirection: 'column' });
            reelTagResults.empty();
        } else {
            reelTagSearchBlock.show();
            reelTagExternalBlock.hide();
            reelTagSearchInput.val('');
            if (fetchList) {
                runReelTagSearch(true);
            } else {
                reelTagResults.empty();
            }
        }
    }

    function runReelTagSearch(immediate) {
        if (reelTagKind === 'external') return;
        var q = (reelTagSearchInput.val() || '').trim();
        if (!immediate) {
            clearTimeout(reelTagSearchTimer);
            reelTagSearchTimer = setTimeout(function () { runReelTagSearch(true); }, q.length < 1 ? 0 : 280);
            return;
        }
        $.post(Wo_Ajax_Requests_File() + '?f=posts&s=reel_tag_search', {
            kind: reelTagKind,
            q: q
        }).done(function (res) {
            reelTagResults.empty();
            if (!res || res.status !== 200) {
                reelTagResults.append($('<p style="color:#757575;padding:12px;"><?php echo addslashes($wo['lang']['error_please_try_again'] ?? 'Error'); ?></p>'));
                return;
            }
            if (res.suggestions) {
                reelTagResults.append($('<div class="reel-tag-suggestions-label"></div>').text('<?php echo addslashes($wo['lang']['frequent'] ?? 'Frecuentes'); ?>'));
            }
            if (!res.results || !res.results.length) {
                reelTagResults.append($('<p style="color:#757575;padding:12px;"><?php echo addslashes($wo['lang']['no_result'] ?? 'Sin resultados'); ?></p>'));
                return;
            }
            res.results.forEach(function (row) {
                var rowEl = $('<div class="reel-tag-result-row" style="display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:12px;margin-bottom:8px;cursor:pointer;"></div>');
                var av = $('<img style="width:40px;height:40px;border-radius:50%;object-fit:cover;flex-shrink:0;">').attr('src', row.img || '<?php echo addslashes($wo['userDefaultAvatar']); ?>');
                var tx = $('<div style="flex:1;min-width:0;"></div>');
                tx.append($('<div style="color:#333;font-weight:600;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"></div>').text(row.label || ''));
                rowEl.append(av, tx);
                rowEl.on('click', function () {
                    var key = row.type === 'external' ? row.url : row.id;
                    if (reelTagAlreadyExists(row.type, key)) return;
                    var pos = defaultTagPosition();
                    reelTagItems.push({
                        _uid: genReelTagUid(),
                        type: row.type,
                        id: row.id,
                        label: row.label || '',
                        img: row.img || '',
                        x: pos.x,
                        y: pos.y,
                        scale: 1
                    });
                    syncReelTagsHidden();
                    renderReelTagLayer();
                    closeReelTagPanel();
                });
                reelTagResults.append(rowEl);
            });
        });
    }

    function addReelExternalTag() {
        var url = ($('#reel_tag_external_url').val() || '').trim();
        if (!/^https?:\/\//i.test(url)) {
            alert('<?php echo addslashes($wo['lang']['please_enter_valid_url'] ?? 'Introduce una URL válida (http/https)'); ?>');
            return;
        }
        if (reelTagAlreadyExists('external', url)) return;
        var label = ($('#reel_tag_external_label').val() || '').trim();
        var img = ($('#reel_tag_external_img').val() || '').trim();
        var pos = defaultTagPosition();
        reelTagItems.push({
            _uid: genReelTagUid(),
            type: 'external',
            url: url,
            label: label,
            img: img,
            x: pos.x,
            y: pos.y,
            scale: 1
        });
        $('#reel_tag_external_url').val('');
        $('#reel_tag_external_label').val('');
        $('#reel_tag_external_img').val('');
        syncReelTagsHidden();
        renderReelTagLayer();
        closeReelTagPanel();
    }

