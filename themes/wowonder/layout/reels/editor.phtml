        var cy = ev.touches && ev.touches[0] ? ev.touches[0].clientY : e.clientY;
        setFontScaleFromClientY(cy);
        e.preventDefault();
    });
    $(document).on('mousemove.reelTxtSz touchmove.reelTxtSz', function (e) {
        if (!sizeSliderDragging) return;
        var ev = e.originalEvent;
        var cy = ev.touches && ev.touches[0] ? ev.touches[0].clientY : e.clientY;
        setFontScaleFromClientY(cy);
        e.preventDefault();
    });
    $(document).on('mouseup.reelTxtSz touchend.reelTxtSz', function () {
        sizeSliderDragging = false;
    });

    reelTextAddLayer.on('click', function () {
        var cur = getSelectedOverlay();
        var nid = genReelTextId();
        var baseX = cur ? cur.x : 50;
        var baseY = cur ? cur.y : 50;
        textOverlays.push(ensureOverlayFields({
            id: nid,
            text: <?php echo json_encode($wo['lang']['text'] ?? 'Texto'); ?>,
            x: Math.max(8, Math.min(92, baseX + 6)),
            y: Math.max(8, Math.min(92, baseY + 5)),
            color: (cur && cur.color) ? cur.color : '#ffffff',
            font: (cur && cur.font) ? cur.font : 'meme',
            fontScale: (cur && cur.fontScale != null) ? cur.fontScale : 1,
            italic: !!(cur && cur.italic),
            align: (cur && cur.align) ? cur.align : 'center',
            boxMode: (cur && cur.boxMode != null) ? cur.boxMode : 0
        }));
        selectedOverlayId = nid;
        syncPanelFromSelection();
        drawTextOverlay();
        setTimeout(function () { textEditorInput.focus().select(); }, 50);
    });

    textApplyBtn.on('click', function () {
        reelEmojiPopover.hide();
        var ov = getSelectedOverlay();
        if (!ov) {
            var nid = genReelTextId();
            ov = ensureOverlayFields({
                id: nid,
                text: '',
                x: 50,
                y: 50,
                color: '#ffffff',
                font: 'meme',
                fontScale: 1,
                italic: false,
                align: 'center',
                boxMode: 0
            });
            textOverlays.push(ov);
            selectedOverlayId = nid;
        }
        ensureOverlayFields(ov);
        ov.text = $.trim(textEditorInput.val() || '');
        ov.color = reelTextColor.val() || '#ffffff';
        ov.font = reelTextFont.val() || 'meme';

        textOverlays = textOverlays.filter(function (o) {
            return o.text && String(o.text).trim() !== '';
        });
        if (!textOverlays.length) {
            selectedOverlayId = null;
        } else if (!textOverlays.some(function (o) { return o.id === selectedOverlayId; })) {
            selectedOverlayId = textOverlays[textOverlays.length - 1].id;
        }

        if (textCanvas) {
            setTimeout(function () {
                layoutReelEditStage();
                updateCanvasSize();
                drawTextOverlay();
            }, 100);
        }
        drawTextOverlay();
        textPanel.css('display', 'none');
    });

    // Arrastrar capas de texto; soltar sobre la basura elimina la capa.
    var isDraggingText = false;
    var reelTextPinchState = null;
    if (textDragArea && textCanvas) {
        textDragArea.style.pointerEvents = 'none';
        textDragArea.style.touchAction = 'none';

        function getDragAreaEventPos(e) {
            var rect = textDragArea.getBoundingClientRect();
            var clientX = e.touches ? e.touches[0].clientX : e.clientX;
            var clientY = e.touches ? e.touches[0].clientY : e.clientY;
            return {
                x: ((clientX - rect.left) / rect.width) * 100,
                y: ((clientY - rect.top) / rect.height) * 100,
                clientX: clientX,
                clientY: clientY
            };
        }

        function getOverlayIdAtClientXY(clientX, clientY) {
            var rect = textDragArea.getBoundingClientRect();
            if (rect.width <= 0 || rect.height <= 0) return null;
            var pos = {
                x: ((clientX - rect.left) / rect.width) * 100,
                y: ((clientY - rect.top) / rect.height) * 100
            };
            return getOverlayIdAtPercent(pos);
        }

        function passEventToUnderlying(clientX, clientY) {
            textDragArea.style.pointerEvents = 'none';
            var underlying = document.elementFromPoint(clientX, clientY);
            if (underlying && typeof underlying.click === 'function') {
                underlying.click();
            }
            setTimeout(function () {
                if (textDragArea && $step2.length && $step2.is(':visible')) {
                    textDragArea.style.pointerEvents = 'auto';
                }
            }, 0);
        }

        function finishTextDrag(clientX, clientY) {
            if (isDraggingText && draggingOverlayId && isPointOverTrash(clientX, clientY)) {
                var delId = draggingOverlayId;
                textOverlays = textOverlays.filter(function (o) { return o.id !== delId; });
                if (selectedOverlayId === delId) {
                    selectedOverlayId = textOverlays.length ? textOverlays[textOverlays.length - 1].id : null;
                }
            }
            setTrashZoneHighlight(false);
            isDraggingText = false;
            draggingOverlayId = null;
            drawTextOverlay();
        }

        var reelEmptyMouseDownTime = 0;
        var reelPrevTouchStart = 0;
        var reelPrevTouchOid = null;
        var reelPrevTouchX = 0;
        var reelPrevTouchY = 0;

        textDragArea.addEventListener('mousedown', function (e) {
            if (!$step2.length || !$step2.is(':visible')) return;
            var pos = getDragAreaEventPos(e);
            var oid = getOverlayIdAtPercent(pos);
            if (!oid) {
                var now = Date.now();
                if (now - reelEmptyMouseDownTime < 420) {
                    reelEmptyMouseDownTime = 0;
                } else {
                    reelEmptyMouseDownTime = now;
                    passEventToUnderlying(e.clientX, e.clientY);
                }
                return;
            }
            reelEmptyMouseDownTime = 0;
            if (!hasReelTextLayers()) return;
            e.preventDefault();
            e.stopPropagation();
            selectedOverlayId = oid;
            isDraggingText = true;
            draggingOverlayId = oid;
            textDragArea.style.cursor = 'grabbing';
            drawTextOverlay();
        });

        textDragArea.addEventListener('click', function (e) {
            if (e.detail !== 2) return;
            if (!$step2.length || !$step2.is(':visible')) return;
            e.preventDefault();
            e.stopPropagation();
            reelEmptyMouseDownTime = 0;
            handleReelStageDoubleActivate(e.clientX, e.clientY);
        });

        textDragArea.addEventListener('dblclick', function (e) {
            if (!$step2.length || !$step2.is(':visible')) return;
            e.preventDefault();
            e.stopPropagation();
            reelEmptyMouseDownTime = 0;
            handleReelStageDoubleActivate(e.clientX, e.clientY);
        });

        textDragArea.addEventListener('touchstart', function (e) {
            if (!$step2.length || !$step2.is(':visible')) return;
            if (e.touches && e.touches.length >= 2) {
                drawTextOverlay();
                var t0 = e.touches[0], t1 = e.touches[1];
                var oidA = getOverlayIdAtClientXY(t0.clientX, t0.clientY);
                var oidB = getOverlayIdAtClientXY(t1.clientX, t1.clientY);
                var oidPinch = (oidA && oidA === oidB) ? oidA : getOverlayIdAtClientXY((t0.clientX + t1.clientX) / 2, (t0.clientY + t1.clientY) / 2);
                if (oidPinch && hasReelTextLayers()) {
                    var ovP = findOverlayById(oidPinch);
                    if (ovP) {
                        ensureOverlayFields(ovP);
                        reelTextPinchState = {
                            overlayId: oidPinch,
                            startDist: reelTagTouchDistance(e.touches),
                            startScale: ovP.fontScale
                        };
                        isDraggingText = false;
                        draggingOverlayId = null;
                        selectedOverlayId = oidPinch;
                        e.preventDefault();
                        e.stopPropagation();
                        drawTextOverlay();
                        return;
                    }
                }
                return;
            }
            if (!e.touches || e.touches.length !== 1) return;
            var t = e.touches[0];
            var pos = getDragAreaEventPos(e);
            drawTextOverlay();
            var oid = getOverlayIdAtPercent(pos);
            var tnow = Date.now();
            if (
                tnow - reelPrevTouchStart < 340 &&
                oid === reelPrevTouchOid &&
                Math.hypot(t.clientX - reelPrevTouchX, t.clientY - reelPrevTouchY) < 48
            ) {
                e.preventDefault();
                e.stopPropagation();
                isDraggingText = false;
                draggingOverlayId = null;
                reelPrevTouchStart = 0;
                handleReelStageDoubleActivate(t.clientX, t.clientY);
                return;
            }
            reelPrevTouchStart = tnow;
            reelPrevTouchOid = oid;
            reelPrevTouchX = t.clientX;
            reelPrevTouchY = t.clientY;
            if (!hasReelTextLayers()) return;
            if (!oid) return;
            e.preventDefault();
            e.stopPropagation();
            selectedOverlayId = oid;
            isDraggingText = true;
            draggingOverlayId = oid;
            drawTextOverlay();
        }, { passive: false });

        textDragArea.addEventListener('mousemove', function (e) {
            if (!isDraggingText || !draggingOverlayId || !hasReelTextLayers()) return;
            e.preventDefault();
            e.stopPropagation();
            var pos = getDragAreaEventPos(e);
            var ov = findOverlayById(draggingOverlayId);
            if (ov) {
                ov.x = Math.max(0, Math.min(100, pos.x));
                ov.y = Math.max(0, Math.min(100, pos.y));
            }
            setTrashZoneHighlight(isPointOverTrash(pos.clientX, pos.clientY));
            drawTextOverlay();
        });

        textDragArea.addEventListener('touchmove', function (e) {
            if (!$step2.length || !$step2.is(':visible')) return;
            var touches = e.touches;
            if (reelTextPinchState) {
                if (touches && touches.length >= 2) {
                    e.preventDefault();
                    e.stopPropagation();
                    var dPin = reelTagTouchDistance(touches);
                    if (dPin < 8) return;
                    var ovPin = findOverlayById(reelTextPinchState.overlayId);
                    if (ovPin) {
                        ensureOverlayFields(ovPin);
                        var nsPin = reelTextPinchState.startScale * (dPin / reelTextPinchState.startDist);
                        ovPin.fontScale = Math.max(REEL_SCALE_MIN, Math.min(REEL_SCALE_MAX, nsPin));
                    }
                    drawTextOverlay();
                    return;
                }
                reelTextPinchState = null;
            }
            if (isDraggingText && draggingOverlayId && touches && touches.length >= 2) {
                var d2 = reelTagTouchDistance(touches);
                if (d2 >= 8) {
                    var ovt = findOverlayById(draggingOverlayId);
                    if (ovt) {
                        ensureOverlayFields(ovt);
                        reelTextPinchState = {
                            overlayId: draggingOverlayId,
                            startDist: d2,
                            startScale: ovt.fontScale
                        };
                        isDraggingText = false;
                        draggingOverlayId = null;
                        setTrashZoneHighlight(false);
                    }
                    e.preventDefault();
                    e.stopPropagation();
                    return;
                }
            }
            if (!isDraggingText || !draggingOverlayId || !hasReelTextLayers()) return;
            e.preventDefault();
            e.stopPropagation();
            var pos = getDragAreaEventPos(e);
            var ov = findOverlayById(draggingOverlayId);
            if (ov) {
                ov.x = Math.max(0, Math.min(100, pos.x));
                ov.y = Math.max(0, Math.min(100, pos.y));
            }
            setTrashZoneHighlight(isPointOverTrash(pos.clientX, pos.clientY));
            drawTextOverlay();
        }, { passive: false });

        textDragArea.addEventListener('mouseup', function (e) {
            if (isDraggingText) {
                e.preventDefault();
                e.stopPropagation();
            }
            finishTextDrag(e.clientX, e.clientY);
        });

        textDragArea.addEventListener('touchend', function (e) {
            if (reelTextPinchState && (!e.touches || e.touches.length < 2)) {
                reelTextPinchState = null;
            }
            var t = e.changedTouches && e.changedTouches[0];
            var cx = t ? t.clientX : 0;
            var cy = t ? t.clientY : 0;
            if (isDraggingText) {
                e.preventDefault();
                e.stopPropagation();
            }
            finishTextDrag(cx, cy);
        });

        textDragArea.addEventListener('mouseleave', function () {
            if (isDraggingText) {
                setTrashZoneHighlight(false);
            }
            isDraggingText = false;
            draggingOverlayId = null;
            drawTextOverlay();
        });

        textDragArea.addEventListener('touchcancel', function () {
            reelTextPinchState = null;
            setTrashZoneHighlight(false);
            isDraggingText = false;
            draggingOverlayId = null;
            drawTextOverlay();
        });

        textDragArea.addEventListener('wheel', function (ev) {
            if (!ev.ctrlKey && !ev.metaKey) return;
            if (!$step2.length || !$step2.is(':visible')) return;
            if (!hasReelTextLayers()) return;
            drawTextOverlay();
            var oidW = getOverlayIdAtClientXY(ev.clientX, ev.clientY);
            if (!oidW) return;
            ev.preventDefault();
            var ovW = findOverlayById(oidW);
            if (!ovW) return;
            ensureOverlayFields(ovW);
            var factor = ev.deltaY < 0 ? 1.045 : 0.956;
            ovW.fontScale = Math.max(REEL_SCALE_MIN, Math.min(REEL_SCALE_MAX, ovW.fontScale * factor));
            selectedOverlayId = oidW;
            drawTextOverlay();
        }, { passive: false });
    }

    // Timeline drag - Soporte para mouse y touch
    function getEventX(e) {
        return e.touches ? e.touches[0].clientX : e.clientX;
    }

    function handleTimelineDrag(e, handleType) {
        e.preventDefault();
        e.stopPropagation();
        if (handleType === 'start') {
            isDraggingStart = true;
        } else if (handleType === 'end') {
            isDraggingEnd = true;
        }
    }

    trimStartHandle.on('mousedown touchstart', function(e) {
        handleTimelineDrag(e, 'start');
    });
    trimEndHandle.on('mousedown touchstart', function(e) {
        handleTimelineDrag(e, 'end');
    });

    trimTrack.on('mousedown touchstart', function(e) {
        if (isDraggingStart || isDraggingEnd) return;
        var rect = trimTrack[0].getBoundingClientRect();
        var clickX = getEventX(e) - rect.left;
        var clickPercent = Math.max(0, Math.min(100, (clickX / rect.width) * 100));
        var newTime = (clickPercent / 100) * videoDuration;
        var seekV = getReelPlaybackVideo();
        if (seekV) {
            seekV.currentTime = Math.max(trimStartPercent / 100 * videoDuration, Math.min(trimEndPercent / 100 * videoDuration, newTime));
        }
    });

    function updateTimelineFromEvent(e) {
        if (!isDraggingStart && !isDraggingEnd) return;
        if (!trimTrack[0] || videoDuration <= 0) return;
        var rect = trimTrack[0].getBoundingClientRect();
        var mouseX = getEventX(e) - rect.left;
        var percent = Math.max(0, Math.min(100, (mouseX / rect.width) * 100));
        
        if (isDraggingStart) {
            var maxPercent = trimEndPercent - 1;
            trimStartPercent = Math.min(percent, maxPercent);
            updateTimeline();
        } else if (isDraggingEnd) {
            var minPercent = trimStartPercent + 1;
            trimEndPercent = Math.max(percent, minPercent);
            updateTimeline();
        }
    }

    $(document).on('mousemove touchmove', function(e) {
        updateTimelineFromEvent(e);
    });

    $(document).on('mouseup touchend', function() {
        isDraggingStart = false;
        isDraggingEnd = false;
    });

    // Ir al paso de edición
    goToEditBtn.on('click', function () {
        if (!recordedBlob && !uploadedFile) {
            return;
        }
        goToEdit();
    });

    if (retryBtn.length) {
        retryBtn.on('click', function () {
            resetEditorToCamera();
        });
    }

    // Envío manual con FormData (para soportar blob grabado)
    $form.on('submit', function (e) {
        e.preventDefault();

        if (videoDuration > 0) {
            updateTimeline();
            var ts = parseFloat(trimStartInput.val());
            var te = parseFloat(trimEndInput.val());
            if (!(te > ts)) {
                trimEndInput.val(Number(videoDuration).toFixed(3));
                updateTimeline();
            }
        }

        syncReelTextHiddenFields();
        syncReelTagsHidden();
        var formData = new FormData($form[0]);
        // Forzar que el backend trate esto como reel (por si el input oculto no llega).
        formData.set('reels', '1');

        if (recordedBlob) {
            formData.delete('postVideo');
            formData.append('postVideo', recordedBlob, 'reel-recorded.webm');
        } else if (uploadedFile) {
            formData.delete('postVideo');
            formData.append('postVideo', uploadedFile, uploadedFile.name);
        }

        // Asegurar envío explícito del audio seleccionado.
        // (Borramos primero lo que venga en el FormData para evitar duplicados o entradas vacías.)
        formData.delete('reel_audio');
        if (audioInput && audioInput[0] && audioInput[0].files && audioInput[0].files[0]) {
            formData.append('reel_audio', audioInput[0].files[0], audioInput[0].files[0].name);
        }

        $status.removeClass('alert-success alert-danger').html('');
        $form.find('.add_wow_loader').addClass('btn-loading');
        $form.find('button[type="submit"]').prop('disabled', true);
        showReelPublishOverlay();

        var uploadFinished = false;

        $.ajax({
            url: Wo_Ajax_Requests_File() + '?f=posts&s=insert_new_post',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            dataType: 'json',
            xhr: function () {
                var xhr = $.ajaxSettings.xhr();
                if (xhr.upload) {
                    xhr.upload.addEventListener('progress', function (e) {
                        if (uploadFinished) return;
                        if (e.lengthComputable && e.total > 0) {
                            var pct = Math.min(100, Math.round((e.loaded / e.total) * 100));
                            $publishBar.removeClass('reel-publish-bar-indeterminate').css('width', pct + '%');
                            $publishPct.text(pct + '%');
                            $publishTitle.text('Subiendo video…');
                        } else {
                            $publishBar.addClass('reel-publish-bar-indeterminate').css('width', '100%');
                            $publishPct.text('Subiendo…');
                        }
                    }, false);
                    xhr.upload.addEventListener('loadend', function () {
                        if (uploadFinished) return;
                        uploadFinished = true;
                        $publishTitle.text('Generando y publicando tu reel…');
                        $publishBar.addClass('reel-publish-bar-indeterminate').css('width', '100%');
                        $publishPct.text('Procesando en el servidor…');
                        $publishNotice.html('El servidor está generando la versión final del video. En unos minutos podrás verlo en Reels con todos los cambios aplicados.');
                    }, false);
                }
                return xhr;
            }
        }).done(function (data) {
            $form.find('.add_wow_loader').removeClass('btn-loading');
            if (data.status == 200) {
                $publishTitle.text('¡Listo! Publicando…');
                $publishBar.removeClass('reel-publish-bar-indeterminate').css('width', '100%');
                $publishPct.text('100%');
                $publishNotice.html('Tu reel ya está publicado. Si el video aún se procesa en segundo plano, la versión definitiva puede tardar unos minutos en mostrarse en Reels.');
                $status.addClass('alert alert-success').html('<?php echo $wo['lang']['post_published']; ?>');
                if (data.post_id) {
                    window.location.href = "<?php echo $wo['config']['site_url']; ?>/reels/" + data.post_id;
                }
            } else if (data.status == 300) {
                // FFmpeg en proceso: el post/reel se registra, pero el video final puede tardar.
                $publishTitle.text('Reel registrado');
                $publishBar.removeClass('reel-publish-bar-indeterminate').css('width', '100%');
                $publishPct.text('100%');
                $publishNotice.html('Tu video está en cola de procesado: pronto se actualizará con la versión final. En unos minutos lo verás en Reels.');
                $status.addClass('alert alert-success').html('Publicando reel... El render final puede tardar unos momentos.');
                setTimeout(function () {
                    window.location.href = "<?php echo $wo['config']['site_url']; ?>/reels";
                }, 12000);
            } else {
                hideReelPublishOverlay();
                $form.find('button[type="submit"]').prop('disabled', false);
                var err = (data.errors) ? data.errors : '<?php echo $wo['lang']['error_please_try_again']; ?>';
                $status.addClass('alert alert-danger').html(err);
            }
        }).fail(function () {
            $form.find('.add_wow_loader').removeClass('btn-loading');
            hideReelPublishOverlay();
            $form.find('button[type="submit"]').prop('disabled', false);
            $status.addClass('alert alert-danger').html('<?php echo $wo['lang']['error_please_try_again']; ?>');
        });
    });
});
</script>

