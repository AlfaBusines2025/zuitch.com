    /** Paso 2: el lienzo sigue recibiendo eventos (doble clic en vacío, paso de clic al vídeo). */
    function applyReelTextDragAreaPointerState() {
        if (!textDragArea) return;
        if (!$step2.length || !$step2.is(':visible')) {
            textDragArea.style.pointerEvents = 'none';
            return;
        }
        textDragArea.style.pointerEvents = 'auto';
        textDragArea.style.cursor = hasReelTextLayers()
            ? (draggingOverlayId ? 'grabbing' : 'move')
            : 'default';
        textDragArea.style.touchAction = hasReelTextLayers() ? 'none' : 'auto';
    }

    function ensureOverlayWhenOpeningFromPencil() {
        if (textOverlays.length === 0) {
            var nid = genReelTextId();
            textOverlays.push(ensureOverlayFields({
                id: nid,
                text: '',
                x: 50,
                y: 50,
                color: '#ffffff',
                font: 'meme',
                fontScale: 1,
                italic: false,
                align: 'center',
                boxMode: 0
            }));
            selectedOverlayId = nid;
        } else if (!getSelectedOverlay()) {
            selectedOverlayId = textOverlays[0].id;
        }
    }

    function openReelTextStudioPanel() {
        if (!textPanel.length) return;
        reelEmojiPopover.hide();
        syncPanelFromSelection();
        textPanel.css({ display: 'flex', flexDirection: 'column' });
        requestAnimationFrame(function () {
            requestAnimationFrame(function () {
                applyReelTextEditorPreview();
            });
        });
        setTimeout(function () {
            textEditorInput.focus();
        }, 50);
    }

    var _reelStageDblActivateAt = 0;

    /** Doble clic / doble toque: capa bajo el punto → abre estudio; vacío → nueva capa y estudio. */
    function handleReelStageDoubleActivate(clientX, clientY) {
        if (!textPanel.length || !textDragArea || !textCanvas || !$step2.length || !$step2.is(':visible')) return;
        var now = Date.now();
        if (now - _reelStageDblActivateAt < 350) return;
        _reelStageDblActivateAt = now;
        var rect = textDragArea.getBoundingClientRect();
        if (rect.width <= 0 || rect.height <= 0) return;
        isDraggingText = false;
        draggingOverlayId = null;
        drawTextOverlay();
        var pos = {
            x: ((clientX - rect.left) / rect.width) * 100,
            y: ((clientY - rect.top) / rect.height) * 100,
            clientX: clientX,
            clientY: clientY
        };
        var oid = getOverlayIdAtPercent(pos);
        reelEmojiPopover.hide();
        if (oid) {
            selectedOverlayId = oid;
        } else {
            var nid = genReelTextId();
            textOverlays.push(ensureOverlayFields({
                id: nid,
                text: '',
                x: Math.max(5, Math.min(95, pos.x)),
                y: Math.max(5, Math.min(95, pos.y)),
                color: '#ffffff',
                font: 'meme',
                fontScale: 1,
                italic: false,
                align: 'center',
                boxMode: 0
            }));
            selectedOverlayId = nid;
        }
        openReelTextStudioPanel();
    }

    function setTrashZoneHighlight(on) {
        var tz = document.getElementById('reel_text_trash_zone');
        if (!tz) return;
        tz.style.borderColor = on ? 'rgba(244,67,54,0.95)' : 'rgba(255,255,255,0.45)';
        tz.style.background = on ? 'rgba(244,67,54,0.35)' : 'rgba(0,0,0,0.5)';
    }

    function isPointOverTrash(clientX, clientY) {
        var tz = document.getElementById('reel_text_trash_zone');
        if (!tz || tz.style.display === 'none') return false;
        var r = tz.getBoundingClientRect();
        return clientX >= r.left && clientX <= r.right && clientY >= r.top && clientY <= r.bottom;
    }

