    function formatFileSize(bytes) {
        if (!bytes) return '0 MB';
        var mb = (bytes / (1024 * 1024)).toFixed(1);
        return mb + ' MB';
    }

    function getTrimStartTime() {
        if (videoDuration <= 0) return 0;
        return (trimStartPercent / 100) * videoDuration;
    }

    function getReelVideoTrimDurationSec() {
        if (videoDuration <= 0) return 60;
        return Math.max(0.05, ((trimEndPercent - trimStartPercent) / 100) * videoDuration);
    }

    /** Duración del fragmento que se usa en el reel: siempre la del recorte del video (o el audio completo si es más corto). */
    function getReelEffectiveAudioSegLen() {
        var trimLen = getReelVideoTrimDurationSec();
        if (!reelAudioFileDurationSec || reelAudioFileDurationSec < 0.001) {
            return Math.max(0.05, trimLen);
        }
        return Math.max(0.05, Math.min(trimLen, reelAudioFileDurationSec));
    }

    function syncReelAudioHiddenFields() {
        $('#reel_audio_start').val(String(reelAudioSegStartSec.toFixed(4)));
        $('#reel_audio_duration').val(String(getReelEffectiveAudioSegLen().toFixed(4)));
        $('#reel_music_volume').val(String(Math.min(4, Math.max(0, reelMusicVol))));
        $('#reel_video_volume').val(String(Math.min(1, Math.max(0, reelVideoVol))));
    }

    function reelClampAudioSegmentToTrim() {
        if (!reelAudioPeaks || !reelAudioPeaks.length) return;
        var seg = getReelEffectiveAudioSegLen();
        var maxStart = Math.max(0, reelAudioFileDurationSec - seg);
        if (reelAudioSegStartSec > maxStart) {
            reelAudioSegStartSec = maxStart;
        }
        syncReelAudioHiddenFields();
        drawReelAudioWaveform();
        updateReelAudioPanelChrome();
    }

    function updateReelAudioPanelChrome() {
        var seg = getReelEffectiveAudioSegLen();
        $('#reel_audio_seg_badge').text(Math.round(seg));
        if (!reelAudioFileDurationSec) return;
        var p0 = (reelAudioSegStartSec / reelAudioFileDurationSec) * 100;
        var p1 = ((reelAudioSegStartSec + seg) / reelAudioFileDurationSec) * 100;
        p0 = Math.max(0, Math.min(100, p0));
        p1 = Math.max(0, Math.min(100, p1));
        $('#reel_audio_top_handle_start').css('left', p0 + '%');
        $('#reel_audio_top_dot_r').css('left', p1 + '%');
        $('#reel_audio_top_prog').css({ left: p0 + '%', width: Math.max(0, p1 - p0) + '%' });
    }

    function buildReelAudioPeaks(audioBuffer) {
        var ch = audioBuffer.numberOfChannels > 0 ? audioBuffer.getChannelData(0) : null;
        if (!ch || !ch.length) {
            reelAudioPeaks = null;
            return;
        }
        var n = 140;
        var peaks = [];
        var block = Math.floor(ch.length / n) || 1;
        for (var i = 0; i < n; i++) {
            var start = i * block;
            var end = Math.min(ch.length, start + block);
            var max = 0;
            for (var j = start; j < end; j++) {
                var v = Math.abs(ch[j]);
                if (v > max) max = v;
            }
            peaks.push(max);
        }
        reelAudioPeaks = peaks;
    }

    function resizeReelAudioCanvas() {
        if (!reelAudioCanvas || !reelAudioCtx) return;
        var wrap = document.getElementById('reel_audio_wave_inner');
        if (!wrap) return;
        var w = Math.min(720, Math.max(280, wrap.clientWidth || 600));
        var dpr = window.devicePixelRatio || 1;
        reelAudioCanvas.width = Math.floor(w * dpr);
        reelAudioCanvas.height = Math.floor(REEL_AUDIO_WAVE_H * dpr);
        reelAudioCanvas.style.height = REEL_AUDIO_WAVE_H + 'px';
        reelAudioCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function drawReelAudioWaveform() {
        if (!reelAudioCtx || !reelAudioCanvas || !reelAudioPeaks || !reelAudioPeaks.length || reelAudioFileDurationSec <= 0) return;
        resizeReelAudioCanvas();
        var w = reelAudioCanvas.width / (window.devicePixelRatio || 1);
        var h = REEL_AUDIO_WAVE_H;
        var ctx = reelAudioCtx;
        var n = reelAudioPeaks.length;
        var barW = w / n;
        var segLen = getReelEffectiveAudioSegLen();
        var i0 = Math.floor((reelAudioSegStartSec / reelAudioFileDurationSec) * n);
        var i1 = Math.ceil(((reelAudioSegStartSec + segLen) / reelAudioFileDurationSec) * n);
        i0 = Math.max(0, Math.min(n - 1, i0));
        i1 = Math.max(i0 + 1, Math.min(n, i1));
        var colBg = '#0a1118';
        var colBarOut = '#3a5366';
        var colBarIn = '#8eb4c9';
        var colPlayhead = '#2E9FFF';
        var colStroke = '#2E9FFF';
        var colHandle = '#2E9FFF';
        ctx.fillStyle = colBg;
        ctx.fillRect(0, 0, w, h);
        var gridN = 5;
        ctx.strokeStyle = 'rgba(46, 159, 255, 0.14)';
        ctx.lineWidth = 1;
        for (var gi = 1; gi < gridN; gi++) {
            var gx = (gi / gridN) * w;
            ctx.beginPath();
            ctx.moveTo(Math.floor(gx) + 0.5, 0);
            ctx.lineTo(Math.floor(gx) + 0.5, h);
            ctx.stroke();
        }
        var selL = (reelAudioSegStartSec / reelAudioFileDurationSec) * w;
        var selR = ((reelAudioSegStartSec + segLen) / reelAudioFileDurationSec) * w;
        ctx.fillStyle = 'rgba(169, 198, 217, 0.22)';
        ctx.fillRect(selL, 0, Math.max(1, selR - selL), h);
        for (var i = 0; i < n; i++) {
            var amp = reelAudioPeaks[i];
            var bh = Math.max(2, amp * h * 0.85);
            var x = i * barW + barW * 0.2;
            var bw = Math.max(2, barW * 0.65);
            var y = (h - bh) / 2;
            var inside = i >= i0 && i < i1;
            ctx.fillStyle = inside ? colBarIn : colBarOut;
            if (inside && i === Math.floor((i0 + i1) / 2)) {
                ctx.fillStyle = colPlayhead;
            }
            var r = Math.min(bw / 2, bh / 2, 3);
            ctx.beginPath();
            ctx.moveTo(x + r, y);
            ctx.lineTo(x + bw - r, y);
            ctx.quadraticCurveTo(x + bw, y, x + bw, y + r);
            ctx.lineTo(x + bw, y + bh - r);
            ctx.quadraticCurveTo(x + bw, y + bh, x + bw - r, y + bh);
            ctx.lineTo(x + r, y + bh);
            ctx.quadraticCurveTo(x, y + bh, x, y + bh - r);
            ctx.lineTo(x, y + r);
            ctx.quadraticCurveTo(x, y, x + r, y);
            ctx.closePath();
            ctx.fill();
        }
        ctx.save();
        ctx.strokeStyle = colStroke;
        ctx.lineWidth = Math.max(2, Math.round(h / 24));
        ctx.strokeRect(selL + 1, 2, Math.max(3, selR - selL - 2), h - 4);
        ctx.fillStyle = colHandle;
        var hw = Math.max(4, Math.round(h / 14));
        var hr = 3;
        ctx.beginPath();
        ctx.moveTo(selL + hr, 3);
        ctx.lineTo(selL + hw - hr, 3);
        ctx.quadraticCurveTo(selL + hw, 3, selL + hw, 3 + hr);
        ctx.lineTo(selL + hw, h - 3 - hr);
        ctx.quadraticCurveTo(selL + hw, h - 3, selL + hw - hr, h - 3);
        ctx.lineTo(selL + hr, h - 3);
        ctx.quadraticCurveTo(selL, h - 3, selL, h - 3 - hr);
        ctx.lineTo(selL, 3 + hr);
        ctx.quadraticCurveTo(selL, 3, selL + hr, 3);
        ctx.closePath();
        ctx.fill();
        ctx.restore();
    }

    function initReelAudioSegmentAfterDecode() {
        reelAudioSegStartSec = 0;
        syncReelAudioHiddenFields();
        updateReelAudioPanelChrome();
        drawReelAudioWaveform();
    }

    function decodeReelAudioArrayBuffer(ab, onDecoded) {
        reelAudioArrayBuffer = ab;
        var AC = window.AudioContext || window.webkitAudioContext;
        if (!AC || !ab) {
            reelAudioPeaks = null;
            if (typeof onDecoded === 'function') {
                onDecoded();
            }
            return;
        }
        var actx = new AC();
        actx.decodeAudioData(ab.slice(0), function (buf) {
            try {
                actx.close();
            } catch (e1) {}
            reelAudioFileDurationSec = buf.duration;
            buildReelAudioPeaks(buf);
            initReelAudioSegmentAfterDecode();
            if (typeof onDecoded === 'function') {
                onDecoded();
            }
        }, function () {
            try {
                actx.close();
            } catch (e2) {}
            reelAudioPeaks = null;
            reelAudioFileDurationSec = 0;
            if (typeof onDecoded === 'function') {
                onDecoded();
            }
        });
    }

    function applyReelVolumeSlidersToPlayers() {
        if (previewVideo) {
            previewVideo.volume = Math.min(1, Math.max(0, reelVideoVol));
        }
        if (reelAudioPanelVideo) {
            reelAudioPanelVideo.volume = Math.min(1, Math.max(0, reelVideoVol));
        }
        if (audioElement) {
            audioElement.volume = Math.min(1, Math.max(0, reelMusicVol));
        }
    }

    function openReelAudioPanel() {
        if (!reelAudioPanel.length) return;
        pauseReelPlaybackFully();
        setupReelAudioPanelVideo();
        reelAudioPanel.css({ display: 'flex', flexDirection: 'column' });
        var av = getReelPlaybackVideo();
        if (av && videoDuration > 0) {
            updateReelAudioPanelTimeLabel(av);
        }
        setTimeout(function () {
            resizeReelAudioCanvas();
            drawReelAudioWaveform();
        }, 80);
    }

    function closeReelAudioPanel() {
        if (reelAudioPanelVideo && previewVideo && (previewVideo.src || previewVideo.currentSrc)) {
            try {
                previewVideo.currentTime = reelAudioPanelVideo.currentTime;
            } catch (e) {}
            reelAudioPanelVideo.pause();
        }
        pauseReelPlaybackFully();
        reelAudioPanel.hide();
    }

    function syncAudioWithVideo(forceFromStart) {
        if (!audioElement) return;
        var v = getReelPlaybackVideo();
        if (!v) return;
        var trimStart = getTrimStartTime();
        var rel = v.currentTime - trimStart;
        if (rel < 0) rel = 0;
        var segLen = getReelEffectiveAudioSegLen();
        if (segLen < 0.05) segLen = 0.05;
        var posInSeg = rel % segLen;
        var target = reelAudioSegStartSec + (forceFromStart ? 0 : posInSeg);
        if (target > reelAudioSegStartSec + segLen - 0.04) {
            target = reelAudioSegStartSec;
        }
        if (Math.abs((audioElement.currentTime || 0) - target) > 0.18) {
            try {
                audioElement.currentTime = target;
            } catch (e) {}
        }
    }

    previewVideo.addEventListener('timeupdate', function() {
        processReelVideoTimeupdate(previewVideo);
    });

    if (reelAudioPanelVideo) {
        reelAudioPanelVideo.addEventListener('timeupdate', function() {
            processReelVideoTimeupdate(reelAudioPanelVideo);
        });
    }

    function handleReelVideoEnded(ev) {
        var v = ev.target;
        if (v !== getReelPlaybackVideo()) return;
        pauseReelPlaybackFully();
        if (audioElement) {
            syncAudioWithVideo(true);
        }
        if (videoDuration > 0) {
            v.currentTime = (trimStartPercent / 100) * videoDuration;
        }
    }

    previewVideo.addEventListener('ended', handleReelVideoEnded);
    if (reelAudioPanelVideo) {
        reelAudioPanelVideo.addEventListener('ended', handleReelVideoEnded);
    }

    function handleReelVideoSeeking(ev) {
        if (ev.target !== getReelPlaybackVideo()) return;
        if (audioElement) {
            syncAudioWithVideo(false);
        }
    }

    previewVideo.addEventListener('seeking', handleReelVideoSeeking);
    if (reelAudioPanelVideo) {
        reelAudioPanelVideo.addEventListener('seeking', handleReelVideoSeeking);
