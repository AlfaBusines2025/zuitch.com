    $(document).on('mousedown touchstart', '#reel_tag_layer .reel-editor-tag-chip', function (e) {
        var uid = $(this).attr('data-uid');
        var t = reelTagItems.filter(function (x) { return x._uid === uid; })[0];
        if (!t) return;
        var oev = e.originalEvent;
        if (oev && oev.touches && oev.touches.length >= 2) {
            draggingTagUid = null;
            reelTagPinchState = {
                uid: uid,
                startDist: reelTagTouchDistance(oev.touches),
                startScale: getReelTagScaleByUid(uid)
            };
            e.preventDefault();
            return;
        }
        draggingTagUid = uid;
        var st = document.getElementById('reel_edit_stage');
        if (!st) return;
        var r = st.getBoundingClientRect();
        var cx = oev && oev.touches && oev.touches[0] ? oev.touches[0].clientX : e.clientX;
        var cy = oev && oev.touches && oev.touches[0] ? oev.touches[0].clientY : e.clientY;
        var cxN = (cx - r.left) / r.width;
        var cyN = (cy - r.top) / r.height;
        reelTagDragOffset.dx = cxN - t.x;
        reelTagDragOffset.dy = cyN - t.y;
        e.preventDefault();
    });
    $(document).on('mousemove touchmove', function (e) {
        var oev = e.originalEvent;
        var touches = oev && oev.touches ? oev.touches : null;
        if (reelTagPinchState && touches && touches.length >= 2) {
            e.preventDefault();
            var d = reelTagTouchDistance(touches);
            if (d < 8) return;
            var ns = reelTagPinchState.startScale * (d / reelTagPinchState.startDist);
            ns = Math.max(0.45, Math.min(3.5, ns));
            reelTagItems.forEach(function (t) {
                if (t._uid === reelTagPinchState.uid) t.scale = ns;
            });
            var chip = reelTagLayer && reelTagLayer.querySelector('[data-uid="' + reelTagPinchState.uid + '"]');
            setReelTagChipTransform(chip, ns);
            syncReelTagsHidden();
            return;
        }
        if (!draggingTagUid) return;
        if (touches && touches.length >= 2) {
            var d2 = reelTagTouchDistance(touches);
            if (d2 >= 8) {
                reelTagPinchState = {
                    uid: draggingTagUid,
                    startDist: d2,
                    startScale: getReelTagScaleByUid(draggingTagUid)
                };
                draggingTagUid = null;
            }
            e.preventDefault();
            return;
        }
        var cx = touches && touches[0] ? touches[0].clientX : e.clientX;
        var cy = touches && touches[0] ? touches[0].clientY : e.clientY;
        var st = document.getElementById('reel_edit_stage');
        if (!st) return;
        var r = st.getBoundingClientRect();
        var nx = (cx - r.left) / r.width - reelTagDragOffset.dx;
        var ny = (cy - r.top) / r.height - reelTagDragOffset.dy;
        nx = Math.max(0.02, Math.min(0.98, nx));
        ny = Math.max(0.02, Math.min(0.98, ny));
        reelTagItems.forEach(function (t) {
            if (t._uid === draggingTagUid) {
                t.x = nx;
                t.y = ny;
            }
        });
        var chip = reelTagLayer.querySelector('[data-uid="' + draggingTagUid + '"]');
        if (chip) {
            chip.style.left = (nx * 100) + '%';
            chip.style.top = (ny * 100) + '%';
        }
        if (!touches || touches.length < 2) {
            setTrashZoneHighlight(isPointOverTrash(cx, cy));
        }
        syncReelTagsHidden();
    });
    $(document).on('mouseup touchend touchcancel', function (e) {
        var oev = e.originalEvent;
        if (reelTagPinchState && (!oev || !oev.touches || oev.touches.length < 2)) {
            reelTagPinchState = null;
        }
        var tagDragEndUid = draggingTagUid;
        var endCx = e.clientX;
        var endCy = e.clientY;
        if ((e.type === 'touchend' || e.type === 'touchcancel') && oev && oev.changedTouches && oev.changedTouches[0]) {
            endCx = oev.changedTouches[0].clientX;
            endCy = oev.changedTouches[0].clientY;
        }
        if (tagDragEndUid && !reelTagPinchState) {
            var touchesLeft = oev && oev.touches ? oev.touches.length : 0;
            if (e.type === 'mouseup' || touchesLeft === 0) {
                if (isPointOverTrash(endCx, endCy)) {
                    reelTagItems = reelTagItems.filter(function (x) { return x._uid !== tagDragEndUid; });
                    syncReelTagsHidden();
                    renderReelTagLayer();
                }
                setTrashZoneHighlight(false);
            }
        }
        if (!oev || !oev.touches || oev.touches.length === 0) {
            draggingTagUid = null;
        }
    });
    if (reelTagLayer) {
        reelTagLayer.addEventListener('wheel', function (ev) {
            if (!ev.ctrlKey && !ev.metaKey) return;
            var chip = ev.target && ev.target.closest ? ev.target.closest('.reel-editor-tag-chip') : null;
            if (!chip || !reelTagLayer.contains(chip)) return;
            ev.preventDefault();
            var uid = chip.getAttribute('data-uid');
            var t = reelTagItems.filter(function (x) { return x._uid === uid; })[0];
            if (!t) return;
            var base = typeof t.scale === 'number' ? t.scale : 1;
            var factor = ev.deltaY < 0 ? 1.06 : 0.94;
            t.scale = Math.max(0.45, Math.min(3.5, base * factor));
            setReelTagChipTransform(chip, t.scale);
            syncReelTagsHidden();
        }, { passive: false });
    }

    function hasReelTagLayers() {
        return reelTagItems.length > 0;
    }

    function updateTrashZoneVisibility() {
        var tz = document.getElementById('reel_text_trash_zone');
        if (!tz) return;
        tz.style.display = (hasReelTextLayers() || hasReelTagLayers()) ? 'flex' : 'none';
