<script>
(function () {
    var wovideo = '.plyrr-<?php echo $wo['story']['id'].$rand ;?>';
    var isReelsPage = <?php echo (isset($wo['page']) && $wo['page']== 'reels') ? 'true' : 'false'; ?>;
    var reelsSoundBtn = isReelsPage ? document.getElementById('reels-sound-toggle-<?php echo $wo['story']['id'].$rand; ?>') : null;
    var reelsIgnoreScreenToggle = false;
    var reelsForcePause = false;
    /* Pausa explícita por tap en pantalla: no mostrar overlay de "cargando" encima del negro. */
    var woReelUserChosePause = false;
    /* iOS/Safari a veces no marcan el evento "play" como isTrusted; si el usuario acaba de pulsar el botón grande de Plyr, no pausar. */
    var reelsUserClickedPlyrPlay = false;
    var reelsAudioRetryTimers = [];
    var isFirstAutoplay = true;
    var woReelPostId = <?php echo (int) $wo['story']['id']; ?>;
    function woReelsRemoteLog(level, type, msg, ctx) {
        try {
            if (typeof window.ZuitchReelsServerLog !== 'function') {
                return;
            }
            window.ZuitchReelsServerLog(level, type, msg, woReelPostId, ctx || null);
        } catch (e) {}
    }
    var players = new Plyr(wovideo, {
    	<?php if (Wo_IsMobile() == false) { ?>
    	ratio: '16:9',
    	<?php } ?>
    	fullscreen: {
    		iosNative: true
    	},
    	resetOnEnd: true,
    	<?php /* En /reels/ muchos <video> en DOM: autoplay Plyr + pause() global → AbortError; play solo si el reel está visible */ ?>
    	autoplay: <?php echo (isset($wo['page']) && $wo['page'] == 'reels') ? 'false' : 'true'; ?>,
    muted: <?php echo (isset($wo['page']) && $wo['page'] == 'reels') ? 'false' : 'true'; ?>,
		<?php if(isset($wo['page']) && $wo['page']== 'reels') { ?>
	fullscreen: false,
	<?php } ?>
    });

    if (isReelsPage && players && players.media) {
        try {
            players.media._woPlyr = players;
        } catch (e) {}
    }

    function woPlyrSafeUnmute(p) {
        try {
            if (!p) {
                return;
            }
            if (typeof p.unmute === 'function') {
                p.unmute();
            } else if (p.media) {
                p.media.muted = false;
                p.media.defaultMuted = false;
            }
        } catch (e) {}
    }

    function woReelsVideoShouldAutoplay() {
        if (!isReelsPage || !players || !players.media) {
            return true;
        }
        if (window.__woReelsAnimating) {
            return false;
        }
        var list = players.media.closest && players.media.closest('.reels_list');
        if (!list && players.elements && players.elements.container && players.elements.container.closest) {
            list = players.elements.container.closest('.reels_list');
        }
        if (!list || list.classList.contains('hidden')) {
            return false;
        }
        /* Durante la transición dos reels pueden no tener .hidden; el que sale lleva clase exit */
        if (list.classList.contains('reels-anim-next-exit') || list.classList.contains('reels-anim-prev-exit')) {
            return false;
        }
        return true;
    }

    function woSafePlayPlyr(p, postId) {
        if (!p || typeof p.play !== 'function') {
            return;
        }
        p.play().catch(function (error) {
            if (error && error.name === 'AbortError') {
                if (window.ZuitchReelsDebug && window.__ZUITCH_REELS_DEBUG_VERBOSE && woReelsVideoShouldAutoplay()) {
                    window.ZuitchReelsDebug.log('play() AbortError (reel visible; suele ser carrera play/pause)', { postId: postId });
                }
                return;
            }
            if (window.ZuitchReelsDebug) {
                window.ZuitchReelsDebug.warn('play() rechazado', { postId: postId, message: String(error && error.message || error) });
            }
            var lvl = (error && error.name === 'NotAllowedError') ? 'warn' : 'error';
            woReelsRemoteLog(lvl, 'plyr_play_rejected', String(error && error.message || error), {
                name: error && error.name ? error.name : null,
                postId: postId
            });
            isFirstAutoplay = false;
        });
    }

    /**
     * Tarjeta .reels_list visible (reels + zuitch); no depende de isReelsPage para que Zuitch reciba la misma UX de buffer.
     */
    function woReelReelCardVisible() {
        try {
            if (window.__woReelsAnimating) {
                return false;
            }
            if (!players || !players.media) {
                return false;
            }
            var list = players.media.closest && players.media.closest('.reels_list');
            if (!list && players.elements && players.elements.container && players.elements.container.closest) {
                list = players.elements.container.closest('.reels_list');
            }
            if (!list || list.classList.contains('hidden')) {
                return false;
            }
            if (list.classList.contains('reels-anim-next-exit') || list.classList.contains('reels-anim-prev-exit')) {
                return false;
            }
            return true;
        } catch (eRv) {
            return false;
        }
    }

    function woReelBufferedAheadSeconds(v) {
        try {
            if (!v || !v.buffered || v.buffered.length === 0) {
                return 0;
            }
            var t = v.currentTime;
            var b = v.buffered;
            var j;
            for (j = 0; j < b.length; j++) {
                if (b.start(j) <= t && t <= b.end(j)) {
                    return Math.max(0, b.end(j) - t);
                }
            }
            for (j = 0; j < b.length; j++) {
                if (b.start(j) > t) {
                    return Math.max(0, b.end(j) - t);
                }
            }
            return 0;
        } catch (eB) {
            return 0;
        }
    }

    function woReelInstallBufferRecovery() {
        var media = players && players.media;
        if (!media || media._woReelBufferBound) {
            return;
        }
        if (!media.closest || !media.closest('.reels_list')) {
            return;
        }
        media._woReelBufferBound = true;
        var MIN_RESUME_SEC = 2.8;
        var START_GRACE_MS = 500;
        var SPURIOUS_WAIT_MAX_AHEAD = 0.28;
        var stallRecovery = false;
        var wantedResume = false;
        var overlayEl = null;
        var syncUiTimer = null;

        function applyOverlayBackdrop() {
            if (!overlayEl || !media) {
                return;
            }
            try {
                var p = (media.getAttribute('poster') || media.getAttribute('data-poster') || media.poster || '').trim();
                if (p) {
                    overlayEl.classList.add('wo-reel-buffer-overlay--has-poster');
                    overlayEl.style.backgroundImage = 'linear-gradient(180deg, rgba(0,0,0,0.38) 0%, rgba(0,0,0,0.82) 100%), url(' + JSON.stringify(p) + ')';
                } else {
                    overlayEl.classList.remove('wo-reel-buffer-overlay--has-poster');
                    /* El fondo lo define CSS (más claro que “negro puro”); aquí no pisar con inline oscuro. */
                    overlayEl.style.backgroundImage = '';
                }
                overlayEl.style.backgroundSize = 'cover';
                overlayEl.style.backgroundPosition = 'center';
                overlayEl.style.backgroundRepeat = 'no-repeat';
            } catch (eB) {}
        }

        function ensureOverlay() {
            if (overlayEl) {
                return;
            }
            /* Hijo directo de .plyr (container): si va dentro de .plyr__video-wrapper queda por debajo de .plyr__controls (z-index 5). */
            var c = players.elements && players.elements.container;
            if (!c) {
                return;
            }
            try {
                var pos = window.getComputedStyle(c).position;
                if (pos === 'static' || pos === '') {
                    c.style.position = 'relative';
                }
            } catch (ePos) {}
            overlayEl = document.createElement('div');
            overlayEl.className = 'wo-reel-buffer-overlay';
            overlayEl.setAttribute('role', 'status');
            overlayEl.setAttribute('aria-live', 'polite');
            overlayEl.setAttribute('aria-hidden', 'true');
            overlayEl.setAttribute('aria-busy', 'false');
            overlayEl.innerHTML = ''
                + '<div class="wo-reel-buffer-overlay__inner">'
                + '<div class="wo-reel-buffer-overlay__spinner" role="presentation" aria-hidden="true"></div>'
                + '<span class="wo-reel-buffer-overlay__text">Cargando vídeo</span>'
                + '<span class="wo-reel-buffer-overlay__hint">Espera un momento…</span>'
                + '</div>';
            overlayEl.style.display = 'none';
            c.appendChild(overlayEl);
        }

        function showOverlay() {
            ensureOverlay();
            if (overlayEl) {
                applyOverlayBackdrop();
                overlayEl.style.display = 'flex';
                try {
                    overlayEl.setAttribute('aria-hidden', 'false');
                    overlayEl.setAttribute('aria-busy', 'true');
                } catch (eA) {}
                try {
                    media.classList.add('wo-reel-buffer-video-hidden');
                } catch (eV) {}
                try {
                    requestAnimationFrame(function () {
                        applyOverlayBackdrop();
                    });
                } catch (eRaf) {}
            }
        }

        function hideOverlay() {
            if (overlayEl) {
                overlayEl.style.display = 'none';
                overlayEl.style.backgroundImage = '';
                overlayEl.style.backgroundSize = '';
                overlayEl.style.backgroundPosition = '';
                overlayEl.style.backgroundRepeat = '';
                overlayEl.classList.remove('wo-reel-buffer-overlay--has-poster');
                try {
                    overlayEl.setAttribute('aria-hidden', 'true');
                    overlayEl.setAttribute('aria-busy', 'false');
                } catch (eA2) {}
            }
            try {
                media.classList.remove('wo-reel-buffer-video-hidden');
            } catch (eH) {}
        }

        function abortStallRecovery() {
            stallRecovery = false;
            wantedResume = false;
            hideOverlay();
        }

        players._woReelAbortStall = abortStallRecovery;

        /** No quitar "Cargando" hasta que haya píxeles reales: si no, queda negro tras readyState/buffer. */
        function woReelPlaybackReadyForDisplay() {
            if (!media || media.ended) {
                return false;
            }
            try {
                if (media.videoWidth < 2 || media.videoHeight < 2) {
                    return false;
                }
            } catch (eDim) {
                return false;
            }
            var ahead = woReelBufferedAheadSeconds(media);
            var rs = media.readyState;
            if (rs < 3) {
                return false;
            }
            try {
                if (isFinite(media.duration) && media.duration > 0 && media.duration < 3) {
                    return ahead >= 0.12 || rs >= 4;
                }
            } catch (eDur) {}
            return ahead >= 0.55 || rs >= 4;
        }

        function woReelTryHideLoadingOverlay() {
            if (!media || woReelUserChosePause) {
                return;
            }
            if (!woReelPlaybackReadyForDisplay()) {
                return;
            }
            if (stallRecovery && wantedResume) {
                abortStallRecovery();
                return;
            }
            hideOverlay();
        }

        function syncLoadingUi() {
            try {
                if (!media) {
                    return;
                }
                if (!woReelReelCardVisible()) {
                    if (!stallRecovery) {
                        hideOverlay();
                    }
                    return;
                }
                if (media.ended) {
                    if (!stallRecovery) {
                        hideOverlay();
                    }
                    return;
                }
                if (stallRecovery && wantedResume) {
                    showOverlay();
                    woReelTryHideLoadingOverlay();
                    return;
                }
                if (woReelUserChosePause) {
                    hideOverlay();
                    return;
                }
                woReelTryHideLoadingOverlay();
                /* Mientras no haya frame decodificable + buffer: mostrar overlay (también en pausa al inicio;
                   antes solo mirábamos readyState/buffer y quedaba pantalla negra sin “Cargando”). */
                var displayReady = woReelPlaybackReadyForDisplay();
                if (!displayReady) {
                    showOverlay();
                } else if (!stallRecovery) {
                    hideOverlay();
                }
            } catch (eSync) {}
        }

        function scheduleSyncLoadingUi() {
            if (syncUiTimer) {
                clearTimeout(syncUiTimer);
            }
            syncUiTimer = setTimeout(function () {
                syncUiTimer = null;
                syncLoadingUi();
                maybeResume();
            }, 140);
        }

        function maybeResume() {
            if (!stallRecovery || !wantedResume) {
                return;
            }
            if (!woReelReelCardVisible()) {
                return;
            }
            if (media.ended) {
                abortStallRecovery();
                return;
            }
            var ahead = woReelBufferedAheadSeconds(media);
            /* Misma condición que para quitar overlay: buffer + frame decodificable (evita negro al reanudar). */
            if (ahead >= MIN_RESUME_SEC && woReelPlaybackReadyForDisplay()) {
                woSafePlayPlyr(players, woReelPostId);
                scheduleSyncLoadingUi();
            }
        }

        function onWaiting() {
            var ts = media._woReelBufferReadyTs || 0;
            if (ts && Date.now() - ts < START_GRACE_MS) {
                scheduleSyncLoadingUi();
                return;
            }
            if (!woReelReelCardVisible()) {
                return;
            }
            if (media.ended) {
                return;
            }
            var ahead = woReelBufferedAheadSeconds(media);
            if (!media.paused && ahead >= SPURIOUS_WAIT_MAX_AHEAD) {
                scheduleSyncLoadingUi();
                return;
            }
            if (media.paused && !stallRecovery) {
                scheduleSyncLoadingUi();
                if (!woReelUserChosePause && (media.readyState < 3 || ahead < 0.32)) {
                    stallRecovery = true;
                    wantedResume = true;
                    showOverlay();
                }
                return;
            }
            if (!media.paused) {
                stallRecovery = true;
                wantedResume = true;
                showOverlay();
                try {
                    if (typeof players.pause === 'function') {
                        players.pause();
                    }
                } catch (eP1) {}
                try {
                    media.pause();
                } catch (eP2) {}
            } else if (stallRecovery) {
                showOverlay();
            }
            scheduleSyncLoadingUi();
        }

        function onStalled() {
            onWaiting();
        }

        media.addEventListener('loadstart', scheduleSyncLoadingUi);
        media.addEventListener('loadedmetadata', scheduleSyncLoadingUi);
        media.addEventListener('loadeddata', scheduleSyncLoadingUi);
        media.addEventListener('resize', scheduleSyncLoadingUi);
        media.addEventListener('waiting', onWaiting);
        media.addEventListener('stalled', onStalled);
        media.addEventListener('progress', scheduleSyncLoadingUi);
        media.addEventListener('canplay', scheduleSyncLoadingUi);
        media.addEventListener('canplaythrough', scheduleSyncLoadingUi);
        media.addEventListener('timeupdate', scheduleSyncLoadingUi);
        media.addEventListener('playing', function () {
            try {
                if (stallRecovery && wantedResume && woReelPlaybackReadyForDisplay()) {
                    abortStallRecovery();
                } else {
                    woReelTryHideLoadingOverlay();
                }
            } catch (ePl) {}
            scheduleSyncLoadingUi();
        });
        media.addEventListener('ended', abortStallRecovery);
        media.addEventListener('emptied', function () {
            abortStallRecovery();
        });

        players._woReelSyncLoadingUi = scheduleSyncLoadingUi;
    }

    players.on('ready', function woReelBufferOnPlayerReady() {
        try {
            woReelInstallBufferRecovery();
            if (players.media) {
                players.media._woReelBufferReadyTs = Date.now();
            }
        } catch (eBuf) {}
    });
    setTimeout(function woReelBufferDeferredInit() {
        try {
            woReelInstallBufferRecovery();
            if (players.media) {
                players.media._woReelBufferReadyTs = Date.now();
            }
        } catch (eDef) {}
    }, 0);

    if (isReelsPage && players.media) {
        players.media.addEventListener('error', function () {
            var err = this.error;
            var src = '';
            try {
                src = this.currentSrc || this.src || '';
            } catch (e2) {}
            if (window.ZuitchReelsDebug) {
                window.ZuitchReelsDebug.error('Fallo carga <video> (p. ej. MP4 500, CORS o archivo ausente)', {
                    postId: woReelPostId,
                    mediaErrorCode: err ? err.code : null,
                    src: src
                });
            }
            if (!this._woReelsMediaErrorLogged) {
                this._woReelsMediaErrorLogged = true;
                woReelsRemoteLog('error', 'video_media_error', 'Fallo carga elemento video', {
                    mediaErrorCode: err ? err.code : null,
                    src: src
                });
            }
        });
    }

    function setSoundButtonState(isMuted) {
        try {
            if (!reelsSoundBtn) return;
            var onPaths = reelsSoundBtn.querySelectorAll('path[data-sound="on"]');
            var offPaths = reelsSoundBtn.querySelectorAll('path[data-sound="off"]');
            onPaths.forEach(function (el) {
                el.style.display = isMuted ? 'none' : '';
            });
            offPaths.forEach(function (el) {
                el.style.display = isMuted ? '' : 'none';
            });

            var label = isMuted ? 'Activar sonido' : 'Desactivar sonido';
            reelsSoundBtn.setAttribute('title', label);
            reelsSoundBtn.setAttribute('aria-label', label);
        } catch (e) {}
    }

    function toggleSoundFromUser() {
        try {
            var media = players.media;
            var isPausedNow = !!(media && media.paused);
            var isMutedNow = !!(media && media.muted);

            if (!isMutedNow) {
                // Desactivar sonido
                if (media) {
                    media.muted = true;
                    media.defaultMuted = true;
                    media.volume = 0;
                }
                try { if (typeof players.setVolume === 'function') players.setVolume(0); } catch (e) {}
                try { if (typeof players.mute === 'function') players.mute(); } catch (e) {}
                setSoundButtonState(true);
                return;
            }

            // Activar sonido
            if (media) {
                media.muted = false;
                media.defaultMuted = false;
                media.volume = 1;
            }
            woPlyrSafeUnmute(players);
            try {
                if (typeof players.setVolume === 'function') {
                    players.setVolume(1);
                }
            } catch (e) {}

            // Si el video ya está reproduciéndose, aseguramos que Plyr re-evalúe el audio.
            // (Si está en pausa, NO llamamos play para no reproducir de nuevo.)
            try {
                if (!isPausedNow) {
                    woSafePlayPlyr(players, woReelPostId);
                }
            } catch (e) {}

            // Reintento corto: algunos WebViews tardan en aplicar el estado de volumen.
            setTimeout(function() {
                try {
                    var mediaAfter = players.media;
                    var mutedAfter = !!(mediaAfter && mediaAfter.muted);
                    setSoundButtonState(mutedAfter);
                } catch (e) {
                    setSoundButtonState(true);
                }
            }, 150);
        } catch (e) {
            setSoundButtonState(true);
        }
    }

    if (reelsSoundBtn) {
        // En reels, los controles de Plyr están ocultos; necesitamos un gesto del usuario para habilitar audio.
        var lastSoundToggleAt = 0;
        var handler = function(e) {
            try {
                var now = Date.now();
                if (now - lastSoundToggleAt < 250) return;
                lastSoundToggleAt = now;
                if (e && typeof e.cancelable === 'boolean' && e.cancelable) e.preventDefault();
                e.stopPropagation();
                if (typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();
                reelsIgnoreScreenToggle = true;
                setTimeout(function () {
                    reelsIgnoreScreenToggle = false;
                }, 250);
            } catch (err) {}
            toggleSoundFromUser();
        };
        // Usar solo `click` evita dobles toggles por mezcla touch/pointer/click.
        reelsSoundBtn.addEventListener('click', handler);
    }

    // Click en la pantalla (video/overlay): alternar pause/play.
    // Se ignoran los clicks sobre los botones de reels para no romper like/save/comentarios.
    function togglePlayPauseFromScreen() {
        try {
            if (!players || !players.media) {
                return;
            }
            var wasPlaying = !!(players.playing || (players.media && !players.media.paused));
            if (wasPlaying) {
                woReelUserChosePause = true;
                try {
                    if (typeof players._woReelAbortStall === 'function') {
                        players._woReelAbortStall();
                    }
                } catch (eAbort) {}
                reelsForcePause = true;
                if (window.woReelsHardPauseAll) {
                    window.woReelsHardPauseAll(null);
                } else {
                    if (typeof players.pause === 'function') {
                        players.pause();
                    }
                    try {
                        if (players.media && typeof players.media.pause === 'function') {
                            players.media.pause();
                        }
                    } catch (e) {}
                    try {
                        $('video').trigger('pause');
                    } catch (e2) {}
                }
            } else {
                woReelUserChosePause = false;
                reelsForcePause = false;
                if (window.woReelsHardPauseAll && players.media) {
                    window.woReelsHardPauseAll(players.media);
                }
                woSafePlayPlyr(players, woReelPostId);
                try {
                    if (typeof players._woReelSyncLoadingUi === 'function') {
                        players._woReelSyncLoadingUi();
                    }
                } catch (eSynTap) {}
            }
            try {
                var now = Date.now();
                var tk = 'taplog_' + woReelPostId;
                if (!window.__woReelsTapLogAt) {
                    window.__woReelsTapLogAt = {};
                }
                if (!window.__woReelsTapLogAt[tk] || now - window.__woReelsTapLogAt[tk] > 2800) {
                    window.__woReelsTapLogAt[tk] = now;
                    woReelsRemoteLog('info', 'reel_screen_tap_toggle', wasPlaying ? 'Usuario: pausar' : 'Usuario: reproducir', {
                        wasPlaying: wasPlaying
                    });
                }
            } catch (eTap) {}
        } catch (e) {}
    }

    if (isReelsPage) {
        var reelVideoEl = document.getElementById('video--<?php echo $wo['media']['storyId']; ?>');
        var reelRoot = reelVideoEl && reelVideoEl.closest ? reelVideoEl.closest('.reels_list, .wo_reels_cont') : null;
        var overlayEl = reelRoot ? reelRoot.querySelector('.video-text-overlay') : null;
        var postTextEl = reelRoot ? reelRoot.querySelector('.video-post-text-overlay.lb-reels-caption-overlay') : null;

        var screenClickHandler = function(e) {
            try {
                if (reelsIgnoreScreenToggle) {
                    reelsIgnoreScreenToggle = false;
                    return;
                }
                // Si el click fue dentro del botón de sonido, no hacemos toggle de play/pause.
                if (reelsSoundBtn && e && e.target && reelsSoundBtn.contains(e.target)) return;
                if (e && e.target && e.target.closest) {
                    var ignored = e.target.closest(
                        '.shorts_events, .reels-sound-toggle, .reels-download-btn, .reel-save-btn, .reels_like_btn, .reels-rail-react-wrap, .reel-view-tag-chip, .plyr__control--overlaid, .plyr__controls button, a[href]'
                    );
                    if (ignored) {
                        return;
                    }
                }
            } catch (err) {}
            togglePlayPauseFromScreen();
        };

        /* Plyr envuelve el <video> y suele poner poster/capas encima: el click no llegaba al video. Captura en el contenedor .plyr. */
        players.on('ready', function woReelsBindScreenTap() {
            var c = players.elements && players.elements.container;
            if (!c || c._woReelsScreenTapBound) {
                return;
            }
            c._woReelsScreenTapBound = true;
            c.addEventListener('click', screenClickHandler, true);
        });

        if (overlayEl) {
            overlayEl.addEventListener('click', screenClickHandler);
        }
        if (postTextEl && postTextEl.classList && postTextEl.classList.contains('video-post-text-overlay')) {
            postTextEl.addEventListener('click', screenClickHandler);
        }
    }
    
    // Asegurar autoplay cuando el video está listo (mismo evento ready que el bind de tap en reels)
    players.on('ready', (event) => {
        setSoundButtonState(!!(players.media && players.media.muted));
        if (isReelsPage && !woReelsVideoShouldAutoplay()) {
            try {
                if (typeof players.pause === 'function') {
                    players.pause();
                }
            } catch (e) {}
            return;
        }
        woSafePlayPlyr(players, woReelPostId);
        try {
            if (typeof players._woReelSyncLoadingUi === 'function') {
                players._woReelSyncLoadingUi();
            }
        } catch (eSy) {}
    });

    // Desbloqueo de audio en /reels/: una sola vez por página (reels/content.phtml) usando video._woPlyr.

    function forceReelsAudioOn() {
        try {
            if (!players || !players.media) return;
            players.media.muted = false;
            players.media.defaultMuted = false;
            players.media.volume = 1;
            try { players.media.removeAttribute && players.media.removeAttribute('muted'); } catch (e) {}
            woPlyrSafeUnmute(players);
            if (typeof players.setVolume === 'function') players.setVolume(1);
            setSoundButtonState(false);
        } catch (e) {}
    }

    // Detectar clic en el botón de play para desmutear automáticamente
    players.on('play', (event) => {
        try {
            woReelUserChosePause = false;
        } catch (eUp) {}
        if (isReelsPage) {
            var playFromUserGesture = false;
            try {
                playFromUserGesture = !!(event && event.isTrusted === true);
            } catch (eTr) {}
            if (!playFromUserGesture && reelsUserClickedPlyrPlay) {
                playFromUserGesture = true;
            }
            var listForPlay = null;
            try {
                listForPlay = players.media.closest && players.media.closest('.reels_list');
                if (!listForPlay && players.elements && players.elements.container) {
                    listForPlay = players.elements.container.closest('.reels_list');
                }
            } catch (eL) {}
            if (listForPlay && listForPlay.classList.contains('hidden')) {
                try {
                    if (typeof players.pause === 'function') {
                        players.pause();
                    }
                } catch (e) {}
                try {
                    if (players.media && typeof players.media.pause === 'function') {
                        players.media.pause();
                    }
                } catch (e2) {}
                return;
            }
            /* No cortar play() si el usuario pulsó play (overlaid o pantalla); solo bloquear autoplay en reels ocultos. */
            if (!woReelsVideoShouldAutoplay() && !playFromUserGesture) {
                try {
                    if (typeof players.pause === 'function') {
                        players.pause();
                    }
                } catch (e) {}
                try {
                    if (players.media && typeof players.media.pause === 'function') {
                        players.media.pause();
                    }
                } catch (e2) {}
                return;
            }
            try {
                if (window.woReelsHardPauseAll && players.media) {
                    window.woReelsHardPauseAll(players.media);
                }
            } catch (eH) {}
            try {
                reelsAudioRetryTimers.forEach(function(t){ clearTimeout(t); });
                reelsAudioRetryTimers = [];
                forceReelsAudioOn();
                reelsAudioRetryTimers.push(setTimeout(forceReelsAudioOn, 50));
                reelsAudioRetryTimers.push(setTimeout(forceReelsAudioOn, 150));
                reelsAudioRetryTimers.push(setTimeout(forceReelsAudioOn, 300));
            } catch (e) {}
        } else {
            // Si no es reels, mantener comportamiento anterior.
            if (!isFirstAutoplay || players.media.muted) {
                woPlyrSafeUnmute(players);
            }
        }
        isFirstAutoplay = false;
        
        Wo_AddVideoViews(<?php echo $wo['story']['id'];?>);
        <?php if(isset($wo['page']) && $wo['page'] == 'watch') { ?>
        players.pause();
        $('.plyrr-<?php echo $wo['story']['id'].$rand ;?>').removeClass('plyrr-<?php echo $wo['story']['id'];?> video-container');
        Wo_OpenLightBox(<?php echo $wo['story']['id'];?>)
        <?php } ?>
        <?php if (!(isset($wo['page']) && $wo['page'] == 'reels')) { ?>
      $('video').not('.plyrr-<?php echo $wo['story']['id'].$rand ;?>').trigger('pause');
        <?php } ?>
    });
    
    // También detectar clic directo en el botón de play de Plyr
    players.on('ready', function() {
        var playButton = players.elements.buttons.play;
        if (playButton) {
            playButton.forEach(function(button) {
                button.addEventListener('click', function() {
                    reelsUserClickedPlyrPlay = true;
                    setTimeout(function () {
                        reelsUserClickedPlyrPlay = false;
                    }, 900);
                    // Desmutear cuando el usuario hace clic en play
                    setTimeout(function() {
                        if (players.playing) {
                            woPlyrSafeUnmute(players);
                        }
                    }, 100);
                }, true);
            });
        }
    });

    players.on('pause', (event) => {
        try {
            if (!isReelsPage) {
                return;
            }
            reelsAudioRetryTimers.forEach(function(t){ clearTimeout(t); });
            reelsAudioRetryTimers = [];
            reelsForcePause = false;
            /* Importante: si pausamos un reel OCULTO (p. ej. al dar play en otro), NO llamar
               woReelsHardPauseAll aquí: con "except" sería ese mismo oculto y se pausaría TODO el feed,
               incluido el vídeo que estás viendo (unos segundos y corta, varios clics para recuperar). */
            if (woReelsVideoShouldAutoplay() && window.woReelsHardPauseAll && players.media) {
                window.woReelsHardPauseAll(players.media);
            }
        } catch (e) {}
    });
})();
</script>