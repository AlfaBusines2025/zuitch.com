<?php
/**
 * Optional contact CTAs for posts/reels.
 * Modes via $wo['cta_render_mode']:
 *   - 'stat' (default): inline <a class="stat-item post-cta-stat"> for #wo_post_stat_button
 *   - 'overlay': Instagram-style pills over reel video
 *   - 'block': legacy wrapped buttons (unused in feed)
 * Only valid formats are shown (no checkboxes required).
 */
$cta_mode = !empty($wo['cta_render_mode']) ? $wo['cta_render_mode'] : 'stat';
$cta_items = array();

$post_wa = '';
$post_em = '';
$post_ph = '';
if (!empty($wo['story']['post_whatsapp'])) {
	$wa = preg_replace('/\D+/', '', $wo['story']['post_whatsapp']);
	if (strlen($wa) >= 8 && strlen($wa) <= 15) {
		$post_wa = $wa;
	}
}
if (!empty($wo['story']['post_email']) && filter_var($wo['story']['post_email'], FILTER_VALIDATE_EMAIL)) {
	$post_em = $wo['story']['post_email'];
}
if (!empty($wo['story']['post_phone'])) {
	$tel = preg_replace('/[^\d+]/', '', $wo['story']['post_phone']);
	$tel_digits = preg_replace('/\D+/', '', $tel);
	if (strlen($tel_digits) >= 7 && strlen($tel_digits) <= 15) {
		$post_ph = $tel;
	}
}

$use_post_cta = ($post_wa !== '' || $post_em !== '' || $post_ph !== '');

if ($use_post_cta) {
	if ($post_wa !== '') {
		$cta_items[] = array(
			'href' => 'https://wa.me/' . $post_wa,
			'label' => 'WhatsApp',
			'class' => 'page-cta-whatsapp'
		);
	}
	if ($post_em !== '') {
		$cta_items[] = array(
			'href' => 'mailto:' . $post_em,
			'label' => 'Email',
			'class' => 'page-cta-email'
		);
	}
	if ($post_ph !== '') {
		$cta_items[] = array(
			'href' => 'tel:' . $post_ph,
			'label' => 'Llamar',
			'class' => 'page-cta-call'
		);
	}
} elseif (!empty($wo['story']['page_id']) && (int) $wo['story']['page_id'] > 0) {
	$page = array();
	if (!empty($wo['story']['publisher']) && !empty($wo['story']['publisher']['page_id'])) {
		$page = $wo['story']['publisher'];
	} else {
		$page = Wo_PageData($wo['story']['page_id']);
	}
	if (!empty($page) && !empty($page['page_id'])) {
		if (!empty($page['show_cta_whatsapp']) && !empty($page['whatsapp'])) {
			$wa = preg_replace('/\D+/', '', $page['whatsapp']);
			if (strlen($wa) >= 8 && strlen($wa) <= 15) {
				$cta_items[] = array(
					'href' => 'https://wa.me/' . $wa,
					'label' => 'WhatsApp',
					'class' => 'page-cta-whatsapp'
				);
			}
		}
		if (!empty($page['show_cta_email']) && !empty($page['page_email']) && filter_var($page['page_email'], FILTER_VALIDATE_EMAIL)) {
			$cta_items[] = array(
				'href' => 'mailto:' . $page['page_email'],
				'label' => 'Email',
				'class' => 'page-cta-email'
			);
		}
		if (!empty($page['show_cta_call']) && !empty($page['phone'])) {
			$tel = preg_replace('/[^\d+]/', '', $page['phone']);
			$tel_digits = preg_replace('/\D+/', '', $tel);
			if (strlen($tel_digits) >= 7 && strlen($tel_digits) <= 15) {
				$cta_items[] = array(
					'href' => 'tel:' . $tel,
					'label' => 'Llamar',
					'class' => 'page-cta-call'
				);
			}
		}
	}
}

if (empty($cta_items)) {
	return;
}

$cta_icons = array(
	'page-cta-whatsapp' => '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 20.15C10.59 20.15 9.17 19.76 7.89 19L7.57 18.82L4.43 19.65L5.28 16.61L5.08 16.27C4.25 14.94 3.81 13.42 3.81 11.91C3.81 7.37 7.5 3.68 12.05 3.68C14.25 3.68 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.71 20.28 11.92C20.28 16.46 16.58 20.15 12.05 20.15M16.56 14.4C16.31 14.28 15.09 13.68 14.87 13.6C14.64 13.52 14.5 13.48 14.31 13.73C14.15 13.98 13.67 14.56 13.53 14.71C13.39 14.87 13.24 14.89 13 14.76C12.75 14.63 11.96 14.38 11.03 13.55C10.31 12.91 9.83 12.12 9.68 11.87C9.54 11.62 9.67 11.49 9.8 11.35C9.91 11.24 10.05 11.05 10.17 10.91C10.3 10.77 10.34 10.67 10.42 10.51C10.5 10.35 10.46 10.21 10.4 10.09C10.34 9.96 9.86 8.78 9.66 8.28C9.46 7.8 9.26 7.87 9.11 7.86C8.97 7.85 8.82 7.85 8.68 7.85C8.53 7.85 8.3 7.94 8.1 8.19C7.9 8.44 7.33 8.98 7.33 10.07C7.33 11.16 8.12 12.21 8.24 12.37C8.37 12.53 9.81 14.76 12.01 15.7C12.55 15.94 12.96 16.07 13.28 16.17C13.8 16.33 14.28 16.31 14.66 16.25C15.08 16.19 16.07 15.66 16.28 15.08C16.48 14.5 16.48 14.01 16.41 13.9C16.35 13.79 16.2 13.74 15.95 13.61"/></svg>',
	'page-cta-email' => '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M20,8L12,13L4,8V6L12,11L20,6M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z"/></svg>',
	'page-cta-call' => '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M6.62,10.79C8.06,13.62 10.38,15.94 13.21,17.38L15.41,15.18C15.69,14.9 16.08,14.82 16.43,14.93C17.55,15.3 18.75,15.5 20,15.5A1,1 0 0,1 21,16.5V20A1,1 0 0,1 20,21A17,17 0 0,1 3,4A1,1 0 0,1 4,3H7.5A1,1 0 0,1 8.5,4C8.5,5.25 8.7,6.45 9.07,7.57C9.18,7.92 9.1,8.31 8.82,8.59L6.62,10.79Z"/></svg>'
);

if ($cta_mode === 'overlay') {
?>
<div class="reel-cta-overlay">
	<?php foreach ($cta_items as $cta) { ?>
		<a class="reel-cta-pill <?php echo $cta['class']; ?>" href="<?php echo htmlspecialchars($cta['href'], ENT_QUOTES, 'UTF-8'); ?>" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation();">
			<?php echo isset($cta_icons[$cta['class']]) ? $cta_icons[$cta['class']] : ''; ?>
			<span><?php echo htmlspecialchars($cta['label'], ENT_QUOTES, 'UTF-8'); ?></span>
		</a>
	<?php } ?>
</div>
<?php
	return;
}

if ($cta_mode === 'block') {
?>
<div class="page-post-ctas" style="padding:8px 15px 0;display:flex;flex-wrap:wrap;gap:8px;">
	<?php foreach ($cta_items as $cta) { ?>
		<a class="btn btn-default btn-sm <?php echo $cta['class']; ?>" href="<?php echo htmlspecialchars($cta['href'], ENT_QUOTES, 'UTF-8'); ?>" target="_blank" rel="noopener noreferrer"><?php echo htmlspecialchars($cta['label'], ENT_QUOTES, 'UTF-8'); ?></a>
	<?php } ?>
</div>
<?php
	return;
}

// Default: full-width CTA row below Like / Comment / Share
$cta_count = count($cta_items);
?>
<div class="post-cta-row" data-cta-count="<?php echo (int) $cta_count; ?>">
<?php foreach ($cta_items as $cta) { ?>
	<a class="btn btn-default post-cta-stat <?php echo $cta['class']; ?>" href="<?php echo htmlspecialchars($cta['href'], ENT_QUOTES, 'UTF-8'); ?>" target="_blank" rel="noopener noreferrer" title="<?php echo htmlspecialchars($cta['label'], ENT_QUOTES, 'UTF-8'); ?>" onclick="event.stopPropagation();">
		<?php echo isset($cta_icons[$cta['class']]) ? $cta_icons[$cta['class']] : ''; ?>
		<span><?php echo htmlspecialchars($cta['label'], ENT_QUOTES, 'UTF-8'); ?></span>
	</a>
<?php } ?>
</div>
