<?php
/**
 * Official DaaS FAB v2 (Inicio · Pedidos · Salud) — superadmin only, site-wide.
 * Script always comes from the hub. Session is HMAC-signed on the server;
 * DAAS_PROJECT_SECRET never reaches the browser.
 */
if (empty($wo['loggedin']) || !function_exists('Wo_IsAdmin') || !Wo_IsAdmin()) {
    return;
}
if (in_array($wo['page'], array('welcome', 'register', 'logout', 'maintenance'), true)) {
    return;
}

// themes/wowonder/layout/extra → httpdocs
$httpdocs = dirname(dirname(dirname(dirname(__DIR__))));
require_once $httpdocs . '/assets/includes/daas_env.php';
daas_env_load();

$daasUrl = rtrim((string) daas_env('DAAS_URL', 'https://daas.alfabusiness.app'), '/');
$daasPk = (string) daas_env('DAAS_PUBLIC_KEY', '');
$daasSecret = (string) daas_env('DAAS_PROJECT_SECRET', '');
$daasCompany = (string) daas_env('DAAS_BILLING_EXTERNAL_ID', '');
$daasEmail = !empty($wo['user']['email']) ? (string) $wo['user']['email'] : '';
$daasRequester = !empty($wo['user']['user_id']) ? ('user:' . $wo['user']['user_id']) : '';

if ($daasPk === '' || $daasSecret === '' || $daasRequester === '' || $daasCompany === '') {
    return;
}

$daasExp = time() + 12 * 3600;
$daasSig = hash_hmac('sha256', $daasRequester . '|' . $daasCompany . '|' . $daasExp, $daasSecret);
$widgetSrc = $daasUrl . '/widget-v2.js?pk=' . rawurlencode($daasPk);
?>
<div id="daas-widget-root" data-daas-widget
     data-public-key="<?php echo htmlspecialchars($daasPk, ENT_QUOTES, 'UTF-8'); ?>"
     data-company-external-id="<?php echo htmlspecialchars($daasCompany, ENT_QUOTES, 'UTF-8'); ?>"
     data-user-email="<?php echo htmlspecialchars($daasEmail, ENT_QUOTES, 'UTF-8'); ?>"
     data-requester-external-id="<?php echo htmlspecialchars($daasRequester, ENT_QUOTES, 'UTF-8'); ?>"
     data-requester-exp="<?php echo (int) $daasExp; ?>"
     data-requester-sig="<?php echo htmlspecialchars($daasSig, ENT_QUOTES, 'UTF-8'); ?>"></div>
<script src="<?php echo htmlspecialchars($widgetSrc, ENT_QUOTES, 'UTF-8'); ?>" defer></script>
