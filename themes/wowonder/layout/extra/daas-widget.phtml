<?php
/**
 * Official DaaS FAB (rw-suggest-fab / Alfa logo) — superadmin only, site-wide.
 */
if (empty($wo['loggedin']) || !function_exists('Wo_IsAdmin') || !Wo_IsAdmin()) {
    return;
}
if (in_array($wo['page'], array('welcome', 'register', 'logout', 'maintenance'), true)) {
    return;
}

// themes/wowonder/layout/extra → httpdocs
$httpdocs = dirname(dirname(dirname(dirname(__DIR__))));
require_once $httpdocs . '/assets/includes/daas_env.php';
daas_env_load();

$publicKey = daas_env('DAAS_PUBLIC_KEY', '');
if ($publicKey === '') {
    return;
}

$daasUrl = rtrim(daas_env('DAAS_URL', 'https://daas.alfabusiness.app'), '/');
$companyId = daas_env('DAAS_BILLING_EXTERNAL_ID', 'zuitch');
$requesterEmail = !empty($wo['user']['email']) ? $wo['user']['email'] : '';
$requesterId = !empty($wo['user']['user_id']) ? ('user:' . $wo['user']['user_id']) : '';
$logoUrl = $daasUrl . '/landing/assets/brand/alfa-mark-white.png';
$storeUrl = $daasUrl . '/api/v1/orders';
$localWidget = $wo['config']['site_url'] . '/assets/js/daas-widget.js';
$remoteWidget = $daasUrl . '/widget.js';
?>
<div id="daas-widget-root"
     data-daas-widget
     data-public-key="<?php echo htmlspecialchars($publicKey, ENT_QUOTES, 'UTF-8'); ?>"
     data-company-external-id="<?php echo htmlspecialchars($companyId, ENT_QUOTES, 'UTF-8'); ?>"
     data-user-email="<?php echo htmlspecialchars($requesterEmail, ENT_QUOTES, 'UTF-8'); ?>"
     data-requester-email="<?php echo htmlspecialchars($requesterEmail, ENT_QUOTES, 'UTF-8'); ?>"
     data-requester-external-id="<?php echo htmlspecialchars($requesterId, ENT_QUOTES, 'UTF-8'); ?>"
     data-logo-url="<?php echo htmlspecialchars($logoUrl, ENT_QUOTES, 'UTF-8'); ?>"
     data-store-url="<?php echo htmlspecialchars($storeUrl, ENT_QUOTES, 'UTF-8'); ?>"></div>
<script>
(function () {
  if (window.__zuitchDaasWidgetLoading) return;
  window.__zuitchDaasWidgetLoading = true;
  var remote = <?php echo json_encode($remoteWidget); ?>;
  var local = <?php echo json_encode($localWidget); ?>;
  function load(src, fallback) {
    var s = document.createElement('script');
    s.src = src;
    s.async = true;
    s.setAttribute('data-zuitch-daas-widget', '1');
    s.onerror = function () {
      if (fallback) load(fallback, null);
    };
    document.body.appendChild(s);
  }
  if (!document.querySelector('script[data-zuitch-daas-widget]')) {
    load(remote, local);
  }
})();
</script>
