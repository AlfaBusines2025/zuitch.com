<?php
if (empty($wo['loggedin'])) {
    return;
}
if (empty($wo['config']['zuitch_ai']) || (string) $wo['config']['zuitch_ai'] !== '1') {
    return;
}
if (in_array($wo['page'], array('welcome', 'register', 'logout', 'maintenance'), true)) {
    return;
}
$httpdocs = dirname(dirname(dirname(dirname(__DIR__))));
require_once $httpdocs . '/assets/includes/zuitch_ai.php';
$zaiIsAdmin = zuitch_ai_is_superadmin() ? 1 : 0;
$zaiImages = (!empty($wo['config']['zuitch_ai_images']) && (string) $wo['config']['zuitch_ai_images'] === '1') ? 1 : 0;
$zaiFiles = (!empty($wo['config']['zuitch_ai_files']) && (string) $wo['config']['zuitch_ai_files'] === '1') ? 1 : 0;
$zaiVoice = (!empty($wo['config']['zuitch_ai_voice']) && (string) $wo['config']['zuitch_ai_voice'] === '1') ? 1 : 0;
$zaiTts = (!isset($wo['config']['zuitch_ai_tts']) || (string) $wo['config']['zuitch_ai_tts'] === '1') ? 1 : 0;
$zaiHash = function_exists('Wo_CreateSession') ? Wo_CreateSession() : '';
$zaiIcon = !empty($wo['config']['theme_url'])
    ? rtrim($wo['config']['theme_url'], '/') . '/img/icon.png'
    : '/themes/wowonder/img/icon.png';
$zaiFabBottom = $zaiIsAdmin ? 90 : 22;
$zaiPanelBottom = $zaiIsAdmin ? 156 : 88;
$fileAccept = !empty($wo['config']['zuitch_ai_file_ext'])
    ? '.' . implode(',.', array_map('trim', explode(',', strtolower($wo['config']['zuitch_ai_file_ext']))))
    : '.txt,.csv,.md,.pdf';
