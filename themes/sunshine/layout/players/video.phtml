<script>

var wovideo = '.plyrr-<?php echo $wo['story']['id'].$rand ;?>';
var isReelsPage = <?php echo (isset($wo['page']) && $wo['page']== 'reels') ? 'true' : 'false'; ?>;
var reelsSoundBtn = isReelsPage ? document.getElementById('reels-sound-toggle-<?php echo $wo['story']['id'].$rand; ?>') : null;
var players = new Plyr(wovideo, {
	<?php if (Wo_IsMobile() == false) { ?>
	ratio: '16:9',
	<?php } ?>
	fullscreen: {
		iosNative: true
	},
	resetOnEnd: true,
	autoplay: true,
	muted: <?php echo (isset($wo['page']) && $wo['page'] == 'reels') ? 'false' : 'true'; ?>,
	<?php if(isset($wo['page']) && $wo['page']== 'reels') { ?>
	fullscreen: false,
	<?php } ?>
});

// Variable para rastrear si es la primera reproducción automática
var isFirstAutoplay = true;

function setSoundButtonState(isMuted) {
	try {
		if (!reelsSoundBtn) return;
		var onPaths = reelsSoundBtn.querySelectorAll('path[data-sound="on"]');
		var offPaths = reelsSoundBtn.querySelectorAll('path[data-sound="off"]');
		onPaths.forEach(function (el) {
			el.style.display = isMuted ? 'none' : '';
		});
		offPaths.forEach(function (el) {
			el.style.display = isMuted ? '' : 'none';
		});

		var label = isMuted ? 'Activar sonido' : 'Desactivar sonido';
		reelsSoundBtn.setAttribute('title', label);
		reelsSoundBtn.setAttribute('aria-label', label);
	} catch (e) {}
}

	function toggleSoundFromUser() {
	try {
		var media = players.media;
			var isPausedNow = !!(media && media.paused);
		var isMutedNow = !!(media && media.muted);

		if (!isMutedNow) {
			// Desactivar sonido
			if (media) {
				media.muted = true;
				media.defaultMuted = true;
				media.volume = 0;
			}
			try { if (typeof players.setVolume === 'function') players.setVolume(0); } catch (e) {}
			try { if (typeof players.mute === 'function') players.mute(); } catch (e) {}
			setSoundButtonState(true);
			return;
		}

		// Activar sonido
		if (media) {
			media.muted = false;
			media.defaultMuted = false;
			media.volume = 1;
		}
		try { players.unmute && players.unmute(); } catch (e) {}
		try {
			if (typeof players.setVolume === 'function') {
				players.setVolume(1);
			}
		} catch (e) {}

		// Si el video ya está reproduciéndose, aseguramos que Plyr re-evalúe el audio.
		// (Si está en pausa, NO llamamos play para no reproducir de nuevo.)
		try {
			if (!isPausedNow && typeof players.play === 'function') {
				players.play().catch(function () {});
			}
		} catch (e) {}

		setTimeout(function() {
			try {
				var mediaAfter = players.media;
				var mutedAfter = !!(mediaAfter && mediaAfter.muted);
				setSoundButtonState(mutedAfter);
			} catch (e) {
				setSoundButtonState(true);
			}
		}, 150);
	} catch (e) {
		setSoundButtonState(true);
	}
}

if (reelsSoundBtn) {
	// En reels, los controles de Plyr están ocultos; necesitamos un gesto del usuario para habilitar audio.
	var reelsIgnoreScreenToggle = false;
	var lastSoundToggleAt = 0;
	var handler = function(e) {
		try {
			var now = Date.now();
			if (now - lastSoundToggleAt < 250) return;
			lastSoundToggleAt = now;
			if (e && typeof e.cancelable === 'boolean' && e.cancelable) e.preventDefault();
			e.stopPropagation();
			if (typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();
			reelsIgnoreScreenToggle = true;
			setTimeout(function () {
				reelsIgnoreScreenToggle = false;
			}, 250);
		} catch (err) {}
		toggleSoundFromUser();
	};
	// Usar solo `click` evita dobles toggles por mezcla touch/pointer/click.
	reelsSoundBtn.addEventListener('click', handler);
}

    // Click en la pantalla (video/overlay): alternar pause/play.
    // Se ignoran los clicks sobre los botones de reels para no romper like/save/comentarios.
	var reelsForcePause = false;
	var reelsAudioRetryTimers = [];
    function togglePlayPauseFromScreen() {
        try {
            if (!players || !players.media) return;
            var wasPlaying = !!(players.playing || (players.media && !players.media.paused));
            setTimeout(function() {
                try {
                    if (wasPlaying) {
                        reelsForcePause = true;
                        if (typeof players.pause === 'function') players.pause();
                        // Asegurar que el audio se detenga al pausar.
                        try { if (players.media && typeof players.media.pause === 'function') players.media.pause(); } catch (e) {}
                        // Pausar cualquier otro video que pueda estar reproduciendo audio en segundo plano.
                        try { $('video').trigger('pause'); } catch (e) {}
                    } else {
                        reelsForcePause = false;
                        if (typeof players.play === 'function') players.play().catch(function () {});
                    }
                } catch (e) {}
            }, 0);
        } catch (e) {}
    }

    if (isReelsPage) {
        var reelVideoEl = document.getElementById('video--<?php echo $wo['media']['storyId']; ?>');
        var overlayEl = reelVideoEl ? reelVideoEl.nextElementSibling : null; // .video-text-overlay
        var postTextEl = overlayEl ? overlayEl.nextElementSibling : null; // .video-post-text-overlay

        var screenClickHandler = function(e) {
            try {
				if (reelsIgnoreScreenToggle) {
					reelsIgnoreScreenToggle = false;
					return;
				}
                // Si el click fue dentro del botón de sonido, no hacemos toggle de play/pause.
                if (reelsSoundBtn && e && e.target && reelsSoundBtn.contains(e.target)) return;
                if (e && e.target && e.target.closest) {
                    // No togglear play/pause si el usuario hizo click en los controles.
                    var ignored = e.target.closest('.shorts_events, .reels-sound-toggle, .reels-download-btn, .reel-save-btn, .reels_like_btn');
                    if (ignored) return;
                }
            } catch (err) {}
            togglePlayPauseFromScreen();
        };

        if (reelVideoEl) reelVideoEl.addEventListener('click', screenClickHandler);
        if (overlayEl) overlayEl.addEventListener('click', screenClickHandler);
        if (postTextEl && postTextEl.classList && postTextEl.classList.contains('video-post-text-overlay')) {
            postTextEl.addEventListener('click', screenClickHandler);
        }
    }

// Asegurar autoplay cuando el video está listo
players.on('ready', (event) => {
    setSoundButtonState(!!(players.media && players.media.muted));
    players.play().catch(function(error) {
        // Si el autoplay falla, intentar reproducir con interacción del usuario
        console.log('Autoplay falló:', error);
        isFirstAutoplay = false;
    });
});

// En la mayoría de navegadores, autoplay con sonido se bloquea hasta
// la primera interacción del usuario. Al primer gesto, activamos audio.
if (isReelsPage) {
	var unlockReelsAudio = function() {
		try {
			var media = players.media;
			if (media) {
				media.muted = false;
				media.defaultMuted = false;
				media.volume = 1;
			}
			if (typeof players.unmute === 'function') players.unmute();
			if (typeof players.setVolume === 'function') players.setVolume(1);
			if (typeof players.play === 'function') players.play().catch(function () {});
			setSoundButtonState(false);
		} catch (e) {}
	};

	document.addEventListener('click', unlockReelsAudio, {once: true, capture: true});
	document.addEventListener('touchstart', unlockReelsAudio, {once: true, capture: true, passive: true});
	document.addEventListener('pointerdown', unlockReelsAudio, {once: true, capture: true, passive: true});
}

function forceReelsAudioOn() {
	try {
		if (!players || !players.media) return;
		players.media.muted = false;
		players.media.defaultMuted = false;
		players.media.volume = 1;
		try { players.media.removeAttribute && players.media.removeAttribute('muted'); } catch (e) {}
		if (typeof players.unmute === 'function') players.unmute();
		if (typeof players.setVolume === 'function') players.setVolume(1);
		setSoundButtonState(false);
	} catch (e) {}
}

players.on('play', (event) => {
	// Si el usuario da play en reels, forzar audio activo.
	if (isReelsPage) {
		try {
			reelsAudioRetryTimers.forEach(function(t){ clearTimeout(t); });
			reelsAudioRetryTimers = [];
			forceReelsAudioOn();
			// Reintentos: algunos scripts re-aplican mute después del play.
			reelsAudioRetryTimers.push(setTimeout(forceReelsAudioOn, 50));
			reelsAudioRetryTimers.push(setTimeout(forceReelsAudioOn, 150));
			reelsAudioRetryTimers.push(setTimeout(forceReelsAudioOn, 300));
		} catch (e) {}
	} else {
		// Si no es reels, mantener comportamiento anterior.
		if (!isFirstAutoplay || players.media.muted) {
			players.unmute();
		}
	}
	isFirstAutoplay = false;
	
	Wo_AddVideoViews(<?php echo $wo['story']['id'];?>);
   <?php if(isset($wo['page']) && $wo['page'] == 'watch') { ?>
    players.pause();
    $('.plyrr-<?php echo $wo['story']['id'].$rand ;?>').removeClass('plyrr-<?php echo $wo['story']['id'];?> video-container');
    Wo_OpenLightBox(<?php echo $wo['story']['id'];?>)
    <?php } ?>
    //$('.video-text-overlay').fadeOut();
  $('video').not('.plyrr-<?php echo $wo['story']['id'].$rand ;?>').trigger('pause');
});

// También detectar clic directo en el botón de play de Plyr
players.on('ready', function() {
	var playButton = players.elements.buttons.play;
	if (playButton) {
		playButton.forEach(function(button) {
			button.addEventListener('click', function() {
				// Desmutear cuando el usuario hace clic en play
				setTimeout(function() {
					if (players.playing) {
						players.unmute();
					}
				}, 100);
			});
		});
	}
});

players.on('pause', (event) => {
    // En reels, cualquier pause debe cortar audio inmediatamente.
    try {
        if (!isReelsPage) return;
        reelsAudioRetryTimers.forEach(function(t){ clearTimeout(t); });
        reelsAudioRetryTimers = [];

        if (players.media && typeof players.media.pause === 'function') players.media.pause();
        $('video').not('.plyrr-<?php echo $wo['story']['id'].$rand ;?>').trigger('pause');
        reelsForcePause = false;
    } catch (e) {}
});
</script>